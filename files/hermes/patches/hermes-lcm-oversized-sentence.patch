 _CHUNK_TARGET_TOKENS = 600
+# Keep a provider-neutral byte/token safety margin when the optional tokenizer
+# is unavailable or differs materially from the active embedding model.
+_CHUNK_MAX_ATOMIC_CHARS = 4_096
 # ``conversational`` skips pure-acknowledgment turns; keep it simple and skip
