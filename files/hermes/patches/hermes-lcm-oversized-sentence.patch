+def _bounded_sentence_spans(
+    text: str, start: int, end: int
+) -> list[tuple[int, int]]:
+    """Split one oversized sentence without dropping or reordering content."""
+    if end <= start:
+        return []
+    if (
+        end - start <= _CHUNK_MAX_ATOMIC_CHARS
+        and count_tokens(text[start:end]) <= _CHUNK_TARGET_TOKENS
+    ):
+        return [(start, end)]
+
+    spans: list[tuple[int, int]] = []
+    cursor = start
+    while cursor < end:
+        high = min(end, cursor + _CHUNK_MAX_ATOMIC_CHARS)
+        low = cursor + 1
+        best = cursor
+        while low <= high:
+            middle = (low + high) // 2
+            if count_tokens(text[cursor:middle]) <= _CHUNK_TARGET_TOKENS:
+                best = middle
+                low = middle + 1
+            else:
+                high = middle - 1
+        if best == cursor:
+            best = cursor + 1
+        spans.append((cursor, best))
+        cursor = best
+    return spans
+
