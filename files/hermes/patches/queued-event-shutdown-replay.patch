+from __future__ import annotations
+
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+
+ROOT = Path(__file__).resolve().parents[2]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from agent.todo_stop import (
+    build_todo_stop_nudge,
+    max_todo_stop_nudges,
+    todo_stop_guard_enabled,
+)
+from tools.todo_tool import TodoStore
+
+
+def _config(enabled=True, maximum=4):
+    return {
+        "agent": {
+            "todo_stop_guard": enabled,
+            "max_todo_stop_nudges": maximum,
+        }
+    }
+
+
+class TodoStopTests(unittest.TestCase):
+    @patch.dict(os.environ, {}, clear=True)
+    def test_guard_is_opt_in(self):
+        self.assertFalse(todo_stop_guard_enabled({"agent": {}}))
+        self.assertTrue(todo_stop_guard_enabled(_config()))
+
+    @patch.dict(os.environ, {}, clear=True)
+    def test_no_active_todos_never_nudges(self):
+        store = TodoStore()
+        self.assertIsNone(build_todo_stop_nudge(store=store, config=_config()))
+        store.write([
+            {"id": "one", "content": "done", "status": "completed"},
+            {"id": "two", "content": "not needed", "status": "cancelled"},
+        ])
+        self.assertIsNone(build_todo_stop_nudge(store=store, config=_config()))
+
+    @patch.dict(os.environ, {}, clear=True)
+    def test_active_todos_nudge_until_bounded_budget(self):
+        store = TodoStore()
+        store.write([
+            {"id": "raw", "content": "Save raw syllabus", "status": "completed"},
+            {"id": "context", "content": "Save context", "status": "in_progress"},
+            {"id": "state", "content": "Write scheduler state", "status": "pending"},
+        ])
+        nudge = build_todo_stop_nudge(store=store, config=_config(maximum=2))
+        self.assertIsNotNone(nudge)
+        self.assertIn("context", nudge)
+        self.assertIn("state", nudge)
+        self.assertNotIn("raw", nudge)
+        self.assertIsNone(build_todo_stop_nudge(
+            store=store, attempts=2, config=_config(maximum=2)
+        ))
+
+    def test_env_can_force_guard(self):
+        with patch.dict(os.environ, {"HERMES_TODO_STOP_GUARD": "1"}, clear=True):
+            self.assertTrue(todo_stop_guard_enabled(
+                {"agent": {"todo_stop_guard": False}}
+            ))
+        with patch.dict(os.environ, {"HERMES_TODO_STOP_GUARD": "off"}, clear=True):
+            self.assertFalse(todo_stop_guard_enabled(
+                {"agent": {"todo_stop_guard": True}}
+            ))
+
+    @patch.dict(os.environ, {}, clear=True)
+    def test_max_budget_is_bounded(self):
+        self.assertEqual(max_todo_stop_nudges(_config(maximum=99)), 8)
+        self.assertEqual(max_todo_stop_nudges(_config(maximum=-2)), 0)
+        self.assertEqual(max_todo_stop_nudges(_config(maximum="bad")), 4)
+
+
+if __name__ == "__main__":
+    unittest.main()
