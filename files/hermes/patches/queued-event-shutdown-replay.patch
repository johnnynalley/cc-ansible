+def test_batch_order_ack_and_no_duplicate_respool(flush_dir):
+    first = _event("first", "m1")
+    second = _event("second", "m2")
+    assert flush_queued_events_to_file(
+        [("session-a", first), ("session-a", second)]
+    ) == 2
+    files = list(flush_dir.glob("pending-*.json"))
+    assert len(files) == 1
+    assert flush_queued_events_to_file(
+        [("session-a", first), ("session-a", second)]
+    ) == 0
+    assert len(list(flush_dir.glob("pending-*.json"))) == 1
+
+    loaded = load_queued_event_spool()
+    assert [event.text for _key, event in loaded] == ["first", "second"]
+    restored_first = loaded[0][1]
+    restored_second = loaded[1][1]
+    assert acknowledge_queued_event_spool(restored_first) is True
+    payload = json.loads(files[0].read_text())
+    assert [item["data"]["text"] for item in payload["events"]] == ["second"]
+    assert acknowledge_queued_event_spool(restored_second) is True
+    assert not files[0].exists()
