+def flush_queued_events_to_file(
+    entries: Iterable[tuple[str, Any]],
+    *,
+    reason: str = QUEUED_EVENT_BATCH_REASON,
+) -> int:
+    """Atomically spool every not-yet-durable queued event as one batch.
+
+    One batch write gives the queue snapshot all-or-nothing publication. Events
+    restored from an older batch retain their existing reference and are not
+    duplicated when another shutdown occurs before they finish replaying.
+    """
+    pending: list[tuple[str, Any, str, dict]] = []
+    seen_objects: set[int] = set()
+    for session_key, event in list(entries):
+        if event is None or id(event) in seen_objects:
+            continue
+        seen_objects.add(id(event))
+        if queued_event_is_spooled(event):
+            continue
+        event_id = str(
+            getattr(event, "_hermes_shutdown_spool_id", None) or uuid.uuid4().hex
+        )
+        pending.append(
+            (str(session_key), event, event_id, serialise_queued_message_event(event))
+        )
+    if not pending:
+        return 0
+
+    flush_dir = _get_flush_dir()
+    created_ns = time.time_ns()
+    payload = {
+        "schema": QUEUED_EVENT_BATCH_SCHEMA,
+        "reason": reason,
+        "created_ns": created_ns,
+        "seq": next(_QUEUED_EVENT_BATCH_SEQ),
+        "events": [
+            {
+                "event_id": event_id,
+                "session_key": session_key,
+                "ordinal": ordinal,
+                "data": data,
+            }
+            for ordinal, (session_key, _event, event_id, data) in enumerate(pending)
+        ],
+    }
+    path = _write_payload(flush_dir, payload)
+    for _session_key, event, event_id, _data in pending:
+        setattr(event, "_hermes_shutdown_spool_path", str(path))
+        setattr(event, "_hermes_shutdown_spool_id", event_id)
+    logger.info(
+        "Flushed %d queued gateway event(s) to %s", len(pending), path,
+    )
+    return len(pending)
+
+
+def load_queued_event_spool() -> list[tuple[str, Any]]:
+    """Load durable gateway events in original batch/ordinal order.
+
+    Files are never removed here. Each reconstructed event carries a private
+    batch reference that is acknowledged only after its replayed turn has been
+    processed and persisted successfully.
+    """
+    try:
+        flush_dir = _get_flush_dir()
+        candidates = list(flush_dir.glob("pending-*.json"))
+    except Exception as exc:
+        logger.warning("Cannot scan queued-event shutdown spool: %s", exc)
+        return []
+
+    loaded = []
+    seen_ids: set[str] = set()
+    for path in candidates:
+        try:
+            payload = json.loads(path.read_text(encoding="utf-8"))
+        except Exception as exc:
+            logger.warning("Cannot parse pending-message spool %s: %s", path, exc)
+            continue
+        if payload.get("reason") != QUEUED_EVENT_BATCH_REASON:
+            continue
+        if payload.get("schema") != QUEUED_EVENT_BATCH_SCHEMA:
+            logger.warning("Preserving unsupported queued-event spool %s", path)
+            continue
+        events = payload.get("events")
+        if not isinstance(events, list):
+            logger.warning("Preserving invalid queued-event batch %s", path)
+            continue
+        for fallback_ordinal, item in enumerate(events):
+            try:
+                if not isinstance(item, dict):
+                    raise ValueError("event entry must be an object")
+                event_id = str(item["event_id"])
+                session_key = str(item["session_key"])
+                if not event_id or not session_key:
+                    raise ValueError("event id and session key are required")
+                if event_id in seen_ids:
+                    logger.warning(
+                        "Ignoring duplicate queued-event spool id %s from %s",
+                        event_id, path,
+                    )
+                    continue
+                event = deserialise_queued_message_event(item.get("data"))
+                setattr(event, "_hermes_shutdown_spool_path", str(path))
+                setattr(event, "_hermes_shutdown_spool_id", event_id)
+                seen_ids.add(event_id)
+                loaded.append(
+                    (
+                        int(payload.get("created_ns", 0)),
+                        int(payload.get("seq", 0)),
+                        int(item.get("ordinal", fallback_ordinal)),
+                        path.name,
+                        session_key,
+                        event,
+                    )
+                )
+            except Exception as exc:
+                logger.warning(
+                    "Preserving invalid queued event in %s for manual recovery: %s",
+                    path, exc,
+                )
+    loaded.sort(key=lambda item: item[:4])
+    return [(session_key, event) for *_order, session_key, event in loaded]
+
+
+def acknowledge_queued_event_spool(event: Any) -> bool:
+    """Remove one successfully processed event from its durable batch."""
+    reference = queued_event_spool_reference(event)
+    if reference is None:
+        return False
+    path, event_id = reference
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+        if payload.get("reason") != QUEUED_EVENT_BATCH_REASON:
+            return False
+        events = payload.get("events")
+        if not isinstance(events, list):
+            return False
+        remaining = [
+            item for item in events
+            if not isinstance(item, dict) or str(item.get("event_id")) != event_id
+        ]
+        if len(remaining) == len(events):
+            return False
+        if remaining:
+            payload["events"] = remaining
+            from utils import atomic_json_write
+            atomic_json_write(path, payload, mode=0o600, default=str)
+        else:
+            path.unlink(missing_ok=True)
+        _fsync_directory(path.parent)
+        return True
+    except Exception as exc:
+        logger.warning(
+            "Failed to acknowledge queued-event spool %s/%s: %s",
+            path, event_id, exc,
+        )
+        return False
+
