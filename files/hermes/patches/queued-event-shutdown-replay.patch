+        ).fetchone() is None:
+            raise ValueError(f"unknown execution id: {execution_id}")
+        cursor = conn.execute(
+            """INSERT INTO execution_deliveries
+               (execution_id, platform, chat_id, thread_id, status,
+                message_id, delivered_at)
+               VALUES (?, ?, ?, ?, ?, ?, ?)""",
+            (
+                str(execution_id),
+                str(platform),
+                str(chat_id),
+                str(thread_id or ""),
+                clean_status,
+                str(message_id) if message_id is not None else None,
+                now,
+            ),
+        )
+        row = conn.execute(
+            "SELECT * FROM execution_deliveries WHERE id=?", (cursor.lastrowid,)
+        ).fetchone()
+    return dict(row)  # type: ignore[arg-type]
+
+
+def list_execution_deliveries(execution_id: str) -> List[Dict[str, Any]]:
+    """Return content-free delivery receipts in send order."""
+    with _transaction() as conn:
+        rows = conn.execute(
+            """SELECT * FROM execution_deliveries
+               WHERE execution_id=? ORDER BY id""",
+            (str(execution_id),),
+        ).fetchall()
+    return [dict(row) for row in rows]
 
 
