+def _json_safe(value: Any, *, _depth: int = 0) -> Any:
+    """Return a bounded JSON-safe projection of platform event data.
+
+    Normalized gateway fields are already JSON-native. ``raw_message`` and
+    plugin metadata occasionally contain enums, datetimes, tuples, or SDK
+    objects; retain their useful shape where possible and fall back to a string
+    rather than making the whole accepted inbound event unspoolable.
+    """
+    if _depth > 12:
+        return str(value)
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, datetime):
+        return value.isoformat()
+    if isinstance(value, Enum):
+        return _json_safe(value.value, _depth=_depth + 1)
+    if isinstance(value, dict):
+        return {
+            str(key): _json_safe(item, _depth=_depth + 1)
+            for key, item in value.items()
+        }
+    if isinstance(value, (list, tuple, set)):
+        return [_json_safe(item, _depth=_depth + 1) for item in value]
+    try:
+        attrs = vars(value)
+    except (TypeError, AttributeError):
+        return str(value)
+    return {
+        str(key): _json_safe(item, _depth=_depth + 1)
+        for key, item in attrs.items()
+        if not str(key).startswith("_")
+    }
