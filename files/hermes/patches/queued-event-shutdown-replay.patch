+    def _queued_gateway_event_snapshot(self) -> list[tuple[str, MessageEvent]]:
+        """Return every adapter head plus runner overflow in per-session FIFO order."""
+        heads: "OrderedDict[str, list[MessageEvent]]" = OrderedDict()
+        for adapter in self._iter_gateway_adapters():
+            pending = getattr(adapter, "_pending_messages", None)
+            if not isinstance(pending, dict):
+                continue
+            for session_key, event in list(pending.items()):
+                if session_key and event is not None:
+                    heads.setdefault(str(session_key), []).append(event)
+
+        overflows = getattr(self, "_queued_events", None) or {}
+        ordered_keys = list(heads)
+        ordered_keys.extend(
+            str(key) for key in overflows if str(key) not in heads
+        )
+        snapshot: list[tuple[str, MessageEvent]] = []
+        for session_key in ordered_keys:
+            for event in heads.get(session_key, []):
+                snapshot.append((session_key, event))
+            for event in list(overflows.get(session_key, []) or []):
+                if event is not None:
+                    snapshot.append((session_key, event))
+        return snapshot
