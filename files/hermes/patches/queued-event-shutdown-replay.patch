+    def _flush_shutdown_queued_events(self) -> bool:
+        """Durably snapshot the complete accepted-message FIFO.
+
+        Returns True only when every current event has a surviving full-event
+        spool reference. A single serialization/write failure leaves all
+        in-memory queues intact for the post-disconnect retry.
+        """
+        entries = self._queued_gateway_event_snapshot()
+        if not entries:
+            return True
+        try:
+            from gateway.shutdown_flush import (
+                flush_queued_events_to_file,
+                queued_event_is_spooled,
+            )
+            flush_queued_events_to_file(entries)
+            missing = [
+                session_key for session_key, event in entries
+                if not queued_event_is_spooled(event)
+            ]
+            if missing:
+                logger.error(
+                    "Queued-event shutdown snapshot incomplete for %d event(s)",
+                    len(missing),
+                )
+                return False
+            return True
+        except Exception:
+            logger.exception("Failed to snapshot queued gateway events during shutdown")
+            return False
