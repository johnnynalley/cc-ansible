+def test_full_event_roundtrip_preserves_routing_and_trust(flush_dir):
+    original = _event("first", "m1")
+    assert flush_queued_events_to_file([("session-a", original)]) == 1
+
+    loaded = load_queued_event_spool()
+    assert len(loaded) == 1
+    session_key, restored = loaded[0]
+    assert session_key == "session-a"
+    assert restored.text == original.text
+    assert restored.message_type is MessageType.PHOTO
+    assert restored.raw_message["nested"][1] == "2026-08-24T00:00:00+00:00"
+    assert restored.media_urls == ["/tmp/photo.jpg"]
+    assert restored.prompt_response == {"prompt_id": "p1", "option_id": "yes"}
+    assert restored.auto_skill == ["fortnite-tracker", "hardware-tracker"]
+    assert restored.metadata == {"gateway_session_strict": True, "tuple": [1, 2]}
+    assert restored.allow_gateway_control is False
+    assert restored.source.scope_id == "guild-4"
+    assert restored.source.guild_id == "guild-4"
+    assert restored.source.is_bot is True
+    assert restored.source.role_authorized is True
+    assert restored.source.profile_route_rejected is True
+    assert restored.source.delivered_via_upstream_relay is True
+
