--- /dev/null
+++ b/agent/todo_stop.py
@@ -0,0 +1,117 @@
+"""Bounded turn-end guard for unfinished native TodoStore work."""
+
+from __future__ import annotations
+
+import os
+from typing import Any, Optional
+
+
+_ACTIVE = frozenset({"pending", "in_progress"})
+_DEFAULT_MAX_ATTEMPTS = 4
+_MAX_SHOWN = 8
+
+
+def _agent_config(config: dict[str, Any] | None = None) -> dict[str, Any]:
+    if config is None:
+        try:
+            from hermes_cli.config import load_config_readonly
+
+            config = load_config_readonly()
+        except Exception:
+            config = {}
+    if not isinstance(config, dict):
+        return {}
+    value = config.get("agent")
+    return value if isinstance(value, dict) else {}
+
+
+def todo_stop_guard_enabled(config: dict[str, Any] | None = None) -> bool:
+    """Return whether unfinished todos must continue before a plain stop."""
+    override = os.environ.get("HERMES_TODO_STOP_GUARD")
+    if override is not None:
+        return override.strip().lower() not in {"0", "false", "no", "off"}
+    value = _agent_config(config).get("todo_stop_guard", False)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.strip().lower() in {"1", "true", "yes", "on"}
+    return False
+
+
+def max_todo_stop_nudges(config: dict[str, Any] | None = None) -> int:
+    """Return the bounded configured continuation budget."""
+    value = _agent_config(config).get(
+        "max_todo_stop_nudges", _DEFAULT_MAX_ATTEMPTS
+    )
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError):
+        return _DEFAULT_MAX_ATTEMPTS
+    return max(0, min(parsed, 8))
+
+
+def _active_items(store: Any) -> list[dict[str, str]]:
+    if store is None or not callable(getattr(store, "read", None)):
+        return []
+    try:
+        items = store.read()
+    except Exception:
+        return []
+    if not isinstance(items, list):
+        return []
+    active: list[dict[str, str]] = []
+    for item in items:
+        if not isinstance(item, dict) or item.get("status") not in _ACTIVE:
+            continue
+        item_id = str(item.get("id") or "?").strip()[:80] or "?"
+        content = " ".join(str(item.get("content") or "unfinished task").split())
+        active.append(
+            {
+                "id": item_id,
+                "content": content[:240] or "unfinished task",
+                "status": str(item["status"]),
+            }
+        )
+    return active
+
+
+def build_todo_stop_nudge(
+    *,
+    store: Any,
+    attempts: int = 0,
+    config: dict[str, Any] | None = None,
+    max_attempts: Optional[int] = None,
+) -> Optional[str]:
+    """Continue one turn when its native task list still has active work."""
+    if not todo_stop_guard_enabled(config):
+        return None
+    limit = max_todo_stop_nudges(config) if max_attempts is None else max_attempts
+    if attempts >= max(0, min(int(limit), 8)):
+        return None
+    active = _active_items(store)
+    if not active:
+        return None
+
+    shown = active[:_MAX_SHOWN]
+    lines = [
+        f"- [{item['status']}] {item['id']}: {item['content']}" for item in shown
+    ]
+    if len(active) > len(shown):
+        lines.append(f"- ... and {len(active) - len(shown)} more")
+    return (
+        "[System: Your native Hermes task list still has unfinished work. A "
+        "plain final response does not complete or block these items.\n\n"
+        + "\n".join(lines)
+        + "\n\nContinue the actual work now. Use the available tools, verify each "
+        "deliverable exists or the requested action really completed, and update "
+        "the todo statuses. Mark an item completed only after real evidence. If a "
+        "concrete blocker makes an item impossible, cancel that item and explain "
+        "the blocker in the final response. Do not merely restate the plan.]"
+    )
+
+
+__all__ = [
+    "build_todo_stop_nudge",
+    "max_todo_stop_nudges",
+    "todo_stop_guard_enabled",
+]
