+    def _clear_durably_spooled_gateway_events(self) -> int:
+        """Clear only queue entries proven durable after transport shutdown."""
+        try:
+            from gateway.shutdown_flush import queued_event_is_spooled
+        except Exception:
+            return 0
+        cleared = 0
+        for adapter in self._iter_gateway_adapters():
+            pending = getattr(adapter, "_pending_messages", None)
+            if not isinstance(pending, dict):
+                continue
+            for session_key, event in list(pending.items()):
+                if queued_event_is_spooled(event):
+                    pending.pop(session_key, None)
+                    cleared += 1
+        for session_key, events in list((getattr(self, "_queued_events", None) or {}).items()):
+            kept = []
