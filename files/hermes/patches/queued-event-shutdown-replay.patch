@@ -0,0 +1,100 @@
+"""Regression tests for bounded Mem0 background-work shutdown."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import threading
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).parents[3]))
+
+import plugins.memory.mem0 as mem0_plugin
+from plugins.memory.mem0 import Mem0MemoryProvider
+
+
+class BlockingBackend:
+    def __init__(self) -> None:
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        self.completed = threading.Event()
+        self.closed = threading.Event()
+
+    def add(self, messages, **kwargs):
+        self.entered.set()
+        self.release.wait(30)
+        self.completed.set()
+        return {"status": "ok"}
+
+    def close(self) -> None:
+        if not self.completed.is_set():
+            raise AssertionError("backend closed before active sync completed")
+        self.closed.set()
+
+
+def provider_with(backend: BlockingBackend) -> Mem0MemoryProvider:
+    provider = Mem0MemoryProvider()
+    provider._backend = backend
+    provider._user_id = "test-user"
+    provider._agent_id = "test-agent"
+    return provider
+
+
+class Mem0ShutdownTests(unittest.TestCase):
+    def test_shutdown_waits_for_active_sync_before_close(self) -> None:
+        backend = BlockingBackend()
+        provider = provider_with(backend)
+        provider.sync_turn("user", "assistant")
+        self.assertTrue(backend.entered.wait(5))
+
+        shutdown_done = threading.Event()
+
+        def shutdown() -> None:
+            provider.shutdown()
+            shutdown_done.set()
+
+        thread = threading.Thread(target=shutdown)
+        thread.start()
+        self.assertFalse(shutdown_done.wait(0.05))
+        self.assertFalse(backend.closed.is_set())
+
+        backend.release.set()
+        thread.join(5)
+        self.assertTrue(shutdown_done.is_set())
+        self.assertTrue(backend.completed.is_set())
+        self.assertTrue(backend.closed.is_set())
+
+    def test_timeout_never_closes_backend_under_active_sync(self) -> None:
+        backend = BlockingBackend()
+        provider = provider_with(backend)
+        provider.sync_turn("user", "assistant")
+        self.assertTrue(backend.entered.wait(5))
+
+        with patch.object(mem0_plugin, "_SYNC_SHUTDOWN_WAIT_SECS", 0.01):
+            provider.shutdown()
+        self.assertFalse(backend.closed.is_set())
+
+        backend.release.set()
+        provider._sync_thread.join(5)
+        provider.shutdown()
+        self.assertTrue(backend.closed.is_set())
+
+    def test_atexit_uses_ordered_provider_shutdown(self) -> None:
+        backend = BlockingBackend()
+        backend.completed.set()
+        provider = Mem0MemoryProvider()
+        with (
+            patch.object(mem0_plugin, "_load_config", return_value={"mode": "oss"}),
+            patch.object(provider, "_create_backend", return_value=backend),
+            patch.object(mem0_plugin.atexit, "register") as register,
+        ):
+            provider.initialize("test-session")
+
+        callback = register.call_args.args[0]
+        self.assertIs(callback.__self__, provider)
+        self.assertIs(callback.__func__, provider.shutdown.__func__)
+
+
+if __name__ == "__main__":
+    unittest.main()
