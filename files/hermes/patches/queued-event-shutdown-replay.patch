+def queued_event_spool_reference(event: Any) -> Optional[tuple[Path, str]]:
+    """Return a validated in-memory spool reference attached to an event."""
+    raw_path = getattr(event, "_hermes_shutdown_spool_path", None)
+    event_id = getattr(event, "_hermes_shutdown_spool_id", None)
+    if not raw_path or not event_id:
+        return None
+    try:
+        path = Path(raw_path)
+        flush_dir = _get_flush_dir().resolve()
+        if path.resolve().parent != flush_dir or not path.name.startswith("pending-"):
+            return None
+    except (OSError, RuntimeError, ValueError):
+        return None
+    return path, str(event_id)
+
+
+def queued_event_is_spooled(event: Any) -> bool:
+    """Return True when an event already has a surviving durable payload."""
+    reference = queued_event_spool_reference(event)
+    return bool(reference and reference[0].is_file())
+
