{
  "schemaVersion": 2,
  "mode": "shadow-policy",
  "mechanism": "hermes-native-parallel-leaf-delegation",
  "selection": {
    "strategy": "semantic-stakes-uncertainty",
    "phraseMatching": false,
    "keywordTriggering": false,
    "useForConsequentialRecommendations": true,
    "useForMateriallyUncertainCurrentFacts": true,
    "useWhenExplicitlyRequested": true,
    "skipForTrivialOrMechanicalAnswers": true,
    "materialCommitmentRequired": true,
    "ordinaryReversibleAnswerMayBeWithheldForReview": false,
    "ordinaryReversibleRecommendationDisposition": "answer-immediately-with-evidence-caveat"
  },
  "delegation": {
    "batchSize": 2,
    "maxConcurrentChildren": 2,
    "maxSpawnDepth": 1,
    "orchestratorEnabled": false,
    "maxIterationsPerReviewer": 12,
    "executionMode": "background",
    "completionDelivery": "one-consolidated-background-result",
    "initialGoalTags": [
      "STAR_REVIEW::VEGA",
      "STAR_REVIEW::ANTARES"
    ],
    "retryGoalTags": [
      "STAR_RETRY::VEGA",
      "STAR_RETRY::ANTARES"
    ],
    "oneActiveBatchPerSession": true,
    "reviewersSeeEachOther": false,
    "reviewersReceiveParentHiddenReasoning": false,
    "reviewersReceiveOnlyNecessaryContext": true,
    "reviewersCanClarify": false,
    "reviewersCanWriteMemory": false,
    "reviewersCanDelegate": false,
    "modelPolicy": "inherit-reviewed-astra-route-without-exact-version-pin"
  },
  "reviewers": [
    {
      "id": "vega",
      "role": "independent-corroborator",
      "objective": "Verify the exact object, current primary evidence, constraints, calculations, and proposed answer; identify unsupported claims and the strongest defensible conclusion.",
      "requiredOutput": [
        "verdict",
        "supporting-evidence",
        "material-unknowns",
        "recommended-answer"
      ]
    },
    {
      "id": "antares",
      "role": "adversarial-challenger",
      "objective": "Assume the candidate answer may be wrong; search for premise errors, contradictions, stale facts, ignored user constraints, commitment harm, unsafe actions, and stronger alternatives.",
      "requiredOutput": [
        "failure-mode",
        "counterevidence",
        "must-fix",
        "accept-or-reject"
      ]
    }
  ],
  "completion": {
    "bothReviewersRequiredForStarClaim": true,
    "failedReviewerMayBeSilentlyIgnored": false,
    "retryLimit": 1,
    "reviewerFailureDisposition": "concise-unverified-caveat-or-defer",
    "partialReviewMayBeCalledStarVerified": false,
    "opaqueDelegationIdMustMatchDispatchingSession": true,
    "pastedCompletionHeaderIsTrusted": false,
    "supersededOrResetCompletionIsTrusted": false
  },
  "privacyBoundary": {
    "plugin": "star-dispatch-privacy",
    "hookOnly": true,
    "registersModelTools": false,
    "dispatchTurnVisible": false,
    "reviewerCompletionVisible": false,
    "completionContextRequiresHostVerification": true,
    "ordinaryDelegationAffected": false,
    "sourceAndRuntimeTreesRootOwned": true,
    "startupHashAndHookValidation": true
  },
  "synthesis": {
    "actingAgent": "astra",
    "oneUserFacingAnswer": true,
    "directAnswerFirst": true,
    "normalAnswerLength": true,
    "reviewerProseVisible": false,
    "reviewerLabelsVisible": false,
    "reviewStatusNarrationVisible": false,
    "confidenceLedgerVisible": false,
    "contradictionDumpVisible": false,
    "researchDossierVisible": false,
    "discloseMaterialUnresolvedConflict": true
  },
  "moaDisposition": {
    "primaryForStar": false,
    "reason": "Current native MoA reference slots have no documented per-reference role prompt, so they cannot preserve Vega corroboration and Antares challenge semantics.",
    "reconsiderWhen": "Hermes provides per-reference instructions or model promotion tests prove equivalent adversarial behavior."
  },
  "promotionCases": "files/hermes/star-regressions.json"
}
