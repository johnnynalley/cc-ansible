  "workspace": {
    "policy": "files/openclaw/workspace-migration-policy.json",
    "policySha256": "08e30aa55c72a54a6ac0e7c67e6d99b5557bd0fed75e8b16a19af556ee20e211",
    "dispositionHandlers": {
      "retain": {
        "action": "curated-import",
        "destination": "profile-specific staged data with the policy owner class",
        "activation": "post-parity"
      },
      "archive": {
        "action": "sealed-archive",
        "destination": "root-only offline OpenClaw archive",
        "activation": "offline-only"
      },
      "replace": {
        "action": "review-rebuild",
        "destination": "Hermes-native or external owner-specific replacement",
        "activation": "post-parity"
      },
      "retire": {
        "action": "sealed-archive",
        "destination": "root-only retired-component archive",
        "activation": "offline-only"
      },
      "discard": {
        "action": "discard-after-proof",
        "destination": "none after archive, parity, restore, and retention approval",
        "activation": "post-parity"
      }
    },
    "ruleOverrides": {
      "health-database": {
        "action": "retain-external",
        "destination": "dedicated Health receiver",
        "activation": "post-parity",
        "backupMethod": "sqlite-consistent-backup-after-receiver-stop"
      }
    }
  },
