        "id": "state-git",
        "scope": "exact",
        "pattern": ".git",
        "expectedKind": "directory",
        "action": "sealed-archive",
        "destination": "root-only source-control evidence archive",
        "activation": "offline-only",
        "reason": "Damaged or historical OpenClaw Git state is rollback evidence, not a Hermes runtime source."
      },
      {
        "id": "state-gitignore",
        "scope": "exact",
