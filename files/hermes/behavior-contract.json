{
  "schemaVersion": 1,
  "mode": "shadow-policy",
  "routing": {
    "selector": "semantic-intent-stakes-uncertainty-state",
    "phraseMatching": false,
    "keywordTriggering": false,
    "fullThreadRequired": true,
    "durableStateRequiredWhenRelevant": true
  },
  "output": {
    "directAnswerFirst": true,
    "singleUserFacingAnswer": true,
    "privateReviewerEvidence": true,
    "internalReasoningVisible": false,
    "toolPlumbingVisible": false,
    "correctionTransactionVisible": false,
    "routineValidationNarrationVisible": false
  },
  "continuity": {
    "busyInputMode": "queue",
    "oneTurnPerFollowUp": true,
    "unfinishedAnswerMayBeSuperseded": false,
    "explicitStopOrResetMayInterrupt": true
  },
  "authorization": {
    "source": "current-raw-owner-turn",
    "explicitScopeRequired": true,
    "readOnlyInquiryIsDefault": true,
    "questionsAuthorizeMutation": false,
    "futureDesireAuthorizesMutation": false,
    "plansAuthorizeMutation": false,
    "priorApprovalCarriesForward": false,
    "delegatedPromptMayGrantMutationAuthority": false,
    "clearCurrentTurnAntecedentMayAuthorize": true,
    "repositoryImplementationAuthorizesDeployment": false,
    "smartApprovalSuppliesIntent": false,
    "unexpectedMutationDisposition": "stop-and-report"
  },
  "corrections": {
    "fixCurrentAnswerFirst": true,
    "rootCauseClassRequired": true,
    "generalizeBeforeProposal": true,
    "preventionRegressionRequired": true,
    "foregroundProposalNarration": "only-when-owner-action-required",
    "incidentSpecificRuleDefault": "reject",
    "existingControlFailureDisposition": "regression-or-enforcement-proposal",
    "generatedOutputMayServeAsEvidence": false
  },
  "selfEvolution": {
    "mechanism": "hermes-native-background-review",
    "selection": "semantic-context-review",
    "memoryWrites": "direct-native-after-review",
    "skillWrites": "direct-native-after-review",
    "sharedProposalsSurviveRestart": true,
    "automaticApply": true,
    "selfApproval": false,
    "ownerApprovalRequiredForNativeState": false,
    "nativePolicyWritableByOwningAgent": true,
    "rootPolicyWritableByAgent": false,
    "toolAuthorityWritableByAgent": false,
    "notifications": "off",
    "proposalRouting": {
      "user-preference": "user-memory",
      "stable-environment-fact": "profile-memory",
      "reusable-procedure": "profile-skill",
      "behavior-policy": "profile-native-guidance",
      "security-policy": "owner-managed-platform",
      "deployment-policy": "owner-managed-platform"
    },
    "sharedSelfEvolution": {
      "writer": "astra",
      "proposalSources": ["dubble", "rigel"],
      "acceptance": "necessary-and-beneficial-fleet-wide"
    }
  },
  "profilePolicyOwnership": {
    "authority": "hermes-native-profile",
    "repositoryManaged": false,
    "runtimePaths": {
      "astra": "AGENTS.md",
      "dubble": "AGENTS.md",
      "rigel": "AGENTS.md"
    }
  },
  "regressionCases": "files/hermes/behavior-regressions.json"
}
