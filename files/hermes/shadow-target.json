{
  "schemaVersion": 2,
  "deployment": {
    "mode": "shadow",
    "targetHost": "jn-t14s-lin",
    "sameHostReplacement": true,
    "sourceRuntimeConcurrentEnabled": false,
    "sourceFilesRetained": true,
    "sourceFilesDirectlyReadableByHermes": false,
    "productionDeliveryEnabled": false,
    "productionSchedulerEnabled": false,
    "dashboardEnabled": false,
    "apiServerEnabled": false,
    "externalListenerEnabled": false,
    "productionRouteEnabled": false,
    "sourceCleanupEnabled": false,
    "sourceArchiveEnabled": false,
    "retiredVmReuseEnabled": false
  },
  "host": {
    "osTrack": "managed-jn-t14s-lin",
    "minimumLogicalCpus": 8,
    "minimumAvailableMemoryMiB": 8192,
    "minimumFreeDiskGiB": 24,
    "separateServiceUsers": true,
    "sharedProfileHomes": false,
    "sourceStateCopiedWholesale": false,
    "sourceStateDirectlyMounted": false,
    "controllerHomeReadable": false,
    "dockerSocketReadable": false,
    "usbDeviceAccess": false
  },
  "runtime": {
    "installMethod": "official-git-native-update",
    "releaseTrack": "official-default",
    "sourceRepo": "https://github.com/NousResearch/hermes-agent.git",
    "dependencySync": "uv-sync-extra-all-locked",
    "dependencyFallbackEnabled": false,
    "nodeDependencyInstallEnabled": false,
    "codeRoot": "/usr/local/lib/hermes-agent",
    "launcher": "/usr/local/bin/hermes",
    "managedScope": "/etc/hermes",
    "runtimeSelfUpdateEnabled": true,
    "nativeUpdateCommand": "hermes update",
    "nativeUpdatePrivilegeBridge": "astra-exact-systemd-unit",
    "nativeUpdateExecutionUser": "hermes-astra",
    "nativeUpdateGatewayManageUnits": [
      "hermes-gateway-astra.service",
      "hermes-gateway-dubble.service",
      "hermes-gateway-rigel.service"
    ],
    "nativeUpdateLoadsServiceSecrets": false,
    "nativeUpdateRootCapabilities": false,
    "nativeAutomaticUpdateTimerStaged": true,
    "automaticUpdatesRequiredAtCutover": true,
    "tirithInstallMethod": "official-self-managed",
    "tirithNativeUpdateCommand": "tirith update",
    "runtimeLazyInstallsEnabled": false,
    "rootManagedCommandScanner": true,
    "scannerRuntimeNetworkEnabled": false,
    "bundledSkillsEnabled": false
  },
  "sandbox": {
    "backend": "docker",
    "binary": "/usr/bin/podman",
    "rootless": true,
    "dockerGroup": false,
    "dockerSocket": false,
    "localTerminalFallback": false,
    "mountCwd": false,
    "hostVolumes": [],
    "forwardEnvironment": [],
    "forwardCredentialFiles": [],
    "networkEnabled": false,
    "runAsHostUser": false,
    "profileScopedContainers": true,
    "resourceEnforcementRequiresProof": true
  },
  "commonPolicy": {
    "approvalMode": "manual",
    "cronApprovalMode": "deny",
    "permanentCommandAllowlist": [],
    "memoryWriteApproval": true,
    "skillsWriteApproval": true,
    "agentSkillScan": true,
    "promptInjectionScan": true,
    "secretRedaction": true,
    "ssrfProtection": true,
    "privateUrlAccess": false,
    "tirithFailOpen": false,
    "destructiveSlashConfirmation": true,
    "mcpReloadConfirmation": true,
    "autoAcceptHooks": false,
    "allowAllDiscordUsers": false,
    "generalSudoers": false,
    "nativeUpdateTriggerSudoers": true,
    "supplementaryDockerGroup": false
  },
  "profiles": [
    {
      "name": "astra",
      "serviceUser": "hermes-astra",
      "serviceGroup": "hermes-astra",
      "home": "/var/lib/hermes/astra",
      "unit": "hermes-gateway-astra.service",
      "productionTokenPresent": false,
      "productionCronDeliveryEnabled": false,
      "terminalEnabled": false,
      "requiredCapabilities": [
        "discord",
        "web-research",
        "memory",
        "session-search",
        "review-gated-skills",
        "mixture-of-agents",
        "cron-declarations",
        "aggregate-report-read",
        "broker-proposal",
        "native-self-update-trigger"
      ],
      "forbiddenCapabilities": [
        "sudo",
        "docker-daemon",
        "ansible-vault",
        "controller-ssh",
        "computer-use",
        "raw-health",
        "broker-approval"
      ]
    },
    {
      "name": "dubble",
      "serviceUser": "hermes-dubble",
      "serviceGroup": "hermes-dubble",
      "home": "/var/lib/hermes/dubble",
      "unit": "hermes-gateway-dubble.service",
      "productionTokenPresent": false,
      "productionCronDeliveryEnabled": false,
      "terminalEnabled": false,
      "requiredCapabilities": [
        "discord",
        "public-support",
        "memory",
        "session-search",
        "bounded-astra-handoff"
      ],
      "forbiddenCapabilities": [
        "terminal",
        "computer-use",
        "sudo",
        "docker-daemon",
        "host-reports",
        "infrastructure",
        "cross-profile-secrets"
      ]
    },
    {
      "name": "rigel",
      "serviceUser": "hermes-rigel",
      "serviceGroup": "hermes-rigel",
      "home": "/var/lib/hermes/rigel",
      "unit": "hermes-gateway-rigel.service",
      "productionTokenPresent": false,
      "productionCronDeliveryEnabled": false,
      "terminalEnabled": false,
      "requiredCapabilities": [
        "discord",
        "study-context",
        "memory",
        "session-search",
        "always-enabled-silent-scheduler",
        "canonical-source-read"
      ],
      "forbiddenCapabilities": [
        "terminal",
        "computer-use",
        "sudo",
        "docker-daemon",
        "host-reports",
        "infrastructure",
        "cross-profile-secrets"
      ]
    }
  ],
  "brokers": {
    "healthInput": "aggregate-only-read",
    "dockerInput": "result-only-read",
    "dockerUpdate": "proposal-and-approved-plan-only",
    "agentCanApprovePlan": false,
    "arbitraryCommand": false,
    "arbitraryPath": false
  },
  "backup": {
    "sqliteSafeHermesBackup": true,
    "preUpdateFullBackup": true,
    "encryptedRestic": true,
    "hostFilesystemBackup": true,
    "restoreTestRequired": true,
    "openclawReferencePreserved": true
  }
}
