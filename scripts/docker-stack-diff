#!/usr/bin/env bash
# =============================================================================
# docker-stack-diff - Compare running container images against pulled images
# =============================================================================
# Runs AFTER 'docker compose pull' but BEFORE 'docker compose up -d'.
# For each service, compares the running container's image ID against the
# locally available image ID. Reports services where images differ, with
# version labels when available (org.opencontainers.image.version). When OCI
# source/revision labels are present, it also prints a compare URL so update
# notifications point at the exact image-build changes.
#
# Usage: docker-stack-diff [--check-major] /path/to/compose/project
#
# Options:
#   --check-major  Flag major version bumps with MAJOR: prefix and exit 2
#
# Exit codes:
#   0  No changes, or only minor/patch changes (safe to auto-update)
#   2  Major version bump detected (only with --check-major)
# =============================================================================

set -uo pipefail

# Parse flags
CHECK_MAJOR=false
if [[ "${1:-}" == "--check-major" ]]; then
    CHECK_MAJOR=true
    shift
fi

COMPOSE_DIR="${1:?Usage: docker-stack-diff [--check-major] /path/to/compose/project}"
cd "$COMPOSE_DIR" || exit 0

# Extract the first numeric component from a version string.
# Handles: semver (1.2.3), v-prefix (v8.0.0), calver (2026.01), plain (7)
# Returns empty string if unparseable.
get_major_version() {
    local ver="$1"
    ver="${ver#v}"
    ver="${ver#V}"
    ver="${ver#release-}"
    if [[ "$ver" =~ ^([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

clean_label() {
    local value="$1"
    [[ "$value" == "<no value>" ]] && value=""
    echo "$value"
}

github_compare_url() {
    local source="$1"
    local old_rev="$2"
    local new_rev="$3"

    [ -z "$source" ] && return 1
    [ -z "$old_rev" ] && return 1
    [ -z "$new_rev" ] && return 1
    [ "$old_rev" = "$new_rev" ] && return 1

    source="${source%.git}"
    case "$source" in
        https://github.com/*)
            echo "${source}/compare/${old_rev}...${new_rev}"
            ;;
        *)
            return 1
            ;;
    esac
}

# Compare two version strings and return 0 (true) if major version differs.
# Returns 1 (false) if either version is missing/unparseable.
is_major_bump() {
    local old_major new_major
    old_major=$(get_major_version "$1")
    new_major=$(get_major_version "$2")
    [[ -z "$old_major" || -z "$new_major" ]] && return 1
    [[ "$old_major" != "$new_major" ]]
}

updates=()
has_major_bump=false

for svc in $(docker compose config --services 2>/dev/null); do
    # Get the container ID for this service (may not exist if never started)
    cid=$(docker compose ps -q "$svc" 2>/dev/null | head -1)
    [ -z "$cid" ] && continue

    # Get the image name the container was created from
    image_name=$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null)
    [ -z "$image_name" ] && continue

    # Image ID the container is currently running
    container_image_id=$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null)
    # Image ID available locally (after pull)
    current_image_id=$(docker image inspect --format '{{.Id}}' "$image_name" 2>/dev/null)

    # Skip if either ID is missing or they match (no update)
    [ -z "$current_image_id" ] && continue
    [ "$container_image_id" = "$current_image_id" ] && continue

    # Truncated hashes for display
    old_hash=${container_image_id#sha256:}
    old_hash=${old_hash:0:12}
    new_hash=${current_image_id#sha256:}
    new_hash=${new_hash:0:12}

    # Try to get version labels (OCI standard - used by linuxserver, Immich, etc.)
    old_version=$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$cid" 2>/dev/null)
    new_version=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$image_name" 2>/dev/null)

    old_version=$(clean_label "$old_version")
    new_version=$(clean_label "$new_version")

    old_revision=$(clean_label "$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$cid" 2>/dev/null)")
    new_revision=$(clean_label "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image_name" 2>/dev/null)")
    old_source=$(clean_label "$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.source"}}' "$cid" 2>/dev/null)")
    new_source=$(clean_label "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.source"}}' "$image_name" 2>/dev/null)")
    old_created=$(clean_label "$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.created"}}' "$cid" 2>/dev/null)")
    new_created=$(clean_label "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.created"}}' "$image_name" 2>/dev/null)")

    # Check for major version bump
    major_prefix=""
    if $CHECK_MAJOR && [ -n "$old_version" ] && [ -n "$new_version" ] \
       && [ "$old_version" != "$new_version" ]; then
        if is_major_bump "$old_version" "$new_version"; then
            major_prefix="MAJOR:"
            has_major_bump=true
        fi
    fi

    if [ -n "$old_version" ] && [ -n "$new_version" ] && [ "$old_version" != "$new_version" ]; then
        updates+=("${major_prefix}  ${svc}: ${old_version} -> ${new_version}  (${old_hash} -> ${new_hash})")
    elif [ -n "$new_version" ]; then
        updates+=("${major_prefix}  ${svc}: ${new_version}  (${old_hash} -> ${new_hash})")
    else
        updates+=("  ${svc}: ${old_hash} -> ${new_hash}  (${image_name})")
    fi

    source="${new_source:-$old_source}"
    if compare_url=$(github_compare_url "$source" "$old_revision" "$new_revision"); then
        updates+=("    image changes: ${compare_url}")
    elif [ -n "$old_revision" ] && [ -n "$new_revision" ] && [ "$old_revision" != "$new_revision" ]; then
        updates+=("    image revision: ${old_revision} -> ${new_revision}")
    fi

    if [ -n "$old_created" ] && [ -n "$new_created" ] && [ "$old_created" != "$new_created" ]; then
        updates+=("    image created: ${old_created} -> ${new_created}")
    fi
done

if [ ${#updates[@]} -eq 0 ]; then
    echo "(no image changes detected)"
else
    printf '%s\n' "${updates[@]}"
fi

# Exit 2 if major bumps detected (only in --check-major mode)
if $CHECK_MAJOR && $has_major_bump; then
    exit 2
fi
