#!/bin/bash

set -euo pipefail

usage() {
  printf 'usage: %s [!] {-r|-w|-x} PATH\n' "${0##*/}" >&2
  exit 64
}

case "$#" in
  2)
    [[ "$1" == "-r" || "$1" == "-w" || "$1" == "-x" ]] || usage
    ;;
  3)
    [[ "$1" == "!" ]] || usage
    [[ "$2" == "-r" || "$2" == "-w" || "$2" == "-x" ]] || usage
    ;;
  *)
    usage
    ;;
esac

# Bash's builtin test uses the process's effective supplementary groups. The
# host's uutils /usr/bin/test does not, so it is unsuitable for access gates.
builtin test "$@"
