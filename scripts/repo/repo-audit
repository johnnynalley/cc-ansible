#!/usr/bin/env python3
"""Static repository organization checks for cc-ansible."""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
TEXT_SUFFIXES = {
    "",
    ".cfg",
    ".conf",
    ".ini",
    ".j2",
    ".json",
    ".md",
    ".ps1",
    ".py",
    ".service",
    ".sh",
    ".timer",
    ".toml",
    ".txt",
    ".yaml",
    ".yml",
}


def host_agent_npm_prefix_errors() -> list[str]:
    errors: list[str] = []
    prefix_pattern = re.compile(r"^(codex|openclaw)_npm_prefix:\s*(\S+)\s*$")

    for host_dir in sorted((ROOT / "inventory" / "host_vars").iterdir()):
        if not host_dir.is_dir():
            continue

        prefixes: dict[str, str] = {}
        for path in sorted(host_dir.glob("*.yml")):
            text = read_text(path)
            if text is None:
                continue
            for line in text.splitlines():
                match = prefix_pattern.match(line.strip())
                if match:
                    prefixes[match.group(1)] = clean_ref(match.group(2))

        if {"codex", "openclaw"} <= prefixes.keys() and prefixes["codex"] != prefixes["openclaw"]:
            errors.append(
                f"{host_dir.relative_to(ROOT)} has divergent agent npm prefixes: "
                f"codex={prefixes['codex']} openclaw={prefixes['openclaw']}"
            )

    return errors


def tracked_files() -> list[Path]:
    result = subprocess.run(
        ["git", "ls-files"],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    skipped = {
        "CLAUDE.md",
        "scripts/repo/repo-audit",
        "scripts/repo/test_repo_audit.py",
    }
    return [
        ROOT / line
        for line in result.stdout.splitlines()
        if line and line not in skipped and (ROOT / line).exists()
    ]


def read_text(path: Path) -> str | None:
    if path.suffix not in TEXT_SUFFIXES:
        return None
    try:
        return path.read_text()
    except UnicodeDecodeError:
        return None


def clean_ref(value: str) -> str:
    return value.strip().strip("`'\"),.;:")


def profile_skill_contract_reference_errors(
    files: list[Path],
) -> tuple[list[str], set[tuple[str, str]]]:
    """Validate skill-relative support files and identify generic-scan aliases."""
    errors: list[str] = []
    ignored_generic_refs: set[tuple[str, str]] = set()
    contract_path = ROOT / "files" / "hermes" / "profile-skills-contract.json"
    if contract_path not in files:
        return errors, ignored_generic_refs

    try:
        contract = json.loads(contract_path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return [f"{contract_path.relative_to(ROOT)} is invalid: {exc}"], ignored_generic_refs

    contract_relative = contract_path.relative_to(ROOT).as_posix()
    for profile_name, profile in (contract.get("profiles") or {}).items():
        for skill in profile.get("skills") or []:
            source_value = skill.get("source")
            if not isinstance(source_value, str):
                errors.append(
                    f"{contract_relative} has invalid source for {profile_name}/"
                    f"{skill.get('name', 'unknown')}"
                )
                continue
            source_path = ROOT / source_value
            if not source_path.is_file():
                errors.append(f"{contract_relative} references missing {source_value}")
                continue
            for supporting_file in skill.get("supportingFiles") or []:
                relative_value = supporting_file.get("path")
                if not isinstance(relative_value, str):
                    errors.append(
                        f"{contract_relative} has invalid supporting file for "
                        f"{profile_name}/{skill.get('name', 'unknown')}"
                    )
                    continue
                target = source_path.parent / relative_value
                if not target.is_file():
                    errors.append(
                        f"{contract_relative} references missing skill support "
                        f"{target.relative_to(ROOT)}"
                    )
                if relative_value.startswith("templates/"):
                    ignored_generic_refs.add((contract_relative, relative_value))

    return errors, ignored_generic_refs


def reference_errors(
    files: list[Path],
    prefix: str,
    pattern: re.Pattern[str],
    ignored_references: set[tuple[str, str]] | None = None,
) -> list[str]:
    errors: list[str] = []
    ignored_references = ignored_references or set()
    for path in files:
        text = read_text(path)
        if text is None:
            continue
        for match in pattern.finditer(text):
            ref = clean_ref(match.group(1))
            reference = f"{prefix}/{ref}"
            if (path.relative_to(ROOT).as_posix(), reference) in ignored_references:
                continue
            if any(token in ref for token in ("{{", "{%", "*", "<", ">")):
                continue
            if "/" not in ref and "." not in ref and not (ROOT / prefix / ref).exists():
                continue
            target = ROOT / prefix / ref
            if not target.exists():
                errors.append(f"{path.relative_to(ROOT)} references missing {prefix}/{ref}")
    return errors


def run_secrets_scan(require_gitleaks: bool) -> list[str]:
    command = [str(ROOT / "scripts" / "repo" / "secrets-scan"), "--quiet"]
    if require_gitleaks:
        command.extend(["--external", "gitleaks", "--require-external"])

    result = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode == 0:
        return []

    output = result.stdout.strip()
    if not output:
        return ["secrets-scan failed without output"]
    return output.splitlines()


def parse_args() -> tuple[bool, bool]:
    require_gitleaks = "--require-gitleaks" in sys.argv[1:]
    no_secrets = "--no-secrets" in sys.argv[1:]
    unknown = [
        arg
        for arg in sys.argv[1:]
        if arg not in {"--require-gitleaks", "--no-secrets"}
    ]
    if unknown:
        print(f"usage: {Path(sys.argv[0]).name} [--require-gitleaks] [--no-secrets]", file=sys.stderr)
        sys.exit(2)
    return require_gitleaks, no_secrets


def main() -> int:
    require_gitleaks, no_secrets = parse_args()
    errors: list[str] = []
    files = tracked_files()

    for path in (ROOT / "templates").iterdir():
        if path.is_file() and path.name != "README.md":
            errors.append(f"flat template file is not allowed: {path.relative_to(ROOT)}")

    for path in (ROOT / "scripts").iterdir():
        if path.is_file() and path.name != "README.md":
            errors.append(f"flat script file is not allowed: {path.relative_to(ROOT)}")

    for path in (ROOT / "playbooks").iterdir():
        if path.is_file() and path.name != "README.md":
            errors.append(f"flat playbook file is not allowed: {path.relative_to(ROOT)}")

    errors.extend(host_agent_npm_prefix_errors())

    skill_contract_errors, skill_contract_relative_refs = (
        profile_skill_contract_reference_errors(files)
    )
    errors.extend(skill_contract_errors)

    errors.extend(
        reference_errors(
            files,
            "templates",
            re.compile(r"(?:templates/|\.\./templates/)([^\s`'\")\]\(]+)"),
            ignored_references=skill_contract_relative_refs,
        )
    )
    errors.extend(
        reference_errors(
            files,
            "scripts",
            re.compile(r"(?<!/)scripts/([^\s`'\")\]\(]+)"),
        )
    )
    errors.extend(
        reference_errors(
            files,
            "playbooks",
            re.compile(r"playbooks/([^\s`'\")\]\(]+\.yml)"),
        )
    )

    docs_readme = (ROOT / "docs" / "README.md").read_text() if (ROOT / "docs" / "README.md").exists() else ""
    agents = (ROOT / "AGENTS.md").read_text() if (ROOT / "AGENTS.md").exists() else ""
    repo_readme = (ROOT / "README.md").read_text() if (ROOT / "README.md").exists() else ""
    for doc in sorted((ROOT / "docs").glob("*.md")):
        if doc.name == "README.md":
            continue
        rel = doc.relative_to(ROOT).as_posix()
        if rel not in docs_readme:
            errors.append(f"docs/README.md is missing pointer for {rel}")
        if rel not in agents:
            errors.append(f"AGENTS.md is missing pointer for {rel}")
        if rel not in repo_readme:
            errors.append(f"README.md is missing pointer for {rel}")

    scripts_readme = (ROOT / "scripts" / "README.md").read_text()
    for directory in sorted(p for p in (ROOT / "scripts").iterdir() if p.is_dir()):
        if f"`{directory.name}/`" not in scripts_readme:
            errors.append(f"scripts/README.md is missing directory pointer for scripts/{directory.name}/")

    templates_readme = (ROOT / "templates" / "README.md").read_text()
    for directory in sorted(p for p in (ROOT / "templates").iterdir() if p.is_dir()):
        if f"`{directory.name}/`" not in templates_readme:
            errors.append(f"templates/README.md is missing directory pointer for templates/{directory.name}/")

    playbooks_readme = (ROOT / "playbooks" / "README.md").read_text()
    for directory in sorted(p for p in (ROOT / "playbooks").iterdir() if p.is_dir()):
        if f"`{directory.name}/`" not in playbooks_readme:
            errors.append(f"playbooks/README.md is missing directory pointer for playbooks/{directory.name}/")

    if not no_secrets:
        errors.extend(run_secrets_scan(require_gitleaks=require_gitleaks))

    if errors:
        print("repo-audit failed:")
        for error in errors:
            print(f"- {error}")
        return 1

    print("repo-audit passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
