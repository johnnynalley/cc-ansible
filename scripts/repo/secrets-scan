#!/usr/bin/env python3
"""Scan tracked repository content for likely plaintext secrets.

The built-in scanner is intentionally conservative and redacts values in output.
When Gitleaks is installed, this script can also run it as a professional
third-party scanner using the repo's `.gitleaks.toml` config.
"""

from __future__ import annotations

import argparse
import json
import math
import re
import shutil
import subprocess
import sys
from dataclasses import asdict, dataclass
from pathlib import Path


DEFAULT_ROOT = Path(__file__).resolve().parents[2]
ROOT = DEFAULT_ROOT
TEXT_SUFFIXES = {
    "",
    ".cfg",
    ".conf",
    ".env",
    ".ini",
    ".j2",
    ".json",
    ".md",
    ".ps1",
    ".py",
    ".service",
    ".sh",
    ".timer",
    ".toml",
    ".txt",
    ".yaml",
    ".yml",
}
SKIP_PATHS = {
    "CLAUDE.md",
    "scripts/repo/repo-audit",
    "scripts/repo/secrets-scan",
}
PLACEHOLDER_RE = re.compile(
    r"(?i)^(?:"
    r"api[_-]?key|token|secret|password|passwd|changeme|change-me|"
    r"example|placeholder|redacted|dummy|none|null|true|false|"
    r"your[-_a-z0-9]*|<[^>]+>|\$\{[^}]+\}|x{6,}|0{6,}"
    r")$"
)
SENSITIVE_NAME_RE = re.compile(
    r"(?i)(password|passwd|pwd|secret|token|api[_-]?key|client[_-]?secret|"
    r"private[_-]?key|access[_-]?key|webhook|auth)"
)
SAFE_NAME_RE = re.compile(
    r"(?i)(file|path|body|command|cmd|regex|pattern|content[_-]?type|nopasswd)$"
)
ENV_VAR_NAME_RE = re.compile(r"^[A-Z_][A-Z0-9_]*$")
GENERIC_ASSIGNMENT_RE = re.compile(
    r"(?i)\b([A-Za-z0-9_.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|"
    r"client[_-]?secret|private[_-]?key|access[_-]?key|webhook|auth)"
    r"[A-Za-z0-9_.-]*)\b\s*[:=]\s*['\"]?([^'\"\s#]+)['\"]?"
)
XML_SECRET_RE = re.compile(
    r"(?i)<([A-Za-z0-9_.-]*(?:password|secret|token|api[_-]?key)"
    r"[A-Za-z0-9_.-]*)>([^<]+)</\1>"
)
URL_CREDENTIAL_RE = re.compile(r"[a-z][a-z0-9+.-]*://[^/\s:@]+:([^@\s/]+)@")
HTTP_HEADER_SECRET_RE = re.compile(
    r"(?i)['\"]?(?:x-api-key|authorization)['\"]?\s*:\s*"
    r"['\"]?(?:bearer\s+)?([A-Za-z0-9+/=_-]{24,})"
)
KNOWN_SECRET_RULES = (
    ("private-key", re.compile(r"-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("github-token", re.compile(r"\bgh[pousr]_[A-Za-z0-9_]{36,255}\b")),
    ("slack-token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("google-api-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("stripe-key", re.compile(r"\b[rs]k_(?:live|test)_[0-9A-Za-z]{16,}\b")),
    ("discord-token", re.compile(r"\b[MN][A-Za-z0-9_-]{23}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27}\b")),
)


@dataclass(frozen=True)
class Finding:
    path: str
    line: int
    rule: str
    message: str
    value: str


def git_lines(args: list[str]) -> list[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return [line for line in result.stdout.splitlines() if line]


def tracked_paths() -> list[str]:
    return [
        path
        for path in git_lines(["ls-files"])
        if path not in SKIP_PATHS and (ROOT / path).exists()
    ]


def staged_paths() -> list[str]:
    return [
        path
        for path in git_lines(["diff", "--cached", "--name-only", "--diff-filter=ACMR"])
        if path not in SKIP_PATHS
    ]


def read_worktree_text(path: str) -> str | None:
    full_path = ROOT / path
    if full_path.suffix not in TEXT_SUFFIXES or not full_path.is_file():
        return None
    try:
        return full_path.read_text()
    except (OSError, UnicodeDecodeError):
        return None


def read_staged_text(path: str) -> str | None:
    if Path(path).suffix not in TEXT_SUFFIXES:
        return None
    result = subprocess.run(
        ["git", "show", f":{path}"],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def is_encrypted_vault(text: str) -> bool:
    first_line = text.splitlines()[:1]
    return bool(first_line and first_line[0].startswith("$ANSIBLE_VAULT;"))


def entropy(value: str) -> float:
    if not value:
        return 0.0
    counts = {char: value.count(char) for char in set(value)}
    return -sum((count / len(value)) * math.log2(count / len(value)) for count in counts.values())


def clean_value(value: str) -> str:
    return value.strip().strip("'\"")


def is_placeholder(value: str) -> bool:
    cleaned = clean_value(value)
    if not cleaned:
        return True
    lowered = cleaned.lower()
    return bool(PLACEHOLDER_RE.match(lowered)) or "example" in lowered or "placeholder" in lowered


def redact(value: str) -> str:
    cleaned = clean_value(value)
    if len(cleaned) <= 8:
        return "<redacted>"
    return f"{cleaned[:3]}...{cleaned[-3:]}"


def finding(path: str, line_no: int, rule: str, message: str, value: str) -> Finding:
    return Finding(path=path, line=line_no, rule=rule, message=message, value=redact(value))


def scan_text(path: str, text: str) -> list[Finding]:
    if is_encrypted_vault(text):
        return []

    findings: list[Finding] = []
    for line_no, line in enumerate(text.splitlines(), start=1):
        for rule_name, pattern in KNOWN_SECRET_RULES:
            match = pattern.search(line)
            if match:
                findings.append(finding(path, line_no, rule_name, "known secret pattern", match.group(0)))

        url_match = URL_CREDENTIAL_RE.search(line)
        if url_match and not is_placeholder(url_match.group(1)):
            findings.append(finding(path, line_no, "url-credentials", "credential embedded in URL", url_match.group(1)))

        for match in HTTP_HEADER_SECRET_RE.finditer(line):
            value = clean_value(match.group(1))
            if not is_placeholder(value) and entropy(value) >= 3.0:
                findings.append(
                    finding(
                        path,
                        line_no,
                        "http-header-secret",
                        "credential embedded in HTTP header",
                        value,
                    )
                )

        for match in XML_SECRET_RE.finditer(line):
            value = clean_value(match.group(2))
            if should_flag_sensitive_value(match.group(1), value):
                findings.append(finding(path, line_no, "xml-secret", f"sensitive XML field `{match.group(1)}`", value))

        for match in GENERIC_ASSIGNMENT_RE.finditer(line):
            name = match.group(1)
            value = clean_value(match.group(2))
            if should_flag_sensitive_value(name, value):
                findings.append(finding(path, line_no, "sensitive-assignment", f"sensitive field `{name}`", value))

    return findings


def should_flag_sensitive_value(name: str, value: str) -> bool:
    if not SENSITIVE_NAME_RE.search(name) or is_placeholder(value):
        return False
    lowered_name = name.lower()
    if lowered_name.endswith(("_variable", "_var", "_env_var", "_env_variable")) and ENV_VAR_NAME_RE.match(
        value
    ):
        return False
    if SAFE_NAME_RE.search(lowered_name) or any(
        safe_part in lowered_name
        for safe_part in ("_file", "_path", "_body", "content_type")
    ):
        return False
    if "nopasswd" in lowered_name:
        return False
    if value.startswith(("{{", "{%", "$", "lookup(", "env.", "vault_", "read_")):
        return False
    if any(char in value for char in ("/", "\\", "~", "(", ")", "[", "]")):
        return False
    if value in {"|", ">", ">-", "|-", "!!str"}:
        return False
    if len(value) < 12:
        return False
    return len(value) >= 20 or entropy(value) >= 3.5


def run_self_test() -> int:
    cases = [
        (
            "environment variable indirection is safe",
            "cloudflare_ddns_token_variable: CLOUDFLARE_DDNS_API_TOKEN\n",
            [],
        ),
        (
            "normal sensitive assignment still fails",
            "cloudflare_ddns_api_token: CLOUDFLARE_DDNS_API_TOKEN\n",
            ["sensitive-assignment"],
        ),
        (
            "vault interpolation remains safe",
            "cloudflare_ddns_api_token: >-\n  {{ vault_cloudflare_ddns_mercury_relay_api_token | default('') }}\n",
            [],
        ),
        (
            "literal HTTP API key fails",
            'headers = {"X-Api-Key": "YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXo="}\n',
            ["http-header-secret"],
        ),
        (
            "HTTP API key variable remains safe",
            'headers = {"X-Api-Key": seerr_api_key}\n',
            [],
        ),
        (
            "HTTP API key placeholder remains safe",
            'curl -H "X-Api-Key: <seerr_key>"\n',
            [],
        ),
    ]

    failures: list[str] = []
    for name, text, expected_rules in cases:
        actual_rules = [item.rule for item in scan_text(f"self-test/{name}.yml", text)]
        if actual_rules != expected_rules:
            failures.append(f"{name}: expected {expected_rules}, got {actual_rules}")

    if failures:
        print("secrets-scan self-test failed:")
        for failure in failures:
            print(f"- {failure}")
        return 1

    print("secrets-scan self-test passed")
    return 0


def built_in_scan(paths: list[str], staged: bool) -> list[Finding]:
    findings: list[Finding] = []
    reader = read_staged_text if staged else read_worktree_text
    for path in paths:
        text = reader(path)
        if text is not None:
            findings.extend(scan_text(path, text))
    return findings


def run_gitleaks(staged: bool, history: bool) -> tuple[int, str]:
    gitleaks = shutil.which("gitleaks")
    if not gitleaks:
        return 127, "gitleaks is not installed"

    config = ROOT / ".gitleaks.toml"
    common = [gitleaks, "--no-banner", "--redact", "--exit-code", "1"]
    if config.exists():
        common.extend(["--config", str(config)])

    if history:
        command = [*common, "git", str(ROOT)]
    elif staged:
        command = [*common, "protect", "--staged"]
    else:
        command = [*common, "dir", str(ROOT)]

    result = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    return result.returncode, result.stdout.strip()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--staged", action="store_true", help="scan staged content instead of the worktree")
    parser.add_argument("--history", action="store_true", help="run Gitleaks against git history when available")
    parser.add_argument("--external", choices=("auto", "off", "gitleaks"), default="auto")
    parser.add_argument("--require-external", action="store_true", help="fail if the requested external scanner is unavailable")
    parser.add_argument("--json", action="store_true", help="emit JSON output")
    parser.add_argument("--quiet", action="store_true", help="only print failures")
    parser.add_argument("--self-test", action="store_true", help="run built-in scanner regression checks")
    parser.add_argument(
        "--root",
        type=Path,
        default=DEFAULT_ROOT,
        help="Git worktree to scan (default: this repository)",
    )
    return parser.parse_args()


def main() -> int:
    global ROOT
    args = parse_args()
    ROOT = args.root.expanduser().resolve()
    if not (ROOT / ".git").exists():
        print(f"secrets-scan: not a Git worktree: {ROOT}", file=sys.stderr)
        return 2
    if args.self_test:
        return run_self_test()

    paths = staged_paths() if args.staged else tracked_paths()
    findings = built_in_scan(paths, staged=args.staged)
    external_status: dict[str, str | int] = {"scanner": "gitleaks", "status": "skipped"}
    external_failed = False

    if args.external != "off" or args.history:
        code, output = run_gitleaks(staged=args.staged, history=args.history)
        if code == 127:
            external_status = {"scanner": "gitleaks", "status": "missing", "message": output}
            if args.require_external or args.external == "gitleaks" or args.history:
                external_failed = True
        elif code == 0:
            external_status = {"scanner": "gitleaks", "status": "passed"}
        elif code == 1:
            external_status = {"scanner": "gitleaks", "status": "failed", "message": output}
            external_failed = True
        else:
            external_status = {"scanner": "gitleaks", "status": "error", "exit_code": code, "message": output}
            external_failed = True

    failed = bool(findings) or external_failed
    if args.json:
        print(json.dumps({"findings": [asdict(item) for item in findings], "external": external_status}, indent=2))
    elif failed:
        print("secrets-scan failed:")
        for item in findings:
            print(f"- {item.path}:{item.line}: {item.rule}: {item.message}: {item.value}")
        if external_failed:
            print(f"- gitleaks: {external_status.get('status')}: {external_status.get('message', '')}")
    elif not args.quiet:
        message = "secrets-scan passed"
        if external_status["status"] == "missing":
            message += " (built-in scan only; gitleaks not installed)"
        elif external_status["status"] == "passed":
            message += " (built-in + gitleaks)"
        print(message)

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
