services:
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./sonarr:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
    ports:
      - 8989:8989
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./radarr:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
    ports:
      - 7878:7878
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./prowlarr:/config
    ports:
      - 9696:9696
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./bazarr:/config
      - /srv/media/plex:/data:ro
      - /srv/archive:/archive
    ports:
      - 6767:6767
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./sabnzbd:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
      - /srv/incomplete_downloads/usenet:/incomplete
    ports:
      - 8080:8080
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  recyclarr:
    image: ghcr.io/recyclarr/recyclarr:latest
    container_name: recyclarr
    user: "1000:1000"
    environment:
      - TZ=America/Chicago
    volumes:
      - ./recyclarr:/config
    networks:
      - default
    restart: unless-stopped

  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ vault_gluetun_wireguard_private_key }}
      - WIREGUARD_MTU=1420
      - SERVER_COUNTRIES=Netherlands
      - VPN_PORT_FORWARDING=on
      - VPN_PORT_FORWARDING_PROVIDER=protonvpn
      - VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'echo {% raw %}{{PORTS}}{% endraw %} > /gluetun/forwarded_port'
    ports:
      - 8085:8085
    volumes:
      - ./gluetun:/gluetun
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: "service:gluetun"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
      - WEBUI_PORT=8085
    volumes:
      - ./qbittorrent:/config
      - /srv/incomplete_downloads/torrents:/incomplete
      - /srv/media/plex:/data
      - /srv/archive:/archive
    depends_on:
      - gluetun
    restart: unless-stopped

  byparr:
    image: ghcr.io/thephaseless/byparr:latest
    container_name: byparr
    init: true
    ports:
      - 8191:8191
    environment:
      - TZ=America/Chicago
    networks:
      - default
      - caddy-proxy
    restart: unless-stopped

networks:
  default:
  caddy-proxy:
    external: true
