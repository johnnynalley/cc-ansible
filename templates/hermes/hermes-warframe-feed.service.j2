[Unit]
Description=Collect verified Warframe stream events for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-astra
Group=hermes-astra
SupplementaryGroups={{ hermes_automation_readers_group }}
WorkingDirectory={{ hermes_automation_output_root }}
Environment=HOME=/var/lib/hermes/astra
ExecStart=/usr/bin/python3 {{ hermes_warframe_feed_live }} --parser-root {{ hermes_warframe_parser_live | dirname }} --output {{ hermes_automation_output_root }}/warframe-events.json --state {{ hermes_automation_output_root }}/warframe-state.json
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths={{ hermes_astra_calendar_live_root }}
ReadWritePaths=/var/lib/hermes/astra/.local/share/khal
ReadWritePaths={{ hermes_automation_output_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=10m
