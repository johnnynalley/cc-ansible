[Unit]
Description=Run the validated retained Fortnite calendar transaction
After=network-online.target hermes-fortnite-calendar-fetch.service
Wants=network-online.target
Requires=hermes-fortnite-calendar-fetch.service

[Service]
Type=oneshot
User=hermes-astra
Group=hermes-astra
SupplementaryGroups={{ hermes_automation_readers_group }}
WorkingDirectory={{ hermes_automation_output_root }}
Environment=HOME=/var/lib/hermes/astra
ExecStart=/usr/bin/python3 {{ hermes_fortnite_calendar_compat_live }} --script {{ hermes_fortnite_calendar_sync_live }} --schedule-file {{ hermes_fortnite_calendar_schedule_live }} --data-root {{ hermes_profile_data_root }}/astra/writable/data/fortnite-progress --scratch-root {{ hermes_automation_output_root }} --env-file /etc/hermes/astra/.env --calendar-root {{ hermes_astra_calendar_live_root }}/calendars/fortnite-tournaments
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/etc/hermes/astra/.env
ReadWritePaths={{ hermes_automation_output_root }}
ReadWritePaths={{ hermes_profile_data_root }}/astra/writable/data/fortnite-progress
ReadWritePaths={{ hermes_astra_calendar_live_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=20m
