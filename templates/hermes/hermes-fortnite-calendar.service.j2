[Unit]
Description=Run the validated retained Fortnite calendar transaction
After=network-online.target hermes-fortnite-calendar-fetch.service
Wants=network-online.target
Requires=hermes-fortnite-calendar-fetch.service

[Service]
Type=oneshot
User={{ hermes_production_cutover_user }}
Group={{ hermes_production_cutover_user }}
WorkingDirectory={{ hermes_automation_output_root }}
Environment=HOME=/home/{{ hermes_production_cutover_user }}
ExecStart=/usr/bin/python3 {{ hermes_fortnite_calendar_compat_live }} --script {{ hermes_automation_legacy_workspace }}/scripts/fortnite-tournament-calendar-sync.py --schedule-file {{ hermes_fortnite_calendar_schedule_live }}
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths={{ hermes_automation_legacy_workspace }}/scripts
BindReadOnlyPaths={{ hermes_production_cutover_source_env }}
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.config/khal
BindPaths=-/home/{{ hermes_production_cutover_user }}/.local/share/vdirsyncer/calendars
BindPaths={{ hermes_automation_legacy_workspace }}/fortnite-progress/tournaments
ReadWritePaths={{ hermes_automation_output_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=20m
