[Unit]
Description=Populate Astra LCM {{ hermes_lcm_backfill_lane.corpus }} embeddings locally
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service
ConditionPathExists={{ hermes_lcm_target_database }}
ConditionPathExists={{ hermes_lcm_backfill_profile.home }}/lcm.env

[Service]
Type=oneshot
User={{ hermes_lcm_backfill_profile.user }}
Group={{ hermes_lcm_backfill_profile.group }}
Environment=HOME={{ hermes_lcm_backfill_profile.account_home }}
Environment=HERMES_HOME={{ hermes_lcm_backfill_profile.home }}
EnvironmentFile={{ hermes_lcm_backfill_profile.home }}/lcm.env
Environment=LCM_DATABASE_PATH={{ hermes_lcm_target_database }}
ExecStartPre={{ hermes_shadow_runtime_venv }}/bin/python {{ hermes_lcm_native_maintenance_live }} backfill-bounded --corpus {{ hermes_lcm_backfill_lane.corpus }} --limit {{ hermes_lcm_backfill_uncertain_retry_batch }} --max-passes {{ hermes_lcm_backfill_uncertain_retry_max_passes }} --apply --retry-uncertain --approved --confirmation {{ hermes_lcm_native_maintenance_confirmation }}
ExecStart={{ hermes_shadow_runtime_venv }}/bin/python {{ hermes_lcm_native_maintenance_live }} backfill-bounded --corpus {{ hermes_lcm_backfill_lane.corpus }} --limit {{ hermes_lcm_backfill_batch }} --max-passes {{ hermes_lcm_backfill_passes_per_run }} --apply --approved --confirmation {{ hermes_lcm_native_maintenance_confirmation }}
TimeoutStartSec={{ hermes_lcm_backfill_timeout_start_sec }}
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ hermes_lcm_backfill_profile.home }}
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
