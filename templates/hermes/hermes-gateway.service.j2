[Unit]
Description=Hermes shadow gateway ({{ hermes_profile.name }})
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hermes/{{ hermes_profile.name }}/.shadow-ready

[Service]
Type=notify
NotifyAccess=main
User={{ hermes_profile.user }}
Group={{ hermes_profile.group }}
WorkingDirectory={{ hermes_profile.home }}
Environment=HOME={{ hermes_profile.home }}
Environment=HERMES_HOME={{ hermes_profile.home }}
Environment=HERMES_MANAGED_DIR=/etc/hermes/{{ hermes_profile.name }}
Environment=HERMES_DOCKER_BINARY=/usr/bin/podman
Environment=XDG_RUNTIME_DIR=/run/hermes-{{ hermes_profile.name }}
EnvironmentFile=/etc/hermes/{{ hermes_profile.name }}/.env
ExecStartPre={{ hermes_shadow_audit_live }} {{ hermes_shadow_contract_live }}
ExecStartPre={{ hermes_discord_audit_live }} {{ hermes_discord_contract_live }} --repository-root /usr/local/share/hermes-shadow/repository
ExecStartPre={{ hermes_automation_audit_live }} {{ hermes_automation_contract_live }} --repository-root /usr/local/share/hermes-shadow/repository
ExecStartPre=/usr/bin/sha256sum --check --status --strict /etc/hermes/{{ hermes_profile.name }}/managed-policy.sha256
ExecStartPre={{ hermes_shadow_runtime_binary }} config check
ExecStartPre=/usr/local/lib/hermes-agent/venv/bin/python {{ hermes_profile_skills_validator_live }} --contract {{ hermes_profile_skills_contract_live }} --mode runtime --profile {{ hermes_profile.name }} --hermes-source /usr/local/lib/hermes-agent
ExecStart={{ hermes_shadow_runtime_binary }} gateway run --external-supervisor
Restart=on-failure
RestartSec=10s
TimeoutStopSec=90s
WatchdogSec=120s
RuntimeDirectory=hermes-{{ hermes_profile.name }}
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/etc/hermes/{{ hermes_profile.name }}/skills:{{ hermes_profile.home }}/skills/managed
ReadWritePaths={{ hermes_profile.home }} /run/hermes-{{ hermes_profile.name }}
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/random r
DeviceAllow=/dev/fuse rw
Delegate=yes
TasksMax=1024
KillMode=mixed

[Install]
WantedBy=multi-user.target
