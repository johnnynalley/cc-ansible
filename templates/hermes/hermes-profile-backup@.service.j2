[Unit]
Description=Create native Hermes backup for profile %i
ConditionPathIsDirectory=/var/lib/hermes/%i/.hermes/profiles/%i

[Service]
Type=oneshot
User=hermes-%i
Group=hermes-%i
WorkingDirectory=/var/lib/hermes/%i/.hermes/profiles/%i
Environment=HOME=/var/lib/hermes/%i
Environment=HERMES_HOME=/var/lib/hermes/%i/.hermes/profiles/%i
ExecStart={{ hermes_shadow_runtime_binary }} backup --output /var/lib/hermes/%i/.hermes/profiles/%i/backups/nightly.zip
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes/%i/.hermes/profiles/%i
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=20m
