[Unit]
Description=Fetch the public Fortnite schedule for the Hermes calendar job
After=network-online.target snapd.seeded.service
Wants=network-online.target
Requires=snapd.seeded.service

[Service]
Type=oneshot
User=hermes-astra
Group=hermes-astra
WorkingDirectory={{ hermes_automation_output_root }}
ExecStart=/usr/bin/python3 {{ hermes_fortnite_calendar_fetch_live }} --output {{ hermes_fortnite_calendar_schedule_live }} --geckodriver {{ hermes_fortnite_geckodriver_path }} --firefox-binary {{ hermes_fortnite_firefox_binary_path }}
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=
Environment=HOME=/run/hermes-fortnite-calendar-fetch
UMask=0027
RuntimeDirectory=hermes-fortnite-calendar-fetch
RuntimeDirectoryMode=0700
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ hermes_automation_output_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=5m
