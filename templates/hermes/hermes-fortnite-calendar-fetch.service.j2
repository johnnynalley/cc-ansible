[Unit]
Description=Fetch the public Fortnite schedule for the Hermes calendar job
After=network-online.target snapd.seeded.service
Wants=network-online.target
Requires=snapd.seeded.service

[Service]
Type=oneshot
User={{ hermes_production_cutover_user }}
Group={{ hermes_production_cutover_user }}
SupplementaryGroups={{ hermes_automation_readers_group }}
WorkingDirectory={{ hermes_automation_output_root }}
ExecStart=/usr/bin/python3 {{ hermes_fortnite_calendar_fetch_live }} --output {{ hermes_fortnite_calendar_schedule_live }}
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=
Environment=HOME=/home/{{ hermes_production_cutover_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ hermes_production_cutover_user_uid }}
UMask=0027
# Snap's root-owned confinement helper requires its packaged file capabilities.
# This public-only fetcher contains no credentials and executes no writable code.
NoNewPrivileges=false
RestrictSUIDSGID=false
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=-/home/{{ hermes_production_cutover_user }}/snap/firefox
BindPaths=-/home/{{ hermes_production_cutover_user }}/.cache
ReadWritePaths={{ hermes_automation_output_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_CHROOT CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_SYS_RESOURCE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=5m
