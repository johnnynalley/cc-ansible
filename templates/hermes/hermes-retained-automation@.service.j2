[Unit]
Description=Hermes retained automation collector (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ hermes_production_cutover_user }}
Group={{ hermes_production_cutover_user }}
SupplementaryGroups={{ hermes_automation_readers_group }}
WorkingDirectory={{ hermes_automation_legacy_workspace }}
ExecStart=/usr/bin/python3 {{ hermes_retained_automation_live }} %i --workspace {{ hermes_automation_legacy_workspace }} --output-root {{ hermes_automation_output_root }}
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths={{ hermes_automation_legacy_workspace }}/scripts
BindReadOnlyPaths=-{{ hermes_automation_legacy_workspace }}/MEMORY.md
BindReadOnlyPaths=-{{ hermes_automation_legacy_workspace }}/memory/warframe-drops-state.json
BindReadOnlyPaths={{ hermes_production_cutover_source_env }}
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.openclaw/.env.d
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.config/himalaya
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.config/vdirsyncer
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.config/khal
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.local/bin/himalaya
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.local/share/vdirsyncer/calendars
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.ssh/known_hosts
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/.ssh/id_ed25519
BindReadOnlyPaths=-{{ hermes_automation_legacy_workspace }}/data/health.db
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/cc-ansible
BindPaths={{ hermes_automation_legacy_workspace }}/memory/daily-summary-sections
BindPaths={{ hermes_automation_legacy_workspace }}/fortnite-progress
ReadOnlyPaths=-/opt/seerr/config/settings.json
ReadWritePaths={{ hermes_automation_output_root }}
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=20m
