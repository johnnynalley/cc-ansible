[Unit]
Description=Hermes retained automation collector (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-astra
Group=hermes-astra
SupplementaryGroups={{ hermes_automation_readers_group }}
WorkingDirectory={{ hermes_automation_native_workspace }}
ExecStart=/usr/bin/python3 {{ hermes_retained_automation_live }} %i --workspace {{ hermes_automation_native_workspace }} --output-root {{ hermes_automation_output_root }} --freshrss-root {{ hermes_astra_freshrss_live_root }}
Environment=HOME=/var/lib/hermes/astra
Environment=HERMES_HOME={{ hermes_native_update_profile_home }}
Environment=HERMES_MANAGED_DIR=/etc/hermes/astra
Environment=HERMES_AUTOMATION_WORKSPACE={{ hermes_automation_native_workspace }}
Environment=HERMES_CALENDAR_ROOT={{ hermes_astra_calendar_live_root }}/calendars
Environment=HERMES_OPS_REPOSITORY={{ hermes_astra_workspace_live }}
Environment=HERMES_HEALTH_DB={{ hermes_profile_data_root }}/astra/writable/data/health.db
Environment=HERMES_HEALTH_SUMMARY={{ hermes_health_summary_live }}
Environment=HERMES_FORTNITE_NORMALIZER={{ hermes_fortnite_normalize_live }}
EnvironmentFile={{ hermes_retained_collector_environment_live }}
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=-/home/{{ hermes_production_cutover_user }}/cc-ansible
BindPaths={{ hermes_automation_output_root }}/daily-summary-sections:{{ hermes_automation_native_workspace }}/memory/daily-summary-sections
BindPaths={{ hermes_profile_data_root }}/astra/writable/data/fortnite-progress:{{ hermes_automation_native_workspace }}/fortnite-progress
ReadOnlyPaths=-/opt/seerr/config/settings.json
ReadWritePaths={{ hermes_automation_output_root }}
ReadWritePaths={{ hermes_astra_freshrss_live_root }}
ReadWritePaths={{ hermes_profile_data_root }}/astra/writable/data/fortnite-progress
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=20m
