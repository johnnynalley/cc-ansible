[Unit]
Description=Complete redacted OpenClaw evidence projection for Hermes Astra
Documentation=file:{{ hermes_openclaw_evidence_contract_live }}
After=local-fs.target
Before=hermes-gateway-astra.service
RequiresMountsFor={{ hermes_openclaw_evidence_contract.sourceRoot }} {{ hermes_openclaw_evidence_contract.runtime.stateRoot }}
ConditionPathIsDirectory={{ hermes_openclaw_evidence_contract.sourceRoot }}

[Service]
Type=simple
ExecStartPre=-/usr/bin/fusermount3 -u {{ hermes_openclaw_evidence_contract.runtime.viewRoot }}
ExecStartPre=-/usr/bin/umount {{ hermes_openclaw_evidence_contract.runtime.mergedRoot }}
ExecStartPre=+{{ hermes_openclaw_evidence_script_live }} prepare --contract {{ hermes_openclaw_evidence_contract_live }}
ExecStartPre=+/usr/bin/mount -t overlay overlay -o lowerdir={{ hermes_openclaw_evidence_contract.sourceRoot }},upperdir={{ hermes_openclaw_evidence_contract.runtime.upperRoot }},workdir={{ hermes_openclaw_evidence_contract.runtime.workRoot }} {{ hermes_openclaw_evidence_contract.runtime.mergedRoot }}
ExecStart=/usr/bin/bindfs -f -r --force-user={{ hermes_openclaw_evidence_contract.runtime.profileUser }} --force-group={{ hermes_openclaw_evidence_contract.runtime.profileGroup }} --perms=0000:u=rD --mirror-only={{ hermes_openclaw_evidence_contract.runtime.profileUser }} {{ hermes_openclaw_evidence_contract.runtime.mergedRoot }} {{ hermes_openclaw_evidence_contract.runtime.viewRoot }}
ExecStartPost=/usr/bin/mountpoint --quiet {{ hermes_openclaw_evidence_contract.runtime.mergedRoot }}
ExecStartPost=/usr/bin/mountpoint --quiet {{ hermes_openclaw_evidence_contract.runtime.viewRoot }}
ExecStop=/usr/bin/fusermount3 -u {{ hermes_openclaw_evidence_contract.runtime.viewRoot }}
ExecStopPost=-/usr/bin/umount {{ hermes_openclaw_evidence_contract.runtime.mergedRoot }}
Restart=on-failure
RestartSec=15s
TimeoutStartSec=15min
TimeoutStopSec=2min
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
