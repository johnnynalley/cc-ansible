[Unit]
Description=Hermes native self-update
Documentation=https://hermes-agent.nousresearch.com/docs/getting-started/updating/
After=network-online.target {{ hermes_tirith_update_service }}
Wants=network-online.target {{ hermes_tirith_update_service }}
ConditionPathIsDirectory={{ hermes_shadow_runtime_root }}/.git

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStartPre=/usr/bin/python3 {{ hermes_native_update_transaction_live }} --config {{ hermes_native_update_transaction_config }} --validate-runtime
ExecStart=/usr/bin/python3 {{ hermes_native_update_transaction_live }} --config {{ hermes_native_update_transaction_config }}
StandardOutput=append:{{ hermes_native_update_home }}/.update_output.txt
StandardError=append:{{ hermes_native_update_home }}/.update_output.txt
UMask=0022
# The fixed root-owned transaction prepares Hermes planned-stop markers, drops
# to hermes-astra for the unmodified native updater and dependency work, then
# restores only the Gateway units that were active before the transaction.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ ([hermes_shadow_runtime_root, hermes_native_update_rollback_root] + (hermes_production_consumer_profiles | map(attribute='account_home') | list) + (hermes_production_consumer_profiles | map(attribute='home') | list)) | join(' ') }}
ReadOnlyPaths={{ hermes_native_update_transaction_config }} {{ hermes_shadow_uv_binary }} {{ hermes_shadow_uv_python_root }} {{ hermes_native_update_profile_home }}/.no-bundled-skills {{ hermes_native_update_profile_home }}/AGENTS.md {{ hermes_native_update_profile_home }}/SOUL.md {{ hermes_native_update_profile_home }}/imported-data {{ hermes_native_update_profile_home }}/managed-data {{ hermes_native_update_profile_home }}/plugins {{ hermes_native_update_profile_home }}/scripts {{ hermes_native_update_profile_home }}/skills/managed {{ hermes_native_update_profile_home }}/transformed-data {{ hermes_native_update_profile_home }}/transformed-managed
InaccessiblePaths=/etc/hermes/astra /etc/hermes/dubble /etc/hermes/rigel
RuntimeDirectory=hermes-native-update
RuntimeDirectoryMode=0700
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
# The transaction starts as root only to manage fixed Gateway units. PID 1
# launches every source, dependency, and post-setup command as its fixed
# zero-capability service identity in a separate transient sandbox.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=1h
