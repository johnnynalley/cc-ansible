[Unit]
Description=Hermes native self-update
Documentation=https://hermes-agent.nousresearch.com/docs/getting-started/updating/
After=network-online.target {{ hermes_tirith_update_service }}
Wants=network-online.target {{ hermes_tirith_update_service }}
ConditionPathIsDirectory={{ hermes_shadow_runtime_root }}/.git

[Service]
Type=oneshot
User={{ hermes_native_update_user }}
Group={{ hermes_runtime_readers_group }}
SupplementaryGroups={{ hermes_native_update_group }}
WorkingDirectory={{ hermes_shadow_runtime_root }}
Environment=HOME={{ hermes_native_update_home }}
Environment=HERMES_HOME={{ hermes_native_update_profile_home }}
Environment=PATH={{ hermes_native_update_profile_home }}/bin:{{ hermes_shadow_uv_bin_dir }}:{{ hermes_shadow_runtime_venv }}/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=UV_LINK_MODE=copy
ExecStart={{ hermes_shadow_runtime_venv }}/bin/python {{ hermes_shadow_runtime_root }}/hermes update --gateway --yes
ExecStartPost={{ hermes_shadow_uv_binary }} pip install --strict --python {{ hermes_shadow_runtime_venv }}/bin/python -e {{ hermes_shadow_runtime_root }}[messaging,mem0]
ExecStartPost={{ hermes_shadow_uv_binary }} pip install --strict --no-deps --python {{ hermes_shadow_runtime_venv }}/bin/python {{ hermes_mem0_gemini_dependency }}
ExecStartPost={{ hermes_shadow_uv_binary }} pip check --python {{ hermes_shadow_runtime_venv }}/bin/python
ExecStartPost=/usr/bin/chgrp -R --no-dereference {{ hermes_runtime_readers_group }} {{ hermes_shadow_runtime_root }}
{% for post_setup_key in hermes_native_post_setup_keys %}
ExecStartPost={{ hermes_shadow_runtime_binary }} tools post-setup {{ post_setup_key }}
{% endfor %}
StandardOutput=append:{{ hermes_native_update_home }}/.update_output.txt
StandardError=append:{{ hermes_native_update_home }}/.update_output.txt
UMask=0022
# Native `hermes update --gateway` uses the exact unit-only sudoers bridge to
# drain and restart every active Hermes Gateway after updating.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ hermes_shadow_runtime_root }} {{ hermes_native_update_home }} {{ hermes_native_update_profile_home }}
ReadOnlyPaths={{ hermes_native_update_profile_home }}/.no-bundled-skills {{ hermes_native_update_profile_home }}/AGENTS.md {{ hermes_native_update_profile_home }}/SOUL.md {{ hermes_native_update_profile_home }}/imported-data {{ hermes_native_update_profile_home }}/managed-data {{ hermes_native_update_profile_home }}/plugins {{ hermes_native_update_profile_home }}/scripts {{ hermes_native_update_profile_home }}/skills/managed {{ hermes_native_update_profile_home }}/transformed-data {{ hermes_native_update_profile_home }}/transformed-managed
InaccessiblePaths=/etc/hermes/astra
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
# The native `--gateway` restart path requires sudo to restore root UID/GID.
# Keep only those identity-switch capabilities available to the setuid child;
# the service receives no ambient capabilities and sudoers constrains the
# resulting authority to exact reviewed Gateway unit operations.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=1h
