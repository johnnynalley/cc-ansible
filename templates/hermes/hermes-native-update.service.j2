[Unit]
Description=Hermes native self-update
Documentation=https://hermes-agent.nousresearch.com/docs/getting-started/updating/
After=network-online.target {{ hermes_tirith_update_service }}
Wants=network-online.target {{ hermes_tirith_update_service }}
ConditionPathIsDirectory={{ hermes_shadow_runtime_root }}/.git

[Service]
Type=oneshot
User={{ hermes_native_update_user }}
Group={{ hermes_native_update_group }}
WorkingDirectory={{ hermes_shadow_runtime_root }}
Environment=HOME={{ hermes_native_update_home }}
Environment=HERMES_HOME={{ hermes_native_update_home }}
Environment=PATH={{ hermes_native_update_home }}/bin:{{ hermes_shadow_uv_bin_dir }}:{{ hermes_shadow_runtime_venv }}/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=UV_LINK_MODE=copy
ExecStart={{ hermes_shadow_runtime_venv }}/bin/python {{ hermes_shadow_runtime_root }}/hermes update --gateway --yes
{% for post_setup_key in hermes_native_post_setup_keys %}
ExecStartPost={{ hermes_shadow_runtime_binary }} tools post-setup {{ post_setup_key }}
{% endfor %}
StandardOutput=append:{{ hermes_native_update_home }}/.update_output.txt
StandardError=append:{{ hermes_native_update_home }}/.update_output.txt
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ hermes_shadow_runtime_root }} {{ hermes_native_update_home }}
ReadOnlyPaths={{ hermes_native_update_home }}/.no-bundled-skills {{ hermes_native_update_home }}/AGENTS.md {{ hermes_native_update_home }}/SOUL.md {{ hermes_native_update_home }}/imported-data {{ hermes_native_update_home }}/managed-data {{ hermes_native_update_home }}/plugins {{ hermes_native_update_home }}/scripts {{ hermes_native_update_home }}/skills/managed {{ hermes_native_update_home }}/transformed-data {{ hermes_native_update_home }}/transformed-managed
InaccessiblePaths=/etc/hermes/astra
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStartSec=1h
