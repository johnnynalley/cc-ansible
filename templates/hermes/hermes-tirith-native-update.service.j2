[Unit]
Description=Tirith native signed self-update
Documentation=https://github.com/sheeki03/tirith#self-update
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable={{ hermes_tirith_binary }}

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory={{ hermes_tirith_update_home }}
Environment=HOME={{ hermes_tirith_update_home }}
Environment=PATH={{ hermes_tirith_update_home }}/.local/bin:/usr/bin:/bin
ExecStart={{ hermes_tirith_binary }} update --yes --format json
StandardOutput=append:/var/lib/hermes/astra/.update_output.txt
StandardError=append:/var/lib/hermes/astra/.update_output.txt
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Tirith 0.4+ publishes its scanner and root-owned package-approval helper as
# one signed transaction. Keep root confined to Tirith state and libexec.
ReadWritePaths={{ hermes_tirith_update_home }} /usr/local/libexec
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=10m
