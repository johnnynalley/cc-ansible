{
  "mode": "oss",
  "user_id": "{{ hermes_mem0_user_id }}",
  "agent_id": "{{ hermes_mem0_agent_id }}",
  "rerank": false,
  "oss": {
    "llm": {
      "provider": "ollama",
      "config": {
        "model": "{{ hermes_mem0_ollama_llm_model }}",
        "ollama_base_url": "{{ hermes_mem0_ollama_url }}",
        "temperature": 0.0,
        "max_tokens": 2000,
        "top_p": 0.1,
        "top_k": 1
      }
    },
    "embedder": {
      "provider": "ollama",
      "config": {
        "model": "{{ hermes_mem0_ollama_embedding_model }}",
        "ollama_base_url": "{{ hermes_mem0_ollama_url }}",
        "embedding_dims": {{ hermes_mem0_ollama_embedding_dimensions }}
      }
    },
    "vector_store": {
      "provider": "qdrant",
      "config": {
        "url": "http://127.0.0.1:6333",
        "collection_name": "{{ hermes_mem0_render_collection }}",
        "embedding_model_dims": {{ hermes_mem0_ollama_embedding_dimensions }}
      }
    }
  }
}
