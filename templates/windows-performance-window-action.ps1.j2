# Ansible managed
[CmdletBinding()]
param(
    [Parameter(Mandatory=$true)]
    [ValidateSet("close", "minimize")]
    [string]$Action,

    [Parameter(Mandatory=$true)]
    [string]$DisplayName,

    [Parameter(Mandatory=$true)]
    [string[]]$ProcessNames,

    [int]$DelaySeconds = 2,
    [int]$TimeoutSeconds = 60,

    [Parameter(Mandatory=$true)]
    [string]$LogPath,

    [string[]]$WindowProcessNames = @(),

    [string[]]$TitlePatterns = @()
)

$ErrorActionPreference = "Stop"

$WindowToolsSource = @"
using System;
using System.Runtime.InteropServices;

public static class WindowTools {
    public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);

    [DllImport("user32.dll")]
    public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc, IntPtr lParam);

    [DllImport("user32.dll")]
    public static extern bool IsWindowVisible(IntPtr hWnd);

    [DllImport("user32.dll", CharSet = CharSet.Unicode)]
    public static extern int GetWindowText(IntPtr hWnd, System.Text.StringBuilder text, int count);

    [DllImport("user32.dll")]
    public static extern UInt32 GetWindowThreadProcessId(IntPtr hWnd, out UInt32 processId);

    [DllImport("user32.dll")]
    public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);

    [DllImport("user32.dll")]
    public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);

    [DllImport("user32.dll")]
    public static extern bool PostMessage(IntPtr hWnd, UInt32 Msg, IntPtr wParam, IntPtr lParam);
}
"@

try {
    Add-Type -TypeDefinition $WindowToolsSource -ErrorAction Stop
} catch {
    if (-not ("WindowTools" -as [type])) {
        throw
    }
}

function Write-WindowActionLog {
    param([string]$Message)
    Add-Content -Path $LogPath -Value "$(Get-Date -Format s) $Message"
}

function Get-VisibleTopLevelWindows {
    $windows = New-Object System.Collections.ArrayList
    $callback = [WindowTools+EnumWindowsProc]{
        param([IntPtr]$Handle, [IntPtr]$Param)

        if ([WindowTools]::IsWindowVisible($Handle)) {
            $titleBuilder = New-Object System.Text.StringBuilder 512
            [void][WindowTools]::GetWindowText($Handle, $titleBuilder, $titleBuilder.Capacity)
            $title = $titleBuilder.ToString()
            if ($title) {
                [uint32]$processId = 0
                [void][WindowTools]::GetWindowThreadProcessId($Handle, [ref]$processId)
                $process = Get-Process -Id $processId -ErrorAction SilentlyContinue
                if ($process) {
                    [void]$windows.Add([pscustomobject]@{
                        ProcessName = $process.ProcessName
                        Id = $process.Id
                        MainWindowHandle = $Handle
                        MainWindowTitle = $title
                    })
                }
            }
        }

        return $true
    }

    [void][WindowTools]::EnumWindows($callback, [IntPtr]::Zero)
    return @($windows.ToArray())
}

function Test-TitlePattern {
    param([string]$Title)

    if (-not $TitlePatterns -or @($TitlePatterns).Count -eq 0) {
        return $true
    }

    foreach ($pattern in @($TitlePatterns)) {
        if ($Title -match [string]$pattern) {
            return $true
        }
    }

    return $false
}

function Find-TargetWindows {
    $processNameSet = @{}
    foreach ($name in @($ProcessNames + $WindowProcessNames)) {
        if ($name) {
            $processNameSet[[string]$name] = $true
        }
    }

    $allowedProcessNames = @($processNameSet.Keys)
    $windows = @(
        Get-VisibleTopLevelWindows |
            Where-Object {
                ($allowedProcessNames.Count -eq 0 -or ($allowedProcessNames -contains $_.ProcessName)) -and
                (Test-TitlePattern -Title $_.MainWindowTitle)
            }
    )

    if ($windows.Count -eq 0) {
        foreach ($name in @($processNameSet.Keys)) {
            $windows += @(
                Get-Process -Name $name -ErrorAction SilentlyContinue |
                    Where-Object {
                        $_.MainWindowHandle -ne 0 -and
                        (Test-TitlePattern -Title $_.MainWindowTitle)
                    } |
                    ForEach-Object {
                        [pscustomobject]@{
                            ProcessName = $_.ProcessName
                            Id = $_.Id
                            MainWindowHandle = [IntPtr]$_.MainWindowHandle
                            MainWindowTitle = $_.MainWindowTitle
                        }
                    }
            )
        }
    }

    return @($windows | Sort-Object Id,MainWindowHandle -Unique)
}

if ($DelaySeconds -gt 0) {
    Start-Sleep -Seconds $DelaySeconds
}

$deadline = (Get-Date).AddSeconds($TimeoutSeconds)
do {
    $windows = @(Find-TargetWindows)
    if ($windows.Count -gt 0) {
        Write-WindowActionLog "$Action restored window for ${DisplayName}: $($windows.ProcessName -join ', ')"
        foreach ($window in $windows) {
            if ($Action -eq "close") {
                [WindowTools]::PostMessage($window.MainWindowHandle, 0x0010, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null
            } elseif ($Action -eq "minimize") {
                [WindowTools]::ShowWindow($window.MainWindowHandle, 6) | Out-Null
                [WindowTools]::ShowWindowAsync($window.MainWindowHandle, 6) | Out-Null
            }
        }
        exit 0
    }

    Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)

Write-WindowActionLog "no restored window found for ${DisplayName} within ${TimeoutSeconds}s"
