#!/usr/bin/env python3
"""Select graphical-session or dedicated-VT Plex playback for HDMI."""

import os
import pwd
import re
import signal
import shlex
import subprocess
import sys
import time
from typing import Dict, Optional


ENV_FILE = "/etc/plex-appliance/plex-appliance.env"
PLAYER_SERVICE = "plex-appliance-tv.service"
SESSION_PLAYER_SERVICE = "plex-appliance-hdmi.service"
SELF_TEST_MODE = "--self-test" in sys.argv


def log(message: str) -> None:
    print(time.strftime("%Y-%m-%d %H:%M:%S"), message, flush=True)


def parse_env_value(value: str) -> str:
    parts = shlex.split(value, comments=False, posix=True)
    return parts[0] if parts else ""


def load_env_file(path: str = ENV_FILE) -> Dict[str, str]:
    values: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as env_file:
            for raw_line in env_file:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                values[key.strip()] = parse_env_value(value.strip())
    except FileNotFoundError:
        if not SELF_TEST_MODE:
            raise
    return values


def run(command: list[str], timeout: int = 15) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=False, capture_output=True, text=True, timeout=timeout)


def tty_number(path: str) -> str:
    match = re.search(r"(\d+)$", path)
    if not match:
        raise ValueError(f"Cannot derive VT number from {path!r}")
    return match.group(1)


ENV = load_env_file()
os.environ.update({key: value for key, value in ENV.items() if key not in os.environ})

POLL_SECONDS = int(os.environ.get("PLEX_APPLIANCE_HDMI_POLL_SECONDS", "5"))
HDMI_BACKEND = os.environ.get("PLEX_APPLIANCE_HDMI_BACKEND", "vt").strip().lower()
HDMI_TTY = os.environ.get("PLEX_APPLIANCE_HDMI_TTY", "/dev/tty3")
FALLBACK_RETURN_TTY = os.environ.get("PLEX_APPLIANCE_HDMI_RETURN_TTY", "/dev/tty1")
SYSFS_CONNECTOR = os.environ.get("PLEX_APPLIANCE_HDMI_SYSFS_CONNECTOR", "").strip()
DRM_CONNECTOR = os.environ.get("PLEX_APPLIANCE_HDMI_DRM_CONNECTOR", "").strip()
ELD_PATH = os.environ.get("PLEX_APPLIANCE_HDMI_ELD_PATH", "").strip()
EDID_PATH = os.environ.get("PLEX_APPLIANCE_HDMI_EDID_PATH", "").strip()
RESTORE_GETTY = os.environ.get("PLEX_APPLIANCE_HDMI_RESTORE_GETTY", "true").lower() == "true"
RESTART_DISPLAY_MANAGER = os.environ.get("PLEX_APPLIANCE_HDMI_RESTART_DISPLAY_MANAGER", "false").lower() == "true"
DISPLAY_MANAGER_SERVICE = os.environ.get("PLEX_APPLIANCE_HDMI_DISPLAY_MANAGER_SERVICE", "sddm.service").strip()
STOP_DISPLAY_MANAGER_DURING_PLAYBACK = (
    os.environ.get("PLEX_APPLIANCE_HDMI_STOP_DISPLAY_MANAGER_DURING_PLAYBACK", "false").lower() == "true"
)
LOCKED_SESSION_VT_ENABLED = (
    os.environ.get("PLEX_APPLIANCE_HDMI_LOCKED_SESSION_VT", "false").lower() == "true"
)
RESET_PLASMA_USER_SERVICES = os.environ.get("PLEX_APPLIANCE_HDMI_RESET_PLASMA_USER_SERVICES", "false").lower() == "true"
SKIP_WHEN_LOCAL_USER_ACTIVE = os.environ.get("PLEX_APPLIANCE_HDMI_SKIP_WHEN_LOCAL_USER_ACTIVE", "false").lower() == "true"
APPLIANCE_USER = os.environ.get("PLEX_APPLIANCE_USER", "").strip()
SESSION_PLAYBACK_ENABLED = HDMI_BACKEND == "hybrid"

TV_VT = tty_number(HDMI_TTY)
FALLBACK_RETURN_VT = tty_number(FALLBACK_RETURN_TTY)
CONNECTOR_STATUS = f"/sys/class/drm/{SYSFS_CONNECTOR}/status" if SYSFS_CONNECTOR else ""
GETTY_SERVICE = f"getty@tty{TV_VT}.service"
return_vt: Optional[str] = None
was_connected = False
display_manager_stopped = False
preserved_locked_session = False


def hdmi_connected(require_audio: bool = True) -> bool:
    connector_connected = False

    if CONNECTOR_STATUS:
        try:
            with open(CONNECTOR_STATUS, "r", encoding="utf-8") as status_file:
                connector_connected = status_file.read().strip() == "connected"
        except FileNotFoundError:
            return False

    elif DRM_CONNECTOR:
        completed = run(["kscreen-doctor", "--outputs"], timeout=10)
        connector_connected = (
            completed.returncode == 0
            and DRM_CONNECTOR in completed.stdout
            and "connected" in completed.stdout
        )

    if not connector_connected:
        return False

    if EDID_PATH and not edid_present():
        return False

    if require_audio and ELD_PATH:
        return eld_valid()

    return True


def eld_valid() -> bool:
    try:
        with open(ELD_PATH, "r", encoding="utf-8") as eld_file:
            eld = eld_file.read()
    except FileNotFoundError:
        return False

    return re.search(r"(?m)^\s*eld_valid\s+1\b", eld) is not None


def edid_present() -> bool:
    try:
        with open(EDID_PATH, "rb") as edid_file:
            return bool(edid_file.read(1))
    except FileNotFoundError:
        return False


def service_active(name: str) -> bool:
    return run(["systemctl", "is-active", "--quiet", name], timeout=10).returncode == 0


def active_vt() -> Optional[str]:
    completed = run(["fgconsole"], timeout=10)
    if completed.returncode != 0:
        return None
    value = completed.stdout.strip()
    return value if value else None


def switch_vt(vt: str) -> None:
    completed = run(["chvt", vt], timeout=10)
    if completed.returncode != 0:
        log(f"Failed to switch to VT {vt}: {completed.stderr.strip()}")


def stop_getty() -> None:
    run(["systemctl", "stop", GETTY_SERVICE], timeout=10)


def restore_getty() -> None:
    if RESTORE_GETTY:
        run(["systemctl", "start", GETTY_SERVICE], timeout=10)


def classify_session_properties(
    properties: Dict[str, str], appliance_uid: str
) -> tuple[bool, bool, bool, Optional[str]]:
    session_class = properties.get("Class", "")
    session_state = properties.get("State", "")
    session_type = properties.get("Type", "")
    session_tty = properties.get("TTY", "")
    session_uid = properties.get("User", "")
    session_locked = properties.get("LockedHint", "").lower() == "yes"

    local_active = (
        session_state != "closing"
        and session_class != "greeter"
        and session_tty != f"tty{TV_VT}"
    )
    graphical_active = (
        local_active
        and session_class == "user"
        and session_uid == appliance_uid
        and session_type in {"wayland", "x11"}
    )
    graphical_vt = None
    if graphical_active and session_tty:
        try:
            graphical_vt = tty_number(session_tty)
        except ValueError:
            pass
    return local_active, graphical_active, graphical_active and session_locked, graphical_vt


def local_user_session_state() -> tuple[bool, bool, bool, Optional[str]]:
    completed = run(
        [
            "loginctl",
            "show-seat",
            "seat0",
            "--property=ActiveSession",
            "--property=Sessions",
        ],
        timeout=10,
    )
    if completed.returncode != 0:
        return True, False, False, None

    seat_properties = {
        key: value
        for line in completed.stdout.splitlines()
        if "=" in line
        for key, value in [line.split("=", 1)]
    }
    active_session_id = seat_properties.get("ActiveSession", "").strip()
    session_ids = seat_properties.get("Sessions", "").split()
    if active_session_id and active_session_id != "n/a":
        session_ids = [
            active_session_id,
            *[item for item in session_ids if item != active_session_id],
        ]

    if not session_ids:
        return False, False, False, None

    try:
        appliance_uid = str(pwd.getpwnam(APPLIANCE_USER).pw_uid)
    except KeyError:
        return True, False, False, None

    local_active = False
    for session_id in session_ids:
        completed = run(
            [
                "loginctl",
                "show-session",
                session_id,
                "--property=User",
                "--property=Class",
                "--property=Type",
                "--property=State",
                "--property=TTY",
                "--property=LockedHint",
            ],
            timeout=10,
        )
        if completed.returncode != 0:
            if session_id == active_session_id:
                local_active = True
            continue

        properties = {
            key: value
            for line in completed.stdout.splitlines()
            if "=" in line
            for key, value in [line.split("=", 1)]
        }
        session_state = classify_session_properties(properties, appliance_uid)
        session_local, graphical_active, graphical_locked, graphical_vt = session_state
        local_active = local_active or session_local
        if graphical_active:
            return True, True, graphical_locked, graphical_vt

    return local_active, False, False, None


def local_user_seat_active() -> bool:
    local_active, _graphical_active, _graphical_locked, _graphical_vt = local_user_session_state()
    return local_active


def select_playback_mode(
    connected: bool,
    local_active: bool,
    graphical_active: bool,
    graphical_locked: bool,
    session_playback_enabled: bool,
    locked_session_vt_enabled: bool,
    skip_when_local_active: bool,
) -> str:
    if not connected:
        return "none"
    if session_playback_enabled and graphical_active:
        if graphical_locked and locked_session_vt_enabled:
            return "locked-vt"
        return "session"
    if local_active and skip_when_local_active:
        return "skip"
    return "vt"


def hdmi_audio_required(session_playback_enabled: bool, graphical_active: bool) -> bool:
    # A known graphical session supplies connector identity even when its lock
    # surface has released HDMI audio. Requiring ELD before locked-session VT
    # playback starts would make ELD restoration depend on an already-running
    # direct player.
    return not (session_playback_enabled and graphical_active)


def restart_display_manager_if_safe() -> None:
    if not RESTART_DISPLAY_MANAGER or not DISPLAY_MANAGER_SERVICE:
        return

    if local_user_seat_active():
        log("Local user seat is active; leaving display manager alone")
        return

    reset_plasma_user_services()
    log(f"Restarting {DISPLAY_MANAGER_SERVICE} to recover the local display")
    completed = run(["systemctl", "restart", DISPLAY_MANAGER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to restart {DISPLAY_MANAGER_SERVICE}: {completed.stderr.strip()}")
        return
    time.sleep(2)
    switch_vt(FALLBACK_RETURN_VT)


def stop_display_manager_for_playback() -> bool:
    global display_manager_stopped

    if not STOP_DISPLAY_MANAGER_DURING_PLAYBACK or not DISPLAY_MANAGER_SERVICE:
        return True

    if local_user_seat_active():
        log("Local user seat is active; not stopping display manager for Plex TV playback")
        return False

    if not service_active(DISPLAY_MANAGER_SERVICE):
        return True

    log(f"Stopping {DISPLAY_MANAGER_SERVICE} while Plex TV owns direct DRM playback")
    completed = run(["systemctl", "stop", DISPLAY_MANAGER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to stop {DISPLAY_MANAGER_SERVICE}: {completed.stderr.strip()}")
        return False

    display_manager_stopped = True
    return True


def run_user_systemctl(arguments: list[str], timeout: int = 20) -> subprocess.CompletedProcess[str]:
    return run(
        [
            "systemctl",
            "--user",
            f"--machine={APPLIANCE_USER}@.host",
            *arguments,
        ],
        timeout=timeout,
    )


def user_service_active(name: str) -> bool:
    return run_user_systemctl(["is-active", "--quiet", name], timeout=10).returncode == 0


def start_session_player() -> bool:
    completed = run_user_systemctl(["daemon-reload"], timeout=20)
    if completed.returncode != 0:
        log(f"Failed to reload the user service manager: {completed.stderr.strip()}")
        return False

    completed = run_user_systemctl(["start", SESSION_PLAYER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to start {SESSION_PLAYER_SERVICE}: {completed.stderr.strip()}")
        return False
    return True


def stop_session_player() -> None:
    if not SESSION_PLAYBACK_ENABLED or not APPLIANCE_USER:
        return
    try:
        user_info = pwd.getpwnam(APPLIANCE_USER)
    except KeyError:
        return
    if not os.path.exists(f"/run/user/{user_info.pw_uid}/bus"):
        return
    if not user_service_active(SESSION_PLAYER_SERVICE):
        return
    completed = run_user_systemctl(["stop", SESSION_PLAYER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to stop {SESSION_PLAYER_SERVICE}: {completed.stderr.strip()}")


def reset_plasma_user_services() -> None:
    if not RESET_PLASMA_USER_SERVICES or not APPLIANCE_USER:
        return

    try:
        user_info = pwd.getpwnam(APPLIANCE_USER)
    except KeyError:
        log(f"Cannot reset Plasma services; user {APPLIANCE_USER!r} does not exist")
        return

    if not os.path.exists(f"/run/user/{user_info.pw_uid}/bus"):
        return

    log(f"Resetting stale Plasma user services for {APPLIANCE_USER}")
    units = [
        "plasma-workspace-wayland.target",
        "plasma-workspace.target",
        "plasma-core.target",
        "plasma-plasmashell.service",
        "plasma-kwin_wayland.service",
        "plasma-kded6.service",
        "plasma-polkit-agent.service",
        "plasma-powerdevil.service",
        "plasma-ksplash.service",
    ]
    completed = run_user_systemctl(["stop", *units], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to stop stale Plasma services: {completed.stderr.strip()}")
    run_user_systemctl(["reset-failed"], timeout=10)


def start_player() -> bool:
    completed = run(["systemctl", "start", PLAYER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to start {PLAYER_SERVICE}: {completed.stderr.strip()}")
        return False
    return True


def stop_player() -> None:
    completed = run(["systemctl", "stop", PLAYER_SERVICE], timeout=30)
    if completed.returncode != 0:
        log(f"Failed to stop {PLAYER_SERVICE}: {completed.stderr.strip()}")


def cleanup_display(recover_display: bool = False, stop_session: bool = True) -> None:
    global return_vt, was_connected, display_manager_stopped, preserved_locked_session

    preserve_display_manager = preserved_locked_session

    if stop_session:
        stop_session_player()

    had_player = service_active(PLAYER_SERVICE)
    if service_active(PLAYER_SERVICE):
        stop_player()

    current_vt = active_vt()
    target_vt = return_vt or FALLBACK_RETURN_VT
    if current_vt == TV_VT or return_vt:
        switch_vt(target_vt)

    restore_getty()
    if (
        not preserve_display_manager
        and (display_manager_stopped or recover_display)
        and (was_connected or had_player)
    ):
        restart_display_manager_if_safe()
    return_vt = None
    was_connected = False
    display_manager_stopped = False
    preserved_locked_session = False


def handle_shutdown(signum: int, _frame: object) -> None:
    log(f"Received signal {signum}; stopping Plex TV playback")
    cleanup_display(recover_display=True)
    raise SystemExit(0)


def main() -> int:
    global return_vt, was_connected, preserved_locked_session

    signal.signal(signal.SIGINT, handle_shutdown)
    signal.signal(signal.SIGTERM, handle_shutdown)
    last_mode = ""

    while True:
        session_state = local_user_session_state()
        local_active, graphical_active, graphical_locked, graphical_vt = session_state
        connected = hdmi_connected(
            require_audio=hdmi_audio_required(SESSION_PLAYBACK_ENABLED, graphical_active)
        )
        mode = select_playback_mode(
            connected,
            local_active,
            graphical_active,
            graphical_locked,
            SESSION_PLAYBACK_ENABLED,
            LOCKED_SESSION_VT_ENABLED,
            SKIP_WHEN_LOCAL_USER_ACTIVE,
        )

        if mode == "session":
            if was_connected or service_active(PLAYER_SERVICE):
                log("Graphical session became active; stopping direct-DRM Plex playback")
                cleanup_display(recover_display=False, stop_session=False)
            if last_mode != "session":
                log("HDMI connected with Plasma active; using graphical-session Plex playback")
            if not user_service_active(SESSION_PLAYER_SERVICE):
                start_session_player()
            was_connected = False
            last_mode = mode
            time.sleep(POLL_SECONDS)
            continue

        if (
            SESSION_PLAYBACK_ENABLED
            and last_mode in {"", "session"}
            and user_service_active(SESSION_PLAYER_SERVICE)
        ):
            log("Leaving graphical-session Plex playback")
            stop_session_player()

        if mode == "skip":
            if was_connected or service_active(PLAYER_SERVICE):
                log("HDMI connected while a non-graphical local seat is active; stopping Plex TV playback")
                cleanup_display(recover_display=False)
            elif last_mode != "skip":
                log("HDMI connected while a non-graphical local seat is active; leaving the session alone")
            was_connected = False
            last_mode = mode
            time.sleep(POLL_SECONDS)
            continue

        if mode in {"vt", "locked-vt"}:
            if not was_connected:
                current_vt = active_vt()
                if mode == "locked-vt":
                    preserved_locked_session = True
                    return_vt = graphical_vt or (
                        current_vt if current_vt and current_vt != TV_VT else None
                    )
                    log(
                        "HDMI connected while Plasma is locked; preserving the locked session "
                        f"and using VT {TV_VT} for Plex TV playback"
                    )
                elif current_vt and current_vt != TV_VT:
                    return_vt = current_vt
                    preserved_locked_session = False
                    log(f"HDMI connected; using VT {TV_VT} for Plex TV playback")
                stop_getty()
                if mode == "vt" and not stop_display_manager_for_playback():
                    restore_getty()
                    was_connected = False
                    time.sleep(POLL_SECONDS)
                    continue
                switch_vt(TV_VT)

            elif mode == "vt" and preserved_locked_session:
                log("Locked Plasma session ended; converting Plex VT playback to no-session ownership")
                if service_active(PLAYER_SERVICE):
                    stop_player()
                preserved_locked_session = False
                if not stop_display_manager_for_playback():
                    restore_getty()
                    was_connected = False
                    time.sleep(POLL_SECONDS)
                    continue
                switch_vt(TV_VT)

            if not service_active(PLAYER_SERVICE):
                start_player()

        elif was_connected:
            log("HDMI disconnected; stopping Plex TV playback")
            cleanup_display(recover_display=True)

        elif service_active(PLAYER_SERVICE):
            log("HDMI unavailable; stopping stray Plex TV playback")
            cleanup_display(recover_display=True)

        was_connected = connected
        last_mode = mode
        time.sleep(POLL_SECONDS)


def run_self_test() -> int:
    active, graphical, locked, graphical_vt = classify_session_properties(
        {
            "User": "1000",
            "Class": "user",
            "Type": "wayland",
            "State": "active",
            "TTY": "tty2",
            "LockedHint": "no",
        },
        "1000",
    )
    assert (active, graphical, locked, graphical_vt) == (True, True, False, "2")
    assert classify_session_properties(
        {
            "User": "1000",
            "Class": "user",
            "Type": "wayland",
            "State": "online",
            "TTY": "tty2",
            "LockedHint": "yes",
        },
        "1000",
    ) == (True, True, True, "2")
    assert classify_session_properties(
        {"User": "1000", "Class": "greeter", "Type": "wayland", "State": "active", "TTY": "tty1"},
        "1000",
    ) == (False, False, False, None)
    assert classify_session_properties(
        {"User": "1000", "Class": "user", "Type": "tty", "State": "active", "TTY": "tty2"},
        "1000",
    ) == (True, False, False, None)
    assert classify_session_properties(
        {"User": "1000", "Class": "user", "Type": "tty", "State": "active", "TTY": f"tty{TV_VT}"},
        "1000",
    ) == (False, False, False, None)
    assert select_playback_mode(True, True, True, False, True, True, True) == "session"
    assert select_playback_mode(True, True, True, True, True, True, True) == "locked-vt"
    assert select_playback_mode(True, True, True, True, True, False, True) == "session"
    assert select_playback_mode(True, True, False, False, True, True, True) == "skip"
    assert select_playback_mode(True, False, False, False, True, True, True) == "vt"
    assert select_playback_mode(False, True, True, True, True, True, True) == "none"
    assert hdmi_audio_required(True, True) is False
    assert hdmi_audio_required(True, False) is True
    print("plex-appliance-hdmi-vt-watcher self-test: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(run_self_test() if SELF_TEST_MODE else main())
