#!/usr/bin/env python3
"""Report verified corrupt Plex media entries recorded by the appliance."""

import argparse
import json
import socket
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Tuple


DEFAULT_LOG_PATH = "{{ plex_appliance_corrupt_media_log_path | default('/var/log/plex-appliance/corrupt-media.jsonl') }}"


def numeric(value: object, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def load_records(log_path: Path, cutoff: float) -> List[Dict[str, Any]]:
    if not log_path.exists():
        return []

    records: List[Dict[str, Any]] = []
    with log_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if record.get("event") != "corrupt_media_verified":
                continue
            if numeric(record.get("timestamp")) < cutoff:
                continue
            records.append(record)
    return records


def dedupe_records(records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    latest: Dict[Tuple[str, str, int], Dict[str, Any]] = {}
    for record in records:
        check = record.get("check") if isinstance(record.get("check"), dict) else {}
        key = (
            str(record.get("rating_key") or ""),
            str(check.get("file") or ""),
            int(numeric(record.get("position"))),
        )
        if key not in latest or numeric(record.get("timestamp")) > numeric(latest[key].get("timestamp")):
            latest[key] = record
    return sorted(latest.values(), key=lambda row: numeric(row.get("timestamp")), reverse=True)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--log-path", default=DEFAULT_LOG_PATH)
    parser.add_argument("--since-hours", type=float, default=168.0)
    parser.add_argument("--max-records", type=int, default=10)
    args = parser.parse_args()

    log_path = Path(args.log_path)
    cutoff = time.time() - max(0.0, args.since_hours) * 3600
    records = dedupe_records(load_records(log_path, cutoff))
    host = socket.gethostname()

    if not records:
        print(f"OK: no verified corrupt Plex media on {host} in the last {args.since_hours:g}h")
        return 0

    print(f"CRITICAL: {len(records)} verified corrupt Plex media item(s) on {host} in the last {args.since_hours:g}h")
    for record in records[: max(1, args.max_records)]:
        check = record.get("check") if isinstance(record.get("check"), dict) else {}
        title = str(record.get("title") or "Untitled media")
        file_path = str(check.get("file") or "unknown file")
        reason = str(check.get("reason") or "unknown reason")
        position = int(numeric(record.get("position")))
        print(f"- {title} at {position}s: {reason}; {file_path}")
    if len(records) > args.max_records:
        print(f"- ... {len(records) - args.max_records} more")
    return 1


if __name__ == "__main__":
    sys.exit(main())
