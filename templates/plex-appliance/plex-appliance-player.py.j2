    checkpoint: Dict[str, Any],
    check: Dict[str, Any],
) -> None:
    log_dir = os.path.dirname(CORRUPT_MEDIA_LOG_PATH)
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
    record = {
        "event": "corrupt_media_verified",
        "timestamp": int(time.time()),
        "collection": COLLECTION,
        "rating_key": item_key_to_play,
        "title": item_title(item),
        "position": round(numeric(checkpoint.get("failure_position"), numeric(checkpoint.get("position"))), 3),
        "duration": round(numeric(checkpoint.get("duration")), 3),
