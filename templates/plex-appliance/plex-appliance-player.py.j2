class SubtitleSelection(NamedTuple):
    stream: ET.Element
    position: int

    @property
    def plex_id(self) -> str:
        return self.stream.attrib["id"]

    @property
    def mpv_sid(self) -> int:
        return self.position + 1


def log(message: str) -> None:
    print(time.strftime("%Y-%m-%d %H:%M:%S"), message, flush=True)


def redact_token(message: object) -> str:
    text = str(message)
    if TOKEN:
        text = text.replace(TOKEN, "<redacted>")
    return re.sub(r"X-Plex-Token=[^&\s]+", "X-Plex-Token=<redacted>", text)


def draw_status_screen(lines: List[str]) -> None:
    global STATUS_SCREEN_AVAILABLE
    if not STATUS_SCREEN_ENABLED or not STATUS_SCREEN_AVAILABLE:
        return

    width = 80
    height = 24
    vertical_padding = max(0, (height - len(lines)) // 2)
    body = "\033[?25l\033[H\033[2J" + ("\n" * vertical_padding)
    body += "\n".join(line[:width].center(width) for line in lines)
    body += "\n"

    try:
        with open(STATUS_TTY, "w", encoding="utf-8", buffering=1) as status_tty:
            status_tty.write(body)
    except Exception as exc:
        STATUS_SCREEN_AVAILABLE = False
        log(f"Could not write status screen to {STATUS_TTY}: {redact_token(exc)}")


def clear_status_screen() -> None:
    draw_status_screen([])


def retry_wait(context: str, exc: object, attempt: int, seconds: int) -> None:
    detail = redact_token(exc)
    if detail:
        log(f"{context}: {detail}; retrying in {seconds}s")
    else:
        log(f"{context}; retrying in {seconds}s")

    for remaining in range(seconds, 0, -1):
        draw_status_screen([
            "Connection to Plex Media Server failed.",
            f"Retrying in {remaining} sec (attempt {attempt})",
            "Playback will resume automatically.",
        ])
        time.sleep(1)


def playback_retry_wait(title: str, seconds: int) -> None:
    log(f"Playback unavailable for {title}; retrying in {seconds}s")
    for remaining in range(seconds, 0, -1):
        draw_status_screen([
            "Playback is not ready yet.",
            f"Retrying in {remaining} sec.",
            "The latest Plex media file will be resolved automatically.",
        ])
        time.sleep(1)
    clear_status_screen()


def playback_loading_status(title: str, detail: str) -> None:
    draw_status_screen([
        "Starting Plex playback.",
        title or "Untitled media",
        detail,
    ])


def collection_refresh_delay() -> float:
    jitter = RNG.randrange(COLLECTION_REFRESH_JITTER_SECONDS + 1) if COLLECTION_REFRESH_JITTER_SECONDS else 0
    return max(0, COLLECTION_REFRESH_SECONDS) + jitter


def plex_url(path: str, params: Optional[Dict[str, object]] = None) -> str:
    query = dict(PLEX_CLIENT_PARAMS)
    query.update(params or {})
    query["X-Plex-Token"] = TOKEN
    return f"{PLEX_URL}{path}?{urlencode(query)}"


def plex_direct_stream_url(path: str, params: Optional[Dict[str, object]] = None) -> str:
    query = dict(params or {})
    query["X-Plex-Token"] = TOKEN
    return f"{PLEX_URL}{path}?{urlencode(query)}"


def playback_session_id(item_key_to_play: str) -> str:
    safe_key = re.sub(r"[^A-Za-z0-9_.-]+", "-", item_key_to_play).strip("-") or "item"
    return f"{SESSION_IDENTIFIER}-{safe_key}-{int(time.time())}-{os.getpid()}"


def stream_language_values(stream: ET.Element) -> Set[str]:
    values = set()
    for attr in ("languageCode", "language", "title", "displayTitle"):
        value = stream.attrib.get(attr, "").strip().lower()
        if value:
            values.add(value)
    return values


def subtitle_streams_for_part(part: ET.Element) -> List[SubtitleSelection]:
    streams = [
        stream for stream in part.findall("Stream")
        if stream.attrib.get("streamType") == "3" and stream.attrib.get("id")
    ]
    return [SubtitleSelection(stream=stream, position=position) for position, stream in enumerate(streams)]


def ordered_subtitle_candidates(candidates: List[SubtitleSelection]) -> List[SubtitleSelection]:
    ordered: List[SubtitleSelection] = []
    seen: Set[str] = set()
    for marker in ("selected", "default", "forced"):
        for candidate in candidates:
            if candidate.plex_id not in seen and candidate.stream.attrib.get(marker) == "1":
                ordered.append(candidate)
                seen.add(candidate.plex_id)
    for candidate in candidates:
        if candidate.plex_id not in seen:
            ordered.append(candidate)
            seen.add(candidate.plex_id)
    return ordered


def subtitle_candidates_for_part(part: ET.Element) -> List[SubtitleSelection]:
    subtitle_streams = subtitle_streams_for_part(part)
    if not subtitle_streams:
        return []

    preferred_languages = {language.lower() for language in SUBTITLE_LANGUAGES}
    if preferred_languages:
        matching_streams = [
            candidate for candidate in subtitle_streams
            if stream_language_values(candidate.stream) & preferred_languages
        ]
        if matching_streams:
            subtitle_streams = matching_streams

    return ordered_subtitle_candidates(subtitle_streams)


def is_cjk_character(character: str) -> bool:
    codepoint = ord(character)
    return any(start <= codepoint <= end for start, end in CJK_RANGES)


def subtitle_timestamp_seconds(values: Tuple[str, str, str, str]) -> float:
    hours, minutes, seconds, millis = (int(value) for value in values)
    return hours * 3600 + minutes * 60 + seconds + millis / 1000.0


def subtitle_text_stats(text: str) -> Dict[str, Any]:
    sample = text[:SUBTITLE_SAMPLE_CHARS]
    cue_count = 0
    last_end = 0.0
    for match in SUBTITLE_TIME_RE.finditer(text):
        cue_count += 1
        last_end = subtitle_timestamp_seconds(match.groups()[4:])

    return {
        "chars": len(sample),
        "ascii_letters": sum(1 for character in sample if character.isascii() and character.isalpha()),
        "cjk": sum(1 for character in sample if is_cjk_character(character)),
        "cue_count": cue_count,
        "last_end": last_end,
    }


def english_subtitle_mismatch(stats: Dict[str, Any]) -> bool:
    cjk = stats["cjk"]
    ascii_letters = stats["ascii_letters"]
    comparable = max(1, cjk + ascii_letters)
    return (
        cjk >= SUBTITLE_MIN_CJK_CHARS
        and cjk / comparable >= SUBTITLE_MIN_CJK_FRACTION
        and cjk > ascii_letters
    )


def subtitle_cue_count(stats: Optional[Dict[str, Any]]) -> int:
    if not stats:
        return 0
    try:
        return int(stats.get("cue_count") or 0)
    except (TypeError, ValueError):
        return 0


def cumulative_subtitle_mismatch(
    current_stats: Dict[str, Any],
    alternate_stats: Dict[str, Any],
    duration: float,
) -> bool:
    current_cues = subtitle_cue_count(current_stats)
    alternate_cues = subtitle_cue_count(alternate_stats)
    duration_minutes = max(1.0, duration / 60.0) if duration > 0 else 1.0
    return (
        current_cues >= 750
        and alternate_cues >= 100
        and current_cues - alternate_cues >= 250
        and current_cues >= alternate_cues * 1.6
        and current_cues / duration_minutes >= 35
    )


def subtitle_map_selectors(candidate: SubtitleSelection) -> List[str]:
    selectors: List[str] = []
    stream_index = candidate.stream.attrib.get("index")
    if stream_index and stream_index.isdigit():
        selectors.append(f"0:{stream_index}")
    selectors.append(f"0:s:{candidate.position}")
    return list(dict.fromkeys(selectors))


def sample_subtitle_stats(media_url: str, candidate: SubtitleSelection) -> Optional[Dict[str, Any]]:
    for selector in subtitle_map_selectors(candidate):
        try:
            completed = subprocess.run(
                [
                    "ffmpeg",
                    "-nostdin",
                    "-v",
                    "error",
                    "-i",
                    media_url,
                    "-map",
                    selector,
                    "-f",
                    "srt",
                    "-",
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                errors="replace",
                timeout=SUBTITLE_SAMPLE_TIMEOUT_SECONDS,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            log(f"Subtitle content check could not sample stream {candidate.plex_id}: {redact_token(exc)}")
            return None
        if completed.stdout:
            return subtitle_text_stats(completed.stdout)
    return None


def should_content_check_subtitle(candidate: SubtitleSelection) -> bool:
    if not SUBTITLE_CONTENT_CHECK_ENABLED:
        return False
    preferred_languages = {language.lower() for language in SUBTITLE_LANGUAGES}
    if not (preferred_languages & ENGLISH_LANGUAGE_VALUES):
        return False
    return bool(stream_language_values(candidate.stream) & ENGLISH_LANGUAGE_VALUES)


def subtitle_selection_for_part(part: ET.Element, media_url: str) -> Optional[SubtitleSelection]:
    if SUBTITLE_MODE == "off":
        return None

    ordered_candidates = subtitle_candidates_for_part(part)
    skipped_mismatches = 0
    for candidate in ordered_candidates:
        if should_content_check_subtitle(candidate):
            stats = sample_subtitle_stats(media_url, candidate)
            if stats and english_subtitle_mismatch(stats):
                skipped_mismatches += 1
                log(
                    "Skipping subtitle stream "
                    f"{candidate.plex_id} because it is tagged English but sampled as CJK-heavy "
                    f"(ascii_letters={stats['ascii_letters']} cjk={stats['cjk']})"
                )
                continue
        if skipped_mismatches:
            log(
                f"Selected subtitle stream {candidate.plex_id} after skipping "
                f"{skipped_mismatches} mismatched English subtitle stream(s)"
            )
        return candidate

    if skipped_mismatches:
        log(f"No safe subtitle stream selected after skipping {skipped_mismatches} mismatched stream(s)")
    return None


def plex_universal_stream_url(
    item_key_to_play: str,
    start_position: float,
    session_id: str,
    subtitle_stream_id: Optional[str],
) -> str:
    query = dict(PLEX_TRANSCODE_PARAMS)
    query.update({
        "X-Plex-Session-Identifier": session_id,
        "X-Plex-Token": TOKEN,
        "protocol": "http",
        "mediaIndex": 0,
        "partIndex": 0,
        "path": f"/library/metadata/{item_key_to_play}",
        "directPlay": 0,
        "directStream": 1,
        "copyts": 1,
        "videoQuality": TRANSCODE_VIDEO_QUALITY,
        "maxVideoBitrate": TRANSCODE_MAX_VIDEO_BITRATE,
        "videoResolution": TRANSCODE_VIDEO_RESOLUTION,
        "mediaBufferSize": 50000,
        "waitForSegments": 1,
        "offset": max(0, int(start_position)),
        "session": session_id,
    })
    if SUBTITLE_MODE == "off":
        query["skipSubtitles"] = 1
    elif subtitle_stream_id:
        query["subtitleStreamID"] = subtitle_stream_id
        query["skipSubtitles"] = 0
    return f"{PLEX_URL}/video/:/transcode/universal/start.mkv?{urlencode(query)}"


def stop_universal_stream(session_id: str) -> None:
    if not session_id:
        return
    try:
        SESSION.get(
            plex_direct_stream_url("/video/:/transcode/universal/stop", {"session": session_id}),
            timeout=5,
        )
    except Exception as exc:
        log(f"Could not stop Plex universal session {session_id}: {redact_token(exc)}")


def plex_get(path: str, params: Optional[Dict[str, object]] = None, timeout: int = 20) -> ET.Element:
    response = SESSION.get(plex_url(path, params), timeout=timeout)
    response.raise_for_status()
    return ET.fromstring(response.content)


def plex_metadata_not_found(exc: object) -> bool:
    return (
        isinstance(exc, requests.HTTPError)
        and exc.response is not None
        and exc.response.status_code == 404
    )


def wait_for_server() -> None:
    attempt = 1
    failed_once = False
    while True:
        try:
            plex_get("/identity", timeout=5)
            if failed_once:
                draw_status_screen(["Plex Media Server connected.", "Resuming playback..."])
                time.sleep(1)
                clear_status_screen()
            return
        except Exception as exc:
            failed_once = True
            retry_wait("Plex unavailable", exc, attempt, SERVER_RETRY_SECONDS)
            attempt += 1


def children(root: ET.Element) -> List[ET.Element]:
    return list(root.findall("Directory")) + list(root.findall("Video"))


def fetch_paged(path: str, params: Optional[Dict[str, object]] = None) -> List[ET.Element]:
    items: List[ET.Element] = []
    offset = 0
    while True:
        page_params = dict(params or {})
        page_params["X-Plex-Container-Start"] = offset
        page_params["X-Plex-Container-Size"] = PAGE_SIZE
        root = plex_get(path, page_params)
        page_items = children(root)
        items.extend(page_items)

        size = int(root.attrib.get("size", len(page_items)))
        total = int(root.attrib.get("totalSize", offset + size))
        offset += size
        if size <= 0 or offset >= total:
            return items


def find_section_key() -> str:
    root = plex_get("/library/sections/all")
    for directory in root.findall("Directory"):
        if directory.attrib.get("title") == LIBRARY:
            return directory.attrib["key"]
    raise RuntimeError(f"Library not found: {LIBRARY}")


def find_collection_id(section_key: str) -> str:
    collections = fetch_paged(f"/library/sections/{section_key}/collections")
    for collection in collections:
        if collection.attrib.get("title") == COLLECTION:
            return collection.attrib["ratingKey"]
    raise RuntimeError(f"Collection not found in {LIBRARY}: {COLLECTION}")


def fetch_metadata(rating_key: str) -> Optional[ET.Element]:
    root = plex_get(f"/library/metadata/{rating_key}")
    metadata = children(root)
    return metadata[0] if metadata else None


def expand_video_item(item: ET.Element) -> Iterable[ET.Element]:
    item_type = item.attrib.get("type")
    rating_key = item.attrib.get("ratingKey")
    if item_type in {"episode", "movie"}:
        yield item
    elif item_type == "show" and rating_key:
        yield from fetch_paged(f"/library/metadata/{rating_key}/allLeaves")
    elif item_type == "season" and rating_key:
        yield from fetch_paged(f"/library/metadata/{rating_key}/children")


def load_collection_items() -> List[ET.Element]:
    section_key = find_section_key()
    collection_id = find_collection_id(section_key)
    raw_items = fetch_paged(f"/library/collections/{collection_id}/items")
    expanded: List[ET.Element] = []
    for item in raw_items:
        expanded.extend(expand_video_item(item))

    playable = [item for item in expanded if item.attrib.get("ratingKey") or stream_url_for_item(item)]
    if not playable:
        raise RuntimeError(f"No playable items found in collection: {COLLECTION}")
    log(f"Loaded {len(playable)} playable items from {COLLECTION}")
    return playable


def stream_url_for_item(item: ET.Element, refresh_metadata: bool = False) -> Optional[str]:
    stream_info = stream_info_for_item(item, refresh_metadata)
    return stream_info[0] if stream_info else None


def plex_duration_seconds(*values: object) -> float:
    for value in values:
        milliseconds = numeric(value, -1.0)
        if milliseconds > 0:
            return milliseconds / 1000.0
    return 0.0


def stream_info_for_item(
    item: ET.Element,
    refresh_metadata: bool = False,
) -> Optional[Tuple[str, str, str, ET.Element, float]]:
    media_parent = item
    if item.attrib.get("ratingKey") and (refresh_metadata or not item.findall("Media")):
        fetched = fetch_metadata(item.attrib["ratingKey"])
        if fetched is not None:
            media_parent = fetched

    for media in media_parent.findall("Media"):
        for part in media.findall("Part"):
            key = part.attrib.get("key")
            if key:
                duration = plex_duration_seconds(
                    part.attrib.get("duration"),
                    media.attrib.get("duration"),
                    media_parent.attrib.get("duration"),
                    item.attrib.get("duration"),
                )
                return plex_direct_stream_url(key), key, part.attrib.get("file", ""), part, duration
    return None


def item_title(item: ET.Element) -> str:
    parts = [
        item.attrib.get("grandparentTitle"),
        item.attrib.get("parentTitle"),
        item.attrib.get("title"),
    ]
    return " - ".join(part for part in parts if part)


def item_key(item: ET.Element) -> str:
    return item.attrib.get("ratingKey") or item.attrib.get("key") or item_title(item)


def item_identity(item: ET.Element) -> str:
    guid = item.attrib.get("guid", "").strip()
    if guid:
        return f"guid:{guid}"

    if item.attrib.get("type") == "episode":
        episode_identity = [
            item.attrib.get("grandparentTitle", "").strip().casefold(),
            item.attrib.get("parentIndex", "").strip(),
            item.attrib.get("index", "").strip(),
        ]
        if all(episode_identity):
            return "episode:" + json.dumps(episode_identity, separators=(",", ":"))

    title = item_title(item).strip().casefold()
    return f"title:{title}" if title else ""


def items_by_key(items: List[ET.Element]) -> Dict[str, ET.Element]:
    keyed: Dict[str, ET.Element] = {}
    for item in items:
        key = item_key(item)
        if key and key not in keyed:
            keyed[key] = item
    return keyed


def replacement_item_for_active(
    active: Dict[str, Any],
    item_map: Dict[str, ET.Element],
    unplayable_keys: Set[str],
) -> Optional[ET.Element]:
    candidates = [
        item for key, item in item_map.items()
        if key not in unplayable_keys
    ]

    identity = str(active.get("identity") or "")
    if identity:
        identity_matches = [item for item in candidates if item_identity(item) == identity]
        if len(identity_matches) == 1:
            return identity_matches[0]
        if len(identity_matches) > 1:
            return None

    title = str(active.get("title") or "")
    if title:
        title_matches = [item for item in candidates if item_title(item) == title]
        if len(title_matches) == 1:
            return title_matches[0]
    return None


def reconcile_active_metadata(
    active: Optional[Dict[str, Any]],
    item_map: Dict[str, ET.Element],
    unplayable_keys: Set[str],
) -> Optional[Dict[str, Any]]:
    current_key = active_item_key(active)
    if not current_key:
        return None
    if current_key in unplayable_keys:
        return None

    current_item = item_map.get(current_key)
    if current_item is not None:
        normalized = dict(active or {})
        normalized["title"] = item_title(current_item)
        normalized["identity"] = item_identity(current_item)
        return normalized

    replacement = replacement_item_for_active(active or {}, item_map, unplayable_keys)
    if replacement is None:
        log(
            f"Active Plex metadata ID {current_key} disappeared without a unique replacement; "
            "keeping the replacement eligible in the refreshed queue"
        )
        return None

    replacement_key = item_key(replacement)
    rebound = dict(active or {})
    rebound["key"] = replacement_key
    rebound["title"] = item_title(replacement)
    rebound["identity"] = item_identity(replacement)
    rebound["updated_at"] = int(time.time())
    for retry_key in RETRY_STATE_KEYS:
        rebound.pop(retry_key, None)
    log(f"Rebound active Plex metadata ID {current_key} to replacement ID {replacement_key}")
    return rebound


def shuffled_keys(keys: Iterable[str]) -> List[str]:
    queue = list(keys)
    RNG.shuffle(queue)
    return queue


def unique_ordered(keys: Iterable[str]) -> List[str]:
    seen: Set[str] = set()
    ordered: List[str] = []
    for key in keys:
        key = str(key)
        if key in seen:
            continue
        seen.add(key)
        ordered.append(key)
    return ordered


def load_shuffle_state() -> Tuple[List[str], List[str], List[str], Optional[Dict[str, Any]]]:
    try:
        with open(SHUFFLE_STATE_PATH, "r", encoding="utf-8") as state_file:
            payload = json.load(state_file)
    except FileNotFoundError:
        return [], [], [], None
    except Exception as exc:
        log(f"Could not load shuffle state {SHUFFLE_STATE_PATH}: {redact_token(exc)}")
        return [], [], [], None

    queue = payload.get("queue", [])
    played = payload.get("played", [])
    unplayable = payload.get("unplayable", [])
    active = payload.get("active")
    if not isinstance(queue, list) or not isinstance(played, list):
        return [], [], [], None
    if not isinstance(unplayable, list):
        unplayable = []
    if not isinstance(active, dict) or not active.get("key"):
        active = None
    return unique_ordered(queue), unique_ordered(played), unique_ordered(unplayable), active


def save_shuffle_state(
    queue_keys: List[str],
    played_keys: List[str],
    unplayable_keys: List[str],
    active: Optional[Dict[str, Any]] = None,
) -> None:
    state_dir = os.path.dirname(SHUFFLE_STATE_PATH)
    if state_dir:
        os.makedirs(state_dir, exist_ok=True)
    tmp_path = f"{SHUFFLE_STATE_PATH}.tmp"
    payload = {
        "collection": COLLECTION,
        "queue": queue_keys,
        "played": played_keys,
        "unplayable": unplayable_keys,
        "updated_at": int(time.time()),
    }
    if active:
        payload["active"] = active
    with open(tmp_path, "w", encoding="utf-8") as state_file:
        json.dump(payload, state_file, separators=(",", ":"))
    os.replace(tmp_path, SHUFFLE_STATE_PATH)


def insert_randomly_after_current(queue_keys: List[str], new_keys: List[str], active_key: str = "") -> None:
    if not new_keys:
        return

    first_insert_index = 0 if active_key else min(1, len(queue_keys))
    for key in shuffled_keys(new_keys):
        queue_keys.insert(RNG.randrange(first_insert_index, len(queue_keys) + 1), key)


def reconcile_shuffle_state(
    queue_keys: List[str],
    played_keys: List[str],
    unplayable_keys: List[str],
    item_keys: Set[str],
    active_key: str = "",
) -> Tuple[List[str], List[str], List[str]]:
    unplayable_keys = [key for key in unique_ordered(unplayable_keys) if key in item_keys]
    unplayable_set = set(unplayable_keys)
    playable_item_keys = item_keys - unplayable_set

    queue_keys = [key for key in unique_ordered(queue_keys) if key in playable_item_keys]
    if active_key:
        queue_keys = [key for key in queue_keys if key != active_key]
    queue_set = set(queue_keys)
    played_keys = [
        key for key in unique_ordered(played_keys)
        if key in item_keys and key not in queue_set and key not in unplayable_set
    ]
    known_keys = queue_set | set(played_keys) | unplayable_set
    if active_key in playable_item_keys:
        known_keys.add(active_key)
    new_keys = sorted(playable_item_keys - known_keys)

    if new_keys and queue_keys:
        insert_randomly_after_current(queue_keys, new_keys, active_key)
        log(f"Added {len(new_keys)} new items after the current shuffle position")
    elif new_keys:
        queue_keys = shuffled_keys(new_keys)
        if active_key:
            log(f"Queued {len(new_keys)} new items after the active item")
        else:
            log(f"Queued {len(new_keys)} not-yet-played items before starting a new shuffle cycle")

    if not queue_keys and not active_key:
        last_played = played_keys[-1] if played_keys else ""
        queue_keys = shuffled_keys(playable_item_keys)
        if last_played and len(queue_keys) > 1 and queue_keys[0] == last_played:
            swap_index = RNG.randrange(1, len(queue_keys))
            queue_keys[0], queue_keys[swap_index] = queue_keys[swap_index], queue_keys[0]
        played_keys = []
        log(f"Started a new shuffle cycle with {len(queue_keys)} items")

    log(
        "Shuffle state: "
        f"{len(queue_keys)} queued, {len(played_keys)} completed this cycle, "
        f"{len(unplayable_keys)} marked unplayable"
    )
    return queue_keys, played_keys, unplayable_keys


def active_item_key(active: Optional[Dict[str, Any]]) -> str:
    if not active:
        return ""
    return str(active.get("key", ""))


def numeric(value: object, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def optional_numeric(value: object) -> Optional[float]:
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    checkpoint = {
        "key": item_key_to_play,
        "title": item_title(item),
        "identity": item_identity(item),
        "position": max(0.0, position),
        "duration": max(0.0, duration),
        "updated_at": int(time.time()),
    }
    if previous_active and str(previous_active.get("key", "")) == item_key_to_play:
        previous_failure_position = optional_numeric(previous_active.get("failure_position"))
        if previous_failure_position is None:
            previous_failure_position = optional_numeric(previous_active.get("position"))
        if previous_failure_position is not None and abs(checkpoint["position"] - previous_failure_position) <= PLAYBACK_FAILURE_POSITION_WINDOW_SECONDS:
            for key in RETRY_STATE_KEYS:
                if key in previous_active:
                    checkpoint[key] = previous_active[key]
    return checkpoint


def clear_retry_state(checkpoint: Dict[str, Any]) -> Dict[str, Any]:
    for key in RETRY_STATE_KEYS:
        checkpoint.pop(key, None)
    return checkpoint


def retry_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
    reason: str,
) -> Dict[str, Any]:
    checkpoint = active_checkpoint(item_key_to_play, item, position, duration, previous_active)
    previous_count = 0
    previous_position: Optional[float] = None
    if previous_active and str(previous_active.get("key", "")) == item_key_to_play:
        previous_reason = str(previous_active.get("failure_reason") or "")
        legacy_playback_failure = reason == "playback_failure" and "failure_count" in previous_active and not previous_reason
        if previous_reason == reason or legacy_playback_failure:
            previous_count = int(numeric(previous_active.get("failure_count"), 0.0))
            previous_position = optional_numeric(previous_active.get("failure_position"))

    failure_position = max(0.0, position)
    if previous_position is not None and abs(failure_position - previous_position) <= PLAYBACK_FAILURE_POSITION_WINDOW_SECONDS:
        failure_count = previous_count + 1
    else:
        failure_count = 1

    checkpoint["failure_count"] = failure_count
    checkpoint["failure_position"] = failure_position
    checkpoint["failure_reason"] = reason
    return checkpoint


def failed_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
) -> Dict[str, Any]:
    return retry_active_checkpoint(item_key_to_play, item, position, duration, previous_active, "playback_failure")


def early_exit_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
) -> Dict[str, Any]:
    return retry_active_checkpoint(item_key_to_play, item, position, duration, previous_active, "early_clean_exit")


def parse_progress_time(value: object) -> Optional[float]:
    if not isinstance(value, str):
        return None
    parts = value.strip().split(":")
    if len(parts) != 3:
        return None
    try:
        hours = int(parts[0])
        minutes = int(parts[1])
        seconds = float(parts[2])
    except ValueError:
        return None
    return (hours * 3600) + (minutes * 60) + seconds


def plex_stream_transport_failure(stderr_lower: str) -> bool:
    if "[http @" not in stderr_lower and "http://" not in stderr_lower and "https://" not in stderr_lower:
        return False
    transport_markers = [
        "stream ends prematurely at 0",
        "stream ends prematurely",
        "connection reset by peer",
        "server returned 5",
        "service unavailable",
        "connection refused",
        "connection timed out",
        "read timed out",
    ]
    return any(text in stderr_lower for text in transport_markers)


def run_corruption_check(item: ET.Element, position: float, duration: float) -> Dict[str, Any]:
    start = max(0.0, position - CORRUPTION_CHECK_REWIND_SECONDS)
    expected_seconds = float(CORRUPTION_CHECK_SECONDS)
    if duration > 0:
        expected_seconds = min(expected_seconds, max(0.0, duration - start))
    result: Dict[str, Any] = {
        "status": "not_run",
        "start": round(start, 3),
        "seconds": round(expected_seconds, 3),
    }
    if not CORRUPTION_CHECK_ENABLED:
        result["reason"] = "disabled"
        return result
    if expected_seconds < 10:
        result["status"] = "inconclusive"
        result["reason"] = "too_close_to_media_end"
        return result

    stream_info = stream_info_for_item(item, refresh_metadata=True)
    if not stream_info:
        result["status"] = "inconclusive"
        result["reason"] = "missing_stream_url"
        return result
    url, part_key, file_path, _part, _duration = stream_info
    result["part_key"] = part_key
    result["file"] = file_path

    command = [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "warning",
        "-progress",
        "pipe:1",
        "-nostats",
        "-ss",
        f"{start:.3f}",
        "-t",
        f"{expected_seconds:.3f}",
        "-i",
        url,
        "-map",
        "0:v:0",
        "-map",
        "0:a:0?",
        "-sn",
        "-f",
        "null",
        "-",
    ]
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=CORRUPTION_CHECK_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_not_found"
        return result
    except subprocess.TimeoutExpired as exc:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_timeout"
        result["stderr_tail"] = redact_token(exc.stderr or "")[-1000:]
        return result

    decoded_seconds = 0.0
    for line in completed.stdout.splitlines():
        key, _, value = line.partition("=")
        if key == "out_time":
            parsed = parse_progress_time(value)
            if parsed is not None:
                decoded_seconds = max(decoded_seconds, parsed)
        elif key in {"out_time_us", "out_time_ms"}:
            decoded_seconds = max(decoded_seconds, numeric(value) / 1000000.0)

    stderr = redact_token(completed.stderr or "")
    stderr_lower = stderr.lower()
    corruption_markers = [
        "file ended prematurely",
        "invalid data found",
        "error while decoding",
        "corrupt",
        "header damaged",
        "partial file",
        "invalid nal",
    ]
    marker = next((text for text in corruption_markers if text in stderr_lower), "")
    short_decode = expected_seconds - decoded_seconds >= 15 and decoded_seconds < expected_seconds * 0.8
    decoded_expected_window = decoded_seconds >= expected_seconds * 0.8

    result.update({
        "return_code": completed.returncode,
        "decoded_seconds": round(decoded_seconds, 3),
        "stderr_tail": stderr[-1000:],
    })
    if completed.returncode == 0 and decoded_expected_window:
        result["status"] = "passed"
        result["reason"] = "ffmpeg_decoded_expected_window"
        if marker:
            result["warning_marker"] = marker
    elif plex_stream_transport_failure(stderr_lower):
        result["status"] = "inconclusive"
        result["reason"] = "plex_stream_transport_failure"
        if marker:
            result["warning_marker"] = marker
    elif marker:
        result["status"] = "corrupt"
        result["reason"] = marker
    elif short_decode and duration > start + expected_seconds:
        result["status"] = "corrupt"
        result["reason"] = "decode_ended_before_expected_window"
    else:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_failed_without_corruption_marker" if completed.returncode != 0 else "short_decode_without_corruption_marker"
    return result


def safe_corruption_check(item: ET.Element, position: float, duration: float) -> Dict[str, Any]:
    try:
        return run_corruption_check(item, position, duration)
    except Exception as exc:
        log(f"Corruption check could not complete: {redact_token(exc)}")
        return {
            "status": "inconclusive",
            "reason": "corruption_check_error",
            "error": redact_token(exc),
        }


def append_corrupt_media_log(
    item_key_to_play: str,
