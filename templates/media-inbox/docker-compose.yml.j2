---
# yamllint disable rule:braces
# yamllint disable rule:line-length
services:
  media-inbox:
    image: python:3.13-slim
    container_name: immich-media-inbox
    init: true
    restart: unless-stopped
    command: ["python", "-m", "immich_media_inbox"]
    working_dir: /app
    user: "{{ immich_media_inbox_runtime_uid }}:{{ immich_media_inbox_runtime_gid }}"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 100
    mem_limit: 512m
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      PYTHONUNBUFFERED: "1"
      IMMICH_URL: "{{ immich_media_inbox_immich_api_url }}"
      IMMICH_WEB_URL: "{{ immich_media_inbox_immich_web_url }}"
      IMMICH_API_KEY_FILE: /run/secrets/immich_api_key
      SEERR_URL: "{{ immich_media_inbox_seerr_api_url }}"
      SEERR_API_KEY_FILE: /run/secrets/seerr_api_key
      DATABASE_PATH: /data/media-inbox.sqlite3
      SCAN_INTERVAL_SECONDS: "{{ immich_media_inbox_scan_interval_seconds }}"
      SCAN_BATCH_SIZE: "{{ immich_media_inbox_scan_batch_size }}"
      API_REQUEST_DELAY_MS: "{{ immich_media_inbox_api_request_delay_ms }}"
      CANDIDATE_THRESHOLD: "{{ immich_media_inbox_candidate_threshold }}"
      AUTO_MATCH_THRESHOLD: "{{ immich_media_inbox_auto_match_threshold }}"
      SMART_SEARCH_SIZE: "{{ immich_media_inbox_smart_search_size }}"
      SMART_SEARCH_INTERVAL_HOURS: "{{ immich_media_inbox_smart_search_interval_hours }}"
      REQUESTS_ENABLED: "{{ immich_media_inbox_requests_enabled | ternary('true', 'false') }}"
      ALLOWED_VISIBILITIES: "{{ immich_media_inbox_allowed_visibilities | join(',') }}"
    volumes:
      - "{{ immich_media_inbox_root }}/app:/app:ro"
      - "{{ immich_media_inbox_root }}/data:/data"
      - "{{ immich_media_inbox_root }}/secrets/immich_api_key:/run/secrets/immich_api_key:ro"
      - "{{ immich_media_inbox_root }}/secrets/seerr_api_key:/run/secrets/seerr_api_key:ro"
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777
    healthcheck:
      test:
        - CMD
        - python
        - -m
        - immich_media_inbox.cli
        - status
        - --healthcheck
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    labels:
      diun.enable: "true"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - caddy-proxy

networks:
  caddy-proxy:
    external: true
