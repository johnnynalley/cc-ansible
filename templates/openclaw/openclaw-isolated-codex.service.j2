[Unit]
Description=Isolated Codex app-server executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_isolated_codex_user }}
Group={{ openclaw_isolated_codex_group }}
SupplementaryGroups={{ openclaw_isolated_codex_supplementary_groups | join(' ') }}
WorkingDirectory={{ openclaw_isolated_gateway_workspace_dir }}
Environment=HOME={{ openclaw_isolated_codex_state_dir }}
Environment=CODEX_HOME={{ openclaw_isolated_codex_state_dir }}/codex-home
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/test -r {{ openclaw_isolated_codex_token_file }}
ExecStartPre=/usr/bin/test ! -w {{ openclaw_isolated_codex_token_file }}
ExecStartPre=/usr/bin/test -r {{ openclaw_isolated_codex_runtime_dir }}/node_modules/@openai/codex/bin/codex.js
ExecStartPre=/usr/bin/test ! -w {{ openclaw_isolated_codex_runtime_dir }}
ExecStartPre=/usr/bin/test -w {{ openclaw_isolated_codex_state_dir }}
ExecStartPre=/usr/bin/test -w {{ openclaw_isolated_gateway_workspace_dir }}
ExecStartPre=/usr/bin/test ! -r {{ openclaw_isolated_gateway_secret_file }}
ExecStartPre=/usr/bin/test ! -r {{ openclaw_isolated_gateway_config_file }}
ExecStartPre=/usr/bin/test ! -x /home/{{ openclaw_isolated_gateway_legacy_user }}
ExecStartPre=/usr/bin/test ! -r /var/run/docker.sock
ExecStartPre=/usr/bin/test ! -r /home/{{ openclaw_isolated_gateway_legacy_user }}/.ansible/vault_pass.txt
ExecStartPre=/usr/bin/test ! -r {{ openclaw_workspace }}/AGENTS.md
ExecStart=/usr/bin/node {{ openclaw_isolated_codex_runtime_dir }}/node_modules/@openai/codex/bin/codex.js app-server --listen ws://127.0.0.1:{{ openclaw_isolated_codex_port }} --ws-auth capability-token --ws-token-file {{ openclaw_isolated_codex_token_file }}
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
TasksMax=256
MemoryMax=4G
MemorySwapMax=1G
CPUQuota=200%
LimitNOFILE=16384
LimitNPROC=256
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
DevicePolicy=closed
StateDirectory=openclaw-codex
StateDirectoryMode=0750
ReadWritePaths={{ openclaw_isolated_codex_state_dir }}
ReadWritePaths={{ openclaw_isolated_gateway_workspace_dir }}
ReadOnlyPaths={{ openclaw_isolated_codex_config_dir }}
ReadOnlyPaths={{ openclaw_isolated_codex_runtime_dir }}
TemporaryFileSystem={{ openclaw_isolated_gateway_state_dir }}:ro
InaccessiblePaths=-{{ openclaw_isolated_gateway_config_dir }}
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
InaccessiblePaths=-/home/{{ openclaw_isolated_gateway_legacy_user }} -/root
InaccessiblePaths=-{{ openclaw_workspace }} -/etc/ansible
InaccessiblePaths=-/var/lib/docker -/srv -/mnt -/media
InaccessiblePaths=-{{ openclaw_security_rehearsal_root }}

[Install]
WantedBy=multi-user.target
