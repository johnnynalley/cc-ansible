[Unit]
Description=Isolated OpenClaw Gateway canary
After=network-online.target openclaw-isolated-codex.service
Wants=network-online.target
Requires=openclaw-isolated-codex.service

[Service]
Type=simple
User={{ openclaw_isolated_gateway_user }}
Group={{ openclaw_isolated_gateway_group }}
SupplementaryGroups={{ openclaw_isolated_gateway_supplementary_groups | join(' ') }}
WorkingDirectory={{ openclaw_isolated_gateway_state_dir }}
Environment=HOME={{ openclaw_isolated_gateway_state_dir }}
Environment=OPENCLAW_HOME={{ openclaw_isolated_gateway_state_dir }}
Environment=OPENCLAW_STATE_DIR={{ openclaw_isolated_gateway_state_dir }}/state
Environment=OPENCLAW_CONFIG_PATH={{ openclaw_isolated_gateway_config_file }}
Environment=OPENCLAW_WORKSPACE_DIR={{ openclaw_isolated_gateway_workspace_dir }}
Environment=OPENCLAW_SKIP_CHANNELS=1
Environment=OPENCLAW_SKIP_CRON=1
Environment=NODE_COMPILE_CACHE={{ openclaw_isolated_gateway_state_dir }}/compile-cache
Environment=PATH={{ openclaw_isolated_gateway_runtime_dir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre={{ openclaw_isolated_access_check_path }} -r {{ openclaw_isolated_gateway_config_file }}
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -w {{ openclaw_isolated_gateway_config_file }}
ExecStartPre={{ openclaw_isolated_access_check_path }} -w {{ openclaw_isolated_gateway_config_file }}.last-good
ExecStartPre={{ openclaw_isolated_access_check_path }} -r {{ openclaw_isolated_gateway_secret_file }}
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -w {{ openclaw_isolated_gateway_secret_file }}
ExecStartPre={{ openclaw_isolated_access_check_path }} -w {{ openclaw_isolated_gateway_state_dir }}
ExecStartPre={{ openclaw_isolated_access_check_path }} -r {{ openclaw_isolated_gateway_codex_plugin_dir }}/openclaw.plugin.json
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -w {{ openclaw_isolated_gateway_codex_plugin_dir }}
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -w {{ openclaw_isolated_gateway_state_dir }}/state/npm
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -w {{ openclaw_isolated_gateway_workspace_dir }}
ExecStartPre={{ openclaw_isolated_access_check_path }} -x {{ openclaw_isolated_gateway_workspace_dir }}
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -x /home/{{ openclaw_isolated_gateway_legacy_user }}
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -r /var/run/docker.sock
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -r /home/{{ openclaw_isolated_gateway_legacy_user }}/.ansible/vault_pass.txt
ExecStartPre={{ openclaw_isolated_access_check_path }} ! -r {{ openclaw_workspace }}/AGENTS.md
ExecStart={{ openclaw_isolated_gateway_runtime_dir }}/bin/openclaw gateway run --port {{ openclaw_isolated_gateway_port }} --ws-log compact
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStartSec=120
TimeoutStopSec=30
TasksMax=256
MemoryMax=4G
MemorySwapMax=1G
CPUQuota=200%
LimitNOFILE=16384
LimitNPROC=256
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
DevicePolicy=closed
StateDirectory=openclaw-isolated
StateDirectoryMode=0700
ReadWritePaths={{ openclaw_isolated_gateway_state_dir }}
ReadOnlyPaths={{ openclaw_isolated_gateway_runtime_root }}
ReadOnlyPaths={{ openclaw_isolated_gateway_state_dir }}/state/npm
ReadOnlyPaths={{ openclaw_isolated_gateway_config_dir }}
ReadOnlyPaths={{ openclaw_isolated_gateway_workspace_dir }}
ReadWritePaths={{ openclaw_isolated_gateway_config_file }}.last-good
InaccessiblePaths=-{{ openclaw_isolated_codex_config_dir }} -{{ openclaw_isolated_codex_state_dir }}
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
InaccessiblePaths=-/home/{{ openclaw_isolated_gateway_legacy_user }} -/root
InaccessiblePaths=-{{ openclaw_workspace }} -/etc/ansible
InaccessiblePaths=-/var/lib/docker -/srv -/mnt -/media

[Install]
WantedBy=multi-user.target
