[Unit]
Description=Isolated OpenClaw Gateway canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_isolated_gateway_user }}
Group={{ openclaw_isolated_gateway_group }}
WorkingDirectory={{ openclaw_isolated_gateway_state_dir }}
Environment=HOME={{ openclaw_isolated_gateway_state_dir }}
Environment=OPENCLAW_HOME={{ openclaw_isolated_gateway_state_dir }}
Environment=OPENCLAW_STATE_DIR={{ openclaw_isolated_gateway_state_dir }}/state
Environment=OPENCLAW_CONFIG_PATH={{ openclaw_isolated_gateway_config_file }}
Environment=OPENCLAW_WORKSPACE_DIR={{ openclaw_isolated_gateway_workspace_dir }}
Environment=OPENCLAW_SKIP_CHANNELS=1
Environment=NODE_COMPILE_CACHE={{ openclaw_isolated_gateway_state_dir }}/compile-cache
Environment=PATH={{ openclaw_isolated_gateway_runtime_dir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/test -r {{ openclaw_isolated_gateway_config_file }}
ExecStartPre=/usr/bin/test ! -w {{ openclaw_isolated_gateway_config_file }}
ExecStartPre=/usr/bin/test -r {{ openclaw_isolated_gateway_secret_file }}
ExecStartPre=/usr/bin/test ! -w {{ openclaw_isolated_gateway_secret_file }}
ExecStartPre=/usr/bin/test -w {{ openclaw_isolated_gateway_state_dir }}
ExecStartPre=/usr/bin/test ! -w {{ openclaw_isolated_gateway_workspace_dir }}
ExecStartPre=/usr/bin/test ! -x /home/{{ openclaw_isolated_gateway_legacy_user }}
ExecStartPre=/usr/bin/test ! -r /var/run/docker.sock
ExecStartPre=/usr/bin/test ! -r /home/{{ openclaw_isolated_gateway_legacy_user }}/.ansible/vault_pass.txt
ExecStartPre=/usr/bin/test ! -r {{ openclaw_workspace }}/AGENTS.md
ExecStart={{ openclaw_isolated_gateway_runtime_dir }}/bin/openclaw gateway run --port {{ openclaw_isolated_gateway_port }} --ws-log compact
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStartSec=120
TimeoutStopSec=30
TasksMax=256
MemoryMax=4G
MemorySwapMax=1G
CPUQuota=200%
LimitNOFILE=16384
LimitNPROC=256
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
DevicePolicy=closed
StateDirectory=openclaw-isolated
StateDirectoryMode=0700
ReadWritePaths={{ openclaw_isolated_gateway_state_dir }}
ReadOnlyPaths={{ openclaw_isolated_gateway_runtime_dir }}
ReadOnlyPaths={{ openclaw_isolated_gateway_config_dir }}
ReadOnlyPaths={{ openclaw_isolated_gateway_workspace_dir }}
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
InaccessiblePaths=-/home/{{ openclaw_isolated_gateway_legacy_user }} -/root
InaccessiblePaths=-{{ openclaw_workspace }} -/etc/ansible
InaccessiblePaths=-/var/lib/docker -/srv -/mnt -/media

[Install]
WantedBy=multi-user.target
