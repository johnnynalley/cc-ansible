{
  "secrets": {
    "providers": {
      "isolated": {
        "source": "file",
        "path": {{ openclaw_isolated_gateway_secret_file | to_json }},
        "mode": "json"
      }
    },
    "defaults": {
      "file": "isolated"
    }
  },
  "agents": {
    "defaults": {
      "workspace": {{ openclaw_isolated_gateway_workspace_dir | to_json }},
      "skipBootstrap": true,
      "model": {
        "primary": {{ openclaw_isolated_gateway_model | to_json }},
        "fallbacks": []
      },
      "models": {
        {{ openclaw_isolated_gateway_model | to_json }}: {
          "alias": "isolation-canary"
        }
      },
      "thinkingDefault": "low",
      "timeoutSeconds": 180,
      "maxConcurrent": 1,
      "heartbeat": {
        "every": "0m",
        "target": "none",
        "includeReasoning": false,
        "suppressToolErrorWarnings": true,
        "lightContext": true,
        "isolatedSession": true
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Astra Canary",
        "skills": []
      },
      {
        "id": "dubble",
        "name": "Dubble Canary",
        "workspace": {{ (openclaw_isolated_gateway_workspace_dir ~ '/dubble') | to_json }},
        "skills": []
      },
      {
        "id": "vega",
        "name": "Vega Canary",
        "workspace": {{ (openclaw_isolated_gateway_workspace_dir ~ '/vega') | to_json }},
        "skills": []
      },
      {
        "id": "antares",
        "name": "Antares Canary",
        "workspace": {{ (openclaw_isolated_gateway_workspace_dir ~ '/antares') | to_json }},
        "skills": []
      },
      {
        "id": "rigel",
        "name": "Rigel Canary",
        "workspace": {{ (openclaw_isolated_gateway_workspace_dir ~ '/rigel') | to_json }},
        "skills": []
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "deny": [
      "group:runtime",
      "group:fs",
      "group:sessions",
      "group:memory",
      "group:web",
      "group:ui",
      "group:automation",
      "group:messaging",
      "group:nodes",
      "group:agents",
      "group:media",
      "group:plugins"
    ],
    "exec": {
      "host": "gateway",
      "mode": "auto",
      "strictInlineEval": true,
      "commandHighlighting": true,
      "notifyOnExit": false
    },
    "elevated": {
      "enabled": false
    },
    "sessions": {
      "visibility": "self"
    },
    "agentToAgent": {
      "enabled": false,
      "allow": []
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "gateway": {
    "mode": "local",
    "port": {{ openclaw_isolated_gateway_port | int }},
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "file",
        "provider": "isolated",
        "id": "/gateway/token"
      },
      "allowTailscale": false,
      "rateLimit": {
        "maxAttempts": 5,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "enabled": false
    },
    "terminal": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        },
        "responses": {
          "enabled": false
        }
      }
    },
    "nodes": {
      "browser": {
        "mode": "off"
      },
      "denyCommands": [
        "system.run",
        "system.which",
        "browser.proxy",
        "camera.snap",
        "camera.clip",
        "screen.record"
      ]
    },
    "reload": {
      "mode": "off"
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "plugins": {
    "allow": [
      "codex"
    ],
    "entries": {
      "codex": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": false,
          "allowConversationAccess": false
        },
        "config": {
          "discovery": {
            "enabled": false
          },
          "computerUse": {
            "enabled": false,
            "autoInstall": false
          },
          "codexPlugins": {
            "enabled": false,
            "allow_all_plugins": false,
            "allow_destructive_actions": false
          },
          "appServer": {
            "mode": "guardian",
            "transport": "websocket",
            "homeScope": "agent",
            "url": {{ ('ws://127.0.0.1:' ~ (openclaw_isolated_codex_port | string)) | to_json }},
            "authToken": {
              "source": "file",
              "provider": "isolated",
              "id": "/codex/appServerToken"
            },
            "remoteWorkspaceRoot": {{ openclaw_isolated_gateway_workspace_dir | to_json }},
            "approvalPolicy": "on-request",
            "sandbox": "workspace-write",
            "approvalsReviewer": "auto_review",
            "codeModeOnly": true
          }
        }
      }
    }
  }
}
