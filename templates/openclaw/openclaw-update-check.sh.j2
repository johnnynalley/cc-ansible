#!/bin/bash
# OpenClaw update check script
# Managed by Ansible - do not edit manually
#
# Checks if a newer version of OpenClaw is available on npm and sends
# an Apprise notification if so.

set -euo pipefail

LOG_TAG="openclaw-update-check"
OPENCLAW_NPM_PREFIX="{{ openclaw_npm_prefix | default('/home/' ~ admin_user ~ '/.npm-global') }}"
OPENCLAW_BIN="${OPENCLAW_NPM_PREFIX}/bin/openclaw"

log() { logger -t "$LOG_TAG" "$*"; echo "$*"; }

CURRENT=$("$OPENCLAW_BIN" --version 2>/dev/null || echo "unknown")
LATEST=$(sudo -iu {{ admin_user }} npm --prefix "$OPENCLAW_NPM_PREFIX" view openclaw version 2>/dev/null || echo "unknown")

if [[ "$CURRENT" == "unknown" || "$LATEST" == "unknown" ]]; then
    log "ERROR: Could not determine OpenClaw versions (current=$CURRENT, latest=$LATEST)"
    exit 1
fi

if [[ "$CURRENT" == "$LATEST" ]]; then
    log "OpenClaw is up to date ($CURRENT)"
    exit 0
fi

log "OpenClaw update available: $CURRENT -> $LATEST"

curl -sf -o /dev/null \
    -X POST "{{ apprise_endpoint }}/notify/{{ apprise_token }}" \
    --form-string "title=[OpenClaw] Update available on $(hostname)" \
    --form-string "body=Current: $CURRENT → Latest: $LATEST
Use the guarded updater so Node/runtime compatibility is checked before the live package is swapped:
  /usr/local/sbin/openclaw-safe-update --tag $LATEST --dry-run
  /usr/local/sbin/openclaw-safe-update --tag $LATEST --yes" \
    --form-string "tag=push-quiet,dbc" \
    --form-string "type=info" \
    --max-time 10 \
    --retry 2 \
    --retry-delay 3 2>/dev/null || log "WARNING: Failed to send notification"
