[Unit]
Description=Plex HDMI TV player
After=network-online.target sound.target
Wants=network-online.target
Conflicts=getty@{{ (plex_appliance_hdmi_tty | default('/dev/tty3')).split('/')[-1] }}.service

[Service]
Type=simple
User={{ plex_appliance_user }}
PAMName=login
TTYPath={{ plex_appliance_hdmi_tty | default('/dev/tty3') }}
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
{% set plex_appliance_runtime_uid = plex_appliance_user_uid | default(ansible_facts.getent_passwd[plex_appliance_user][1]) %}
Environment=XDG_RUNTIME_DIR=/run/user/{{ plex_appliance_runtime_uid }}
Environment=HOME=/home/{{ plex_appliance_user }}
EnvironmentFile=/etc/plex-appliance/plex-appliance.env
WorkingDirectory=/var/lib/plex-appliance
ExecStart=/usr/local/bin/plex-appliance-player
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
SyslogIdentifier=plex-appliance-tv

[Install]
WantedBy=multi-user.target
