#!/bin/bash
# MergerFS branch mount watchdog
# Periodically verifies each protected branch is mounted; attempts remount
# and alerts if it stays missing past threshold.
# Managed by Ansible — do not edit manually.

set -uo pipefail

LOG_TAG="mergerfs-mount-watchdog"
STATE_DIR="/var/lib/mergerfs-mount-watchdog"
RECOVERY_HOOK="/usr/local/sbin/mergerfs-branch-recovered"

FAILURE_THRESHOLD={{ mergerfs_recovery_failure_threshold | default(3) }}
ALERT_DEDUP_SECONDS=$(( {{ mergerfs_recovery_alert_dedup_hours | default(6) }} * 3600 ))

log() { logger -t "$LOG_TAG" "$*"; }

send_alert() {
    local title="$1"
    local body="$2"
    local tag="${3:-{{ mergerfs_recovery_alert_tag | default('push,dbc') }}}"
    curl -sf -o /dev/null \
      -X POST "{{ apprise_endpoint }}/notify/{{ apprise_token }}" \
      --form-string "title=${title}" \
      --form-string "body=${body}" \
      --form-string "tag=${tag}" \
      --form-string "type=warning" \
      --max-time 10 \
      --retry 2 \
      --retry-delay 3 2>/dev/null || true
}

mkdir -p "$STATE_DIR"

get_count() {
    local f="${STATE_DIR}/${1}.count"
    [[ -f "$f" ]] && cat "$f" || echo 0
}

set_count() {
    echo "$2" > "${STATE_DIR}/${1}.count"
}

reset_count() {
    rm -f "${STATE_DIR}/${1}.count"
}

last_alert_age_seconds() {
    local f="${STATE_DIR}/${1}.last_alert"
    if [[ -f "$f" ]]; then
        local then now
        then=$(cat "$f")
        now=$(date +%s)
        echo $(( now - then ))
    else
        echo 999999999
    fi
}

mark_alerted() {
    date +%s > "${STATE_DIR}/${1}.last_alert"
}

branch_is_healthy() {
    local name="$1"
    local mount_path="$2"
    local device_uuid="$3"
    local source options expected actual

    if ! source=$(findmnt -rn "$mount_path" -o SOURCE 2>/dev/null); then
        log "${name} is not mounted at ${mount_path}"
        return 1
    fi

    options=$(findmnt -rn "$mount_path" -o OPTIONS 2>/dev/null || true)
    if [[ "$options" == *shutdown* ]]; then
        log "${name} is mounted at ${mount_path} but ext4 reports shutdown options: ${options}"
        return 1
    fi

    if [[ -n "$device_uuid" ]]; then
        expected=$(readlink -f "/dev/disk/by-uuid/${device_uuid}" 2>/dev/null || true)
        if [[ -z "$expected" ]]; then
            log "${name} UUID ${device_uuid} is not present under /dev/disk/by-uuid"
            return 1
        fi

        actual=$(readlink -f "$source" 2>/dev/null || true)
        if [[ -z "$actual" || "$actual" != "$expected" ]]; then
            log "${name} source mismatch: mounted source ${source} resolves to ${actual:-unknown}, UUID resolves to ${expected}"
            return 1
        fi
    fi

    if ! timeout 5 ls -la "$mount_path" >/dev/null 2>&1; then
        log "${name} is mounted at ${mount_path} but directory read failed"
        return 1
    fi
}

# Check each protected branch
{% for branch in mergerfs_recovery_branches %}

# --- {{ branch.name }} ({{ branch.mount_path }}) ---
if branch_is_healthy "{{ branch.name }}" "{{ branch.mount_path }}" "{{ branch.device_uuid | default('') }}"; then
    # Mount is healthy. If we'd been failing, log recovery and call hook.
    prev=$(get_count "{{ branch.name }}")
    if [[ "$prev" -gt 0 ]]; then
        log "{{ branch.name }} recovered after ${prev} failed checks"
        reset_count "{{ branch.name }}"
        "$RECOVERY_HOOK" "{{ branch.name }}" || true
    fi
else
    # Mount is missing or unhealthy — increment counter, attempt remount
    new_count=$(( $(get_count "{{ branch.name }}") + 1 ))
    set_count "{{ branch.name }}" "$new_count"
    log "{{ branch.name }} missing or unhealthy (failure ${new_count}/${FAILURE_THRESHOLD}) — attempting systemctl start {{ branch.mount_unit }}"

    if systemctl start "{{ branch.mount_unit }}" 2>/dev/null; then
        # Verify it actually mounted
        sleep 2
        if branch_is_healthy "{{ branch.name }}" "{{ branch.mount_path }}" "{{ branch.device_uuid | default('') }}"; then
            log "{{ branch.name }} remounted successfully"
            reset_count "{{ branch.name }}"
            "$RECOVERY_HOOK" "{{ branch.name }}" || true
        else
            log "{{ branch.name }} systemctl start succeeded but branch is still unhealthy"
        fi
    else
        log "{{ branch.name }} systemctl start failed — device probably absent or zombie mount needs manual repair"
    fi

    # Alert if past threshold AND not recently alerted
    if [[ "$new_count" -ge "$FAILURE_THRESHOLD" ]]; then
        if [[ $(last_alert_age_seconds "{{ branch.name }}") -ge "$ALERT_DEDUP_SECONDS" ]]; then
            send_alert \
              "MergerFS branch missing: {{ branch.name }}" \
              "{{ branch.mount_path }} has been missing or unhealthy for ${new_count} consecutive checks ({{ branch.mount_unit }}). Device may be disconnected or mounted as an ext4 shutdown zombie. Do not rescan media apps until the branch is verified healthy."
            mark_alerted "{{ branch.name }}"
            log "{{ branch.name }} alert sent"
        else
            log "{{ branch.name }} past threshold but alert deduped (last alert <{{ mergerfs_recovery_alert_dedup_hours | default(6) }}h ago)"
        fi
    fi
fi
{% endfor %}

exit 0
