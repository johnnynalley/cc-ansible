#!/usr/bin/env bash
set -euo pipefail

ACTION="${SSH_ORIGINAL_COMMAND:-${1:-}}"
case "$ACTION" in
  start|stop) ;;
  *)
    echo "allowed commands: start, stop" >&2
    exit 2
    ;;
esac

running_services() {
  docker compose ps --services --status running "$@"
}

all_stopped() {
  local services
  if ! services="$(running_services "$@")"; then
    echo "docker compose ps failed in $path" >&2
    return 1
  fi
  [[ -z "$services" ]]
}

compose_action() (
  local path="$1"
  shift
  cd "$path"

  if [[ "$ACTION" == "start" ]]; then
    docker compose start "$@"
    return
  fi

  for attempt in 1 2; do
    if docker compose stop --timeout 60 "$@"; then
      if all_stopped "$@"; then
        return
      fi
      echo "docker compose stop returned success, but some services are still running in $path" >&2
    else
      rc=$?
      echo "docker compose stop failed in $path on attempt $attempt with rc=$rc; verifying state" >&2
      if all_stopped "$@"; then
        return
      fi
    fi

    if [[ "$attempt" -lt 2 ]]; then
      sleep 5
    fi
  done

  echo "services still running in $path after stop attempts:" >&2
  running_services "$@" >&2
  return 1
)

if [[ "$ACTION" == "stop" ]]; then
{% for target in mergerfs_balance_media_stack_compose_targets | default([]) %}
compose_action {{ target.path | quote }}{% for service in target.services | default([]) %} {{ service | quote }}{% endfor %}{{ '\n' }}
{% endfor %}
else
  failures=0
{% for start_target in mergerfs_balance_media_stack_compose_targets | default([]) %}
  if ! compose_action {{ start_target.path | quote }}{% for service in start_target.services | default([]) %} {{ service | quote }}{% endfor %}; then
    failures=$((failures + 1))
  fi
{% endfor %}
  exit "$failures"
fi
