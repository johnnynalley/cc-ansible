#!/usr/bin/env python3
"""Fullscreen Plex collection shuffle player for a dedicated TV appliance."""

import os
import json
import random
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time
from typing import Any, Dict, Iterable, List, Optional, Set, Tuple
from urllib.parse import urlencode
import xml.etree.ElementTree as ET

import requests


PLEX_URL = os.environ["PLEX_APPLIANCE_SERVER_URL"].rstrip("/")
TOKEN = os.environ["PLEX_APPLIANCE_TOKEN"]
LIBRARY = os.environ["PLEX_APPLIANCE_LIBRARY"]
COLLECTION = os.environ["PLEX_APPLIANCE_COLLECTION"]
AUDIO_LANGUAGES = [lang.strip() for lang in os.environ.get("PLEX_APPLIANCE_AUDIO_LANGUAGES", "").split(",") if lang.strip()]
SUBTITLE_LANGUAGES = [lang.strip() for lang in os.environ.get("PLEX_APPLIANCE_SUBTITLE_LANGUAGES", "").split(",") if lang.strip()]
SUBTITLE_MODE = os.environ.get("PLEX_APPLIANCE_SUBTITLES", "auto").strip().lower()
PAGE_SIZE = int(os.environ.get("PLEX_APPLIANCE_PAGE_SIZE", "100"))
SERVER_RETRY_SECONDS = int(os.environ.get("PLEX_APPLIANCE_SERVER_RETRY_SECONDS", "30"))
ITEM_FAILURE_DELAY_SECONDS = int(os.environ.get("PLEX_APPLIANCE_ITEM_FAILURE_DELAY_SECONDS", "10"))
COLLECTION_REFRESH_SECONDS = int(os.environ.get("PLEX_APPLIANCE_COLLECTION_REFRESH_SECONDS", "3600"))
SHUFFLE_STATE_PATH = os.environ.get("PLEX_APPLIANCE_SHUFFLE_STATE_PATH", "/var/lib/plex-appliance/shuffle-state.json")
PLAYBACK_PROGRESS_SECONDS = max(1, int(os.environ.get("PLEX_APPLIANCE_PLAYBACK_PROGRESS_SECONDS", "5")))
RESUME_REWIND_SECONDS = max(0, int(os.environ.get("PLEX_APPLIANCE_RESUME_REWIND_SECONDS", "10")))
RESUME_END_THRESHOLD_SECONDS = max(0, int(os.environ.get("PLEX_APPLIANCE_RESUME_END_THRESHOLD_SECONDS", "30")))
STREAM_PRESTART_TIMEOUT_SECONDS = max(3, int(os.environ.get("PLEX_APPLIANCE_STREAM_PRESTART_TIMEOUT_SECONDS", "12")))
MPV_START_TIMEOUT_SECONDS = max(5, int(os.environ.get("PLEX_APPLIANCE_MPV_START_TIMEOUT_SECONDS", "45")))
MPV_STALL_TIMEOUT_SECONDS = max(MPV_START_TIMEOUT_SECONDS, int(os.environ.get("PLEX_APPLIANCE_MPV_STALL_TIMEOUT_SECONDS", "120")))
PLAYBACK_FAILURE_SKIP_THRESHOLD = max(1, int(os.environ.get("PLEX_APPLIANCE_PLAYBACK_FAILURE_SKIP_THRESHOLD", "3")))
PLAYBACK_FAILURE_POSITION_WINDOW_SECONDS = max(1, int(os.environ.get("PLEX_APPLIANCE_PLAYBACK_FAILURE_POSITION_WINDOW_SECONDS", "5")))
CORRUPT_MEDIA_LOG_PATH = os.environ.get("PLEX_APPLIANCE_CORRUPT_MEDIA_LOG_PATH", "/var/log/plex-appliance/corrupt-media.jsonl")
CORRUPTION_CHECK_ENABLED = os.environ.get("PLEX_APPLIANCE_CORRUPTION_CHECK_ENABLED", "true").lower() == "true"
CORRUPTION_CHECK_REWIND_SECONDS = max(0, int(os.environ.get("PLEX_APPLIANCE_CORRUPTION_CHECK_REWIND_SECONDS", "60")))
CORRUPTION_CHECK_SECONDS = max(10, int(os.environ.get("PLEX_APPLIANCE_CORRUPTION_CHECK_SECONDS", "180")))
CORRUPTION_CHECK_TIMEOUT_SECONDS = max(15, int(os.environ.get("PLEX_APPLIANCE_CORRUPTION_CHECK_TIMEOUT_SECONDS", "120")))
STATUS_SCREEN_ENABLED = os.environ.get("PLEX_APPLIANCE_STATUS_SCREEN", "true").lower() == "true"
STATUS_TTY = os.environ.get("PLEX_APPLIANCE_STATUS_TTY", "/dev/tty").strip() or "/dev/tty"
MPV_ARGS = shlex.split(os.environ.get("PLEX_APPLIANCE_MPV_ARGS", "--fs --no-terminal"))
MPV_EXTRA_ARGS = shlex.split(os.environ.get("PLEX_APPLIANCE_MPV_EXTRA_ARGS", ""))
MPV_SCREEN_NAME = os.environ.get("PLEX_APPLIANCE_MPV_SCREEN_NAME", "").strip()
MPV_AUDIO_DEVICE = os.environ.get("PLEX_APPLIANCE_AUDIO_DEVICE", "").strip()

SESSION = requests.Session()
SESSION.headers.update({
    "Accept": "application/xml",
    "X-Plex-Product": "Plex Appliance",
    "X-Plex-Version": "1.0",
    "X-Plex-Client-Identifier": "cc-ansible-plex-appliance",
    "X-Plex-Device-Name": "Living Room Plex Appliance",
})
RNG = random.SystemRandom()
STATUS_SCREEN_AVAILABLE = True
RETRY_STATE_KEYS = ("failure_count", "failure_position", "failure_reason")


def log(message: str) -> None:
    print(time.strftime("%Y-%m-%d %H:%M:%S"), message, flush=True)


def redact_token(message: object) -> str:
    text = str(message)
    if TOKEN:
        text = text.replace(TOKEN, "<redacted>")
    return re.sub(r"X-Plex-Token=[^&\s]+", "X-Plex-Token=<redacted>", text)


def draw_status_screen(lines: List[str]) -> None:
    global STATUS_SCREEN_AVAILABLE
    if not STATUS_SCREEN_ENABLED or not STATUS_SCREEN_AVAILABLE:
        return

    width = 80
    height = 24
    vertical_padding = max(0, (height - len(lines)) // 2)
    body = "\033[?25l\033[H\033[2J" + ("\n" * vertical_padding)
    body += "\n".join(line[:width].center(width) for line in lines)
    body += "\n"

    try:
        with open(STATUS_TTY, "w", encoding="utf-8", buffering=1) as status_tty:
            status_tty.write(body)
    except Exception as exc:
        STATUS_SCREEN_AVAILABLE = False
        log(f"Could not write status screen to {STATUS_TTY}: {redact_token(exc)}")


def clear_status_screen() -> None:
    draw_status_screen([])


def retry_wait(context: str, exc: object, attempt: int, seconds: int) -> None:
    detail = redact_token(exc)
    if detail:
        log(f"{context}: {detail}; retrying in {seconds}s")
    else:
        log(f"{context}; retrying in {seconds}s")

    for remaining in range(seconds, 0, -1):
        draw_status_screen([
            "Connection to Plex Media Server failed.",
            f"Retrying in {remaining} sec (attempt {attempt})",
            "Playback will resume automatically.",
        ])
        time.sleep(1)


def playback_retry_wait(title: str, seconds: int) -> None:
    log(f"Playback unavailable for {title}; retrying in {seconds}s")
    for remaining in range(seconds, 0, -1):
        draw_status_screen([
            "Playback is not ready yet.",
            f"Retrying in {remaining} sec.",
            "The latest Plex media file will be resolved automatically.",
        ])
        time.sleep(1)
    clear_status_screen()


def playback_loading_status(title: str, detail: str) -> None:
    draw_status_screen([
        "Starting Plex playback.",
        title or "Untitled media",
        detail,
    ])


def plex_url(path: str, params: Optional[Dict[str, object]] = None) -> str:
    query = dict(params or {})
    query["X-Plex-Token"] = TOKEN
    return f"{PLEX_URL}{path}?{urlencode(query)}"


def plex_get(path: str, params: Optional[Dict[str, object]] = None, timeout: int = 20) -> ET.Element:
    response = SESSION.get(plex_url(path, params), timeout=timeout)
    response.raise_for_status()
    return ET.fromstring(response.content)


def wait_for_server() -> None:
    attempt = 1
    failed_once = False
    while True:
        try:
            plex_get("/identity", timeout=5)
            if failed_once:
                draw_status_screen(["Plex Media Server connected.", "Resuming playback..."])
                time.sleep(1)
                clear_status_screen()
            return
        except Exception as exc:
            failed_once = True
            retry_wait("Plex unavailable", exc, attempt, SERVER_RETRY_SECONDS)
            attempt += 1


def children(root: ET.Element) -> List[ET.Element]:
    return list(root.findall("Directory")) + list(root.findall("Video"))


def fetch_paged(path: str, params: Optional[Dict[str, object]] = None) -> List[ET.Element]:
    items: List[ET.Element] = []
    offset = 0
    while True:
        page_params = dict(params or {})
        page_params["X-Plex-Container-Start"] = offset
        page_params["X-Plex-Container-Size"] = PAGE_SIZE
        root = plex_get(path, page_params)
        page_items = children(root)
        items.extend(page_items)

        size = int(root.attrib.get("size", len(page_items)))
        total = int(root.attrib.get("totalSize", offset + size))
        offset += size
        if size <= 0 or offset >= total:
            return items


def find_section_key() -> str:
    root = plex_get("/library/sections/all")
    for directory in root.findall("Directory"):
        if directory.attrib.get("title") == LIBRARY:
            return directory.attrib["key"]
    raise RuntimeError(f"Library not found: {LIBRARY}")


def find_collection_id(section_key: str) -> str:
    collections = fetch_paged(f"/library/sections/{section_key}/collections")
    for collection in collections:
        if collection.attrib.get("title") == COLLECTION:
            return collection.attrib["ratingKey"]
    raise RuntimeError(f"Collection not found in {LIBRARY}: {COLLECTION}")


def fetch_metadata(rating_key: str) -> Optional[ET.Element]:
    root = plex_get(f"/library/metadata/{rating_key}")
    metadata = children(root)
    return metadata[0] if metadata else None


def expand_video_item(item: ET.Element) -> Iterable[ET.Element]:
    item_type = item.attrib.get("type")
    rating_key = item.attrib.get("ratingKey")
    if item_type in {"episode", "movie"}:
        yield item
    elif item_type == "show" and rating_key:
        yield from fetch_paged(f"/library/metadata/{rating_key}/allLeaves")
    elif item_type == "season" and rating_key:
        yield from fetch_paged(f"/library/metadata/{rating_key}/children")


def load_collection_items() -> List[ET.Element]:
    section_key = find_section_key()
    collection_id = find_collection_id(section_key)
    raw_items = fetch_paged(f"/library/collections/{collection_id}/items")
    expanded: List[ET.Element] = []
    for item in raw_items:
        expanded.extend(expand_video_item(item))

    playable = [item for item in expanded if item.attrib.get("ratingKey") or stream_url_for_item(item)]
    if not playable:
        raise RuntimeError(f"No playable items found in collection: {COLLECTION}")
    log(f"Loaded {len(playable)} playable items from {COLLECTION}")
    return playable


def stream_url_for_item(item: ET.Element, refresh_metadata: bool = False) -> Optional[str]:
    stream_info = stream_info_for_item(item, refresh_metadata)
    return stream_info[0] if stream_info else None


def stream_info_for_item(item: ET.Element, refresh_metadata: bool = False) -> Optional[Tuple[str, str, str]]:
    media_parent = item
    if item.attrib.get("ratingKey") and (refresh_metadata or not item.findall("Media")):
        fetched = fetch_metadata(item.attrib["ratingKey"])
        if fetched is not None:
            media_parent = fetched

    for media in media_parent.findall("Media"):
        for part in media.findall("Part"):
            key = part.attrib.get("key")
            if key:
                return plex_url(key), key, part.attrib.get("file", "")
    return None


def item_title(item: ET.Element) -> str:
    parts = [
        item.attrib.get("grandparentTitle"),
        item.attrib.get("parentTitle"),
        item.attrib.get("title"),
    ]
    return " - ".join(part for part in parts if part)


def item_key(item: ET.Element) -> str:
    return item.attrib.get("ratingKey") or item.attrib.get("key") or item_title(item)


def items_by_key(items: List[ET.Element]) -> Dict[str, ET.Element]:
    keyed: Dict[str, ET.Element] = {}
    for item in items:
        key = item_key(item)
        if key and key not in keyed:
            keyed[key] = item
    return keyed


def shuffled_keys(keys: Iterable[str]) -> List[str]:
    queue = list(keys)
    RNG.shuffle(queue)
    return queue


def load_shuffle_state() -> Tuple[List[str], List[str], Optional[Dict[str, Any]]]:
    try:
        with open(SHUFFLE_STATE_PATH, "r", encoding="utf-8") as state_file:
            payload = json.load(state_file)
    except FileNotFoundError:
        return [], [], None
    except Exception as exc:
        log(f"Could not load shuffle state {SHUFFLE_STATE_PATH}: {redact_token(exc)}")
        return [], [], None

    queue = payload.get("queue", [])
    played = payload.get("played", [])
    active = payload.get("active")
    if not isinstance(queue, list) or not isinstance(played, list):
        return [], [], None
    if not isinstance(active, dict) or not active.get("key"):
        active = None
    return [str(key) for key in queue], [str(key) for key in played], active


def save_shuffle_state(
    queue_keys: List[str],
    played_keys: List[str],
    active: Optional[Dict[str, Any]] = None,
) -> None:
    state_dir = os.path.dirname(SHUFFLE_STATE_PATH)
    if state_dir:
        os.makedirs(state_dir, exist_ok=True)
    tmp_path = f"{SHUFFLE_STATE_PATH}.tmp"
    payload = {
        "collection": COLLECTION,
        "queue": queue_keys,
        "played": played_keys,
        "updated_at": int(time.time()),
    }
    if active:
        payload["active"] = active
    with open(tmp_path, "w", encoding="utf-8") as state_file:
        json.dump(payload, state_file, separators=(",", ":"))
    os.replace(tmp_path, SHUFFLE_STATE_PATH)


def insert_randomly(queue_keys: List[str], new_keys: List[str]) -> None:
    for key in shuffled_keys(new_keys):
        queue_keys.insert(RNG.randrange(len(queue_keys) + 1), key)


def reconcile_shuffle_state(
    queue_keys: List[str],
    played_keys: List[str],
    item_keys: Set[str],
    active_key: str = "",
) -> Tuple[List[str], List[str]]:
    queue_keys = [key for key in queue_keys if key in item_keys]
    if active_key:
        queue_keys = [key for key in queue_keys if key != active_key]
    queue_set = set(queue_keys)
    played_keys = [key for key in played_keys if key in item_keys and key not in queue_set]
    known_keys = queue_set | set(played_keys)
    if active_key in item_keys:
        known_keys.add(active_key)
    new_keys = sorted(item_keys - known_keys)

    if new_keys and queue_keys:
        insert_randomly(queue_keys, new_keys)
        log(f"Added {len(new_keys)} new items to the current shuffle cycle")
    elif new_keys:
        queue_keys = shuffled_keys(new_keys)

    if not queue_keys and not active_key:
        last_played = played_keys[-1] if played_keys else ""
        queue_keys = shuffled_keys(item_keys)
        if last_played and len(queue_keys) > 1 and queue_keys[0] == last_played:
            swap_index = RNG.randrange(1, len(queue_keys))
            queue_keys[0], queue_keys[swap_index] = queue_keys[swap_index], queue_keys[0]
        played_keys = []
        log(f"Started a new shuffle cycle with {len(queue_keys)} items")

    log(f"Shuffle state: {len(queue_keys)} queued, {len(played_keys)} already played this cycle")
    return queue_keys, played_keys


def active_item_key(active: Optional[Dict[str, Any]]) -> str:
    if not active:
        return ""
    return str(active.get("key", ""))


def numeric(value: object, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def optional_numeric(value: object) -> Optional[float]:
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    checkpoint = {
        "key": item_key_to_play,
        "title": item_title(item),
        "position": max(0.0, position),
        "duration": max(0.0, duration),
        "updated_at": int(time.time()),
    }
    if previous_active and str(previous_active.get("key", "")) == item_key_to_play:
        for key in RETRY_STATE_KEYS:
            if key in previous_active:
                checkpoint[key] = previous_active[key]
    return checkpoint


def retry_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
    reason: str,
) -> Dict[str, Any]:
    checkpoint = active_checkpoint(item_key_to_play, item, position, duration, previous_active)
    previous_count = 0
    previous_position: Optional[float] = None
    if previous_active and str(previous_active.get("key", "")) == item_key_to_play:
        previous_reason = str(previous_active.get("failure_reason") or "")
        legacy_playback_failure = reason == "playback_failure" and "failure_count" in previous_active and not previous_reason
        if previous_reason == reason or legacy_playback_failure:
            previous_count = int(numeric(previous_active.get("failure_count"), 0.0))
            previous_position = optional_numeric(previous_active.get("failure_position"))

    failure_position = max(0.0, position)
    if previous_position is not None and abs(failure_position - previous_position) <= PLAYBACK_FAILURE_POSITION_WINDOW_SECONDS:
        failure_count = previous_count + 1
    else:
        failure_count = 1

    checkpoint["failure_count"] = failure_count
    checkpoint["failure_position"] = failure_position
    checkpoint["failure_reason"] = reason
    return checkpoint


def failed_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
) -> Dict[str, Any]:
    return retry_active_checkpoint(item_key_to_play, item, position, duration, previous_active, "playback_failure")


def early_exit_active_checkpoint(
    item_key_to_play: str,
    item: ET.Element,
    position: float,
    duration: float,
    previous_active: Optional[Dict[str, Any]],
) -> Dict[str, Any]:
    return retry_active_checkpoint(item_key_to_play, item, position, duration, previous_active, "early_clean_exit")


def parse_progress_time(value: object) -> Optional[float]:
    if not isinstance(value, str):
        return None
    parts = value.strip().split(":")
    if len(parts) != 3:
        return None
    try:
        hours = int(parts[0])
        minutes = int(parts[1])
        seconds = float(parts[2])
    except ValueError:
        return None
    return (hours * 3600) + (minutes * 60) + seconds


def run_corruption_check(item: ET.Element, position: float, duration: float) -> Dict[str, Any]:
    start = max(0.0, position - CORRUPTION_CHECK_REWIND_SECONDS)
    expected_seconds = float(CORRUPTION_CHECK_SECONDS)
    if duration > 0:
        expected_seconds = min(expected_seconds, max(0.0, duration - start))
    result: Dict[str, Any] = {
        "status": "not_run",
        "start": round(start, 3),
        "seconds": round(expected_seconds, 3),
    }
    if not CORRUPTION_CHECK_ENABLED:
        result["reason"] = "disabled"
        return result
    if expected_seconds < 10:
        result["status"] = "inconclusive"
        result["reason"] = "too_close_to_media_end"
        return result

    stream_info = stream_info_for_item(item, refresh_metadata=True)
    if not stream_info:
        result["status"] = "inconclusive"
        result["reason"] = "missing_stream_url"
        return result
    url, part_key, file_path = stream_info
    result["part_key"] = part_key
    result["file"] = file_path

    command = [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "warning",
        "-progress",
        "pipe:1",
        "-nostats",
        "-ss",
        f"{start:.3f}",
        "-t",
        f"{expected_seconds:.3f}",
        "-i",
        url,
        "-map",
        "0:v:0",
        "-map",
        "0:a:0?",
        "-sn",
        "-f",
        "null",
        "-",
    ]
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=CORRUPTION_CHECK_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_not_found"
        return result
    except subprocess.TimeoutExpired as exc:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_timeout"
        result["stderr_tail"] = redact_token(exc.stderr or "")[-1000:]
        return result

    decoded_seconds = 0.0
    for line in completed.stdout.splitlines():
        key, _, value = line.partition("=")
        if key == "out_time":
            parsed = parse_progress_time(value)
            if parsed is not None:
                decoded_seconds = max(decoded_seconds, parsed)
        elif key in {"out_time_us", "out_time_ms"}:
            decoded_seconds = max(decoded_seconds, numeric(value) / 1000000.0)

    stderr = redact_token(completed.stderr or "")
    stderr_lower = stderr.lower()
    corruption_markers = [
        "file ended prematurely",
        "invalid data found",
        "error while decoding",
        "corrupt",
        "header damaged",
        "partial file",
        "invalid nal",
        "input/output error",
    ]
    marker = next((text for text in corruption_markers if text in stderr_lower), "")
    short_decode = expected_seconds - decoded_seconds >= 15 and decoded_seconds < expected_seconds * 0.8
    decoded_expected_window = decoded_seconds >= expected_seconds * 0.8

    result.update({
        "return_code": completed.returncode,
        "decoded_seconds": round(decoded_seconds, 3),
        "stderr_tail": stderr[-1000:],
    })
    if completed.returncode == 0 and decoded_expected_window:
        result["status"] = "passed"
        result["reason"] = "ffmpeg_decoded_expected_window"
        if marker:
            result["warning_marker"] = marker
    elif marker:
        result["status"] = "corrupt"
        result["reason"] = marker
    elif short_decode and duration > start + expected_seconds:
        result["status"] = "corrupt"
        result["reason"] = "decode_ended_before_expected_window"
    else:
        result["status"] = "inconclusive"
        result["reason"] = "ffmpeg_failed_without_corruption_marker" if completed.returncode != 0 else "short_decode_without_corruption_marker"
    return result


def append_corrupt_media_log(
    item_key_to_play: str,
    item: ET.Element,
    checkpoint: Dict[str, Any],
    check: Dict[str, Any],
) -> None:
    log_dir = os.path.dirname(CORRUPT_MEDIA_LOG_PATH)
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
    record = {
        "event": "corrupt_media_verified",
        "timestamp": int(time.time()),
        "collection": COLLECTION,
        "rating_key": item_key_to_play,
        "title": item_title(item),
        "position": round(numeric(checkpoint.get("failure_position"), numeric(checkpoint.get("position"))), 3),
        "duration": round(numeric(checkpoint.get("duration")), 3),
        "failure_count": int(numeric(checkpoint.get("failure_count"), 0.0)),
        "failure_reason": str(checkpoint.get("failure_reason") or "playback_failure"),
        "check": check,
    }
    line = json.dumps(record, sort_keys=True, separators=(",", ":"))
    with open(CORRUPT_MEDIA_LOG_PATH, "a", encoding="utf-8") as failure_log:
        failure_log.write(line + "\n")
    log(f"PLEX_APPLIANCE_CORRUPT_MEDIA {line}")


def append_playback_skip_log(
    item_key_to_play: str,
    item: ET.Element,
    checkpoint: Dict[str, Any],
    check: Dict[str, Any],
    skip_reason: str,
) -> None:
    log_dir = os.path.dirname(CORRUPT_MEDIA_LOG_PATH)
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
    record = {
        "event": "playback_item_skipped",
        "timestamp": int(time.time()),
        "collection": COLLECTION,
        "rating_key": item_key_to_play,
        "title": item_title(item),
        "position": round(numeric(checkpoint.get("failure_position"), numeric(checkpoint.get("position"))), 3),
        "duration": round(numeric(checkpoint.get("duration")), 3),
        "failure_count": int(numeric(checkpoint.get("failure_count"), 0.0)),
        "failure_reason": str(checkpoint.get("failure_reason") or ""),
        "skip_reason": skip_reason,
        "check": check,
    }
    line = json.dumps(record, sort_keys=True, separators=(",", ":"))
    with open(CORRUPT_MEDIA_LOG_PATH, "a", encoding="utf-8") as skip_log:
        skip_log.write(line + "\n")
    log(f"PLEX_APPLIANCE_PLAYBACK_SKIP {line}")


def resume_position(active: Optional[Dict[str, Any]]) -> float:
    if not active:
        return 0.0
    position = max(0.0, numeric(active.get("position")))
    return max(0.0, position - RESUME_REWIND_SECONDS)


def playback_completed(return_code: int, position: float, duration: float) -> bool:
    if return_code != 0:
        return False
    if duration <= 0:
        return True
    return position >= max(0.0, duration - RESUME_END_THRESHOLD_SECONDS)


def playback_args() -> List[str]:
    args = list(MPV_ARGS)
    if MPV_SCREEN_NAME:
        args.append("--screen-name=" + MPV_SCREEN_NAME)
        args.append("--fs-screen-name=" + MPV_SCREEN_NAME)
    if MPV_AUDIO_DEVICE:
        args.append("--audio-device=" + MPV_AUDIO_DEVICE)
    if AUDIO_LANGUAGES:
        args.append("--alang=" + ",".join(AUDIO_LANGUAGES))
    if SUBTITLE_LANGUAGES:
        args.append("--slang=" + ",".join(SUBTITLE_LANGUAGES))
    if SUBTITLE_MODE == "off":
        args.append("--sid=no")
    elif SUBTITLE_MODE != "auto":
        log(f"Unknown subtitle mode {SUBTITLE_MODE!r}; using mpv default")
    args.extend(MPV_EXTRA_ARGS)
    return args


def wait_for_ipc_socket(socket_path: str, timeout: float = 5.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if os.path.exists(socket_path):
            return True
        time.sleep(0.1)
    return os.path.exists(socket_path)


def mpv_raw_property(socket_path: str, name: str) -> object:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.0)
            client.connect(socket_path)
            client.sendall(json.dumps({"command": ["get_property", name]}).encode("utf-8") + b"\n")
            response = b""
            while not response.endswith(b"\n"):
                chunk = client.recv(4096)
                if not chunk:
                    break
                response += chunk
    except OSError:
        return None

    try:
        payload = json.loads(response.decode("utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None
    if payload.get("error") != "success":
        return None
    return payload.get("data")


def mpv_number_property(socket_path: str, name: str) -> Optional[float]:
    value = mpv_raw_property(socket_path, name)
    return numeric(value) if isinstance(value, (int, float)) else None


def mpv_bool_property(socket_path: str, name: str) -> Optional[bool]:
    value = mpv_raw_property(socket_path, name)
    return value if isinstance(value, bool) else None


def stop_mpv_process(process: subprocess.Popen, reason: str) -> int:
    log(reason)
    process.terminate()
    try:
        return process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        log("mpv did not terminate cleanly; killing it")
        process.kill()
        return process.wait(timeout=10)


def stream_ready(url: str, title: str) -> bool:
    playback_loading_status(title, "Checking media file availability...")
    response = None
    try:
        response = SESSION.get(
            url,
            headers={"Range": "bytes=0-0"},
            stream=True,
            timeout=(5, STREAM_PRESTART_TIMEOUT_SECONDS),
        )
        response.raise_for_status()
        for chunk in response.iter_content(chunk_size=1):
            if chunk:
                return True
            break
        return response.status_code in {200, 206}
    except Exception as exc:
        log(f"Media file preflight failed for {title}: {redact_token(exc)}")
        return False
    finally:
        if response is not None:
            response.close()


def play(
    item_key_to_play: str,
    item: ET.Element,
    start_position: float,
    progress_callback,
) -> Tuple[int, float, float]:
    url = stream_url_for_item(item, refresh_metadata=True)
    if not url:
        log(f"Skipping item without stream URL: {item_title(item)}")
        return 0, 0.0, 0.0

    title = item_title(item)
    if start_position > 0:
        log(f"Resuming: {title} at {int(start_position)}s")
    else:
        log(f"Playing: {title}")

    if not stream_ready(url, title):
        return 1, start_position, 0.0

    last_position = max(0.0, start_position)
    duration = 0.0
    with tempfile.TemporaryDirectory(prefix="plex-appliance-mpv-") as runtime_dir:
        socket_path = os.path.join(runtime_dir, "mpv.sock")
        command = ["mpv", *playback_args(), f"--input-ipc-server={socket_path}"]
        if start_position > 0:
            command.append(f"--start={start_position}")
        command.append(url)

        playback_loading_status(title, "Opening video player...")
        process = subprocess.Popen(command)
        wait_for_ipc_socket(socket_path)
        progress_callback(last_position, duration)
        started_at = time.monotonic()
        last_progress_at: Optional[float] = started_at if start_position > 0 else None
        last_seen_position = last_position

        while process.poll() is None:
            time.sleep(PLAYBACK_PROGRESS_SECONDS)
            now = time.monotonic()
            position_value = mpv_number_property(socket_path, "time-pos")
            duration_value = mpv_number_property(socket_path, "duration")
            vo_configured = mpv_bool_property(socket_path, "vo-configured")
            playback_ready = bool(vo_configured) or position_value is not None or duration_value is not None
            if playback_ready and last_progress_at is None:
                last_progress_at = now
                clear_status_screen()
            if position_value is not None:
                if position_value > last_seen_position + 0.5:
                    last_progress_at = now
                last_seen_position = max(last_seen_position, position_value)
                last_position = max(0.0, position_value)
            if duration_value is not None:
                duration = max(0.0, duration_value)
            progress_callback(last_position, duration)

            if not playback_ready and now - started_at >= MPV_START_TIMEOUT_SECONDS:
                stop_mpv_process(
                    process,
                    f"mpv did not configure video within {MPV_START_TIMEOUT_SECONDS}s; retrying",
                )
                break

            paused = mpv_bool_property(socket_path, "pause")
            if (
                last_progress_at is not None
                and paused is not True
                and now - last_progress_at >= MPV_STALL_TIMEOUT_SECONDS
            ):
                stop_mpv_process(
                    process,
                    f"mpv made no playback progress for {MPV_STALL_TIMEOUT_SECONDS}s; retrying",
                )
                break

        return_code = process.wait()
        position_value = mpv_number_property(socket_path, "time-pos")
        duration_value = mpv_number_property(socket_path, "duration")
        if position_value is not None:
            last_position = max(last_position, position_value)
        if duration_value is not None:
            duration = max(duration, duration_value)

    log(f"Player exited with code {return_code}")
    return return_code, last_position, duration


def main() -> int:
    queue_keys, played_keys, active = load_shuffle_state()
    item_map: Dict[str, ET.Element] = {}
    next_refresh = 0.0
    refresh_attempt = 1

    while True:
        wait_for_server()

        now = time.monotonic()
        if (not queue_keys and not active_item_key(active)) or now >= next_refresh:
            try:
                draw_status_screen([
                    "Refreshing Plex collection.",
                    COLLECTION,
                    "Checking for playable items...",
                ])
                item_map = items_by_key(load_collection_items())
                if not item_map:
                    raise RuntimeError(f"No playable items found in collection: {COLLECTION}")
                if active_item_key(active) and active_item_key(active) not in item_map:
                    active = None
                queue_keys, played_keys = reconcile_shuffle_state(
                    queue_keys,
                    played_keys,
                    set(item_map),
                    active_item_key(active),
                )
                save_shuffle_state(queue_keys, played_keys, active)
                next_refresh = now + COLLECTION_REFRESH_SECONDS
                refresh_attempt = 1
            except Exception as exc:
                retry_wait("Failed to refresh collection", exc, refresh_attempt, SERVER_RETRY_SECONDS)
                refresh_attempt += 1
                continue

        item_key_to_play = active_item_key(active)
        existing_checkpoint_position = numeric(active.get("position")) if active else 0.0
        start_position = resume_position(active)
        popped_from_queue = False
        if not item_key_to_play:
            item_key_to_play = queue_keys.pop(0)
            existing_checkpoint_position = 0.0
            start_position = 0.0
            popped_from_queue = True

        item = item_map.get(item_key_to_play)
        if item is None:
            try:
                item = fetch_metadata(item_key_to_play)
            except Exception as exc:
                if popped_from_queue and queue_keys:
                    active = None
                    insert_randomly(queue_keys, [item_key_to_play])
                    save_shuffle_state(queue_keys, played_keys)
                    next_refresh = 0.0
                    log(f"Deferring item with unavailable metadata: {item_key_to_play}: {redact_token(exc)}")
                    playback_retry_wait(f"item {item_key_to_play}", ITEM_FAILURE_DELAY_SECONDS)
                    continue
                if not popped_from_queue:
                    save_shuffle_state(queue_keys, played_keys, active)
                    log(f"Active item metadata unavailable; retrying same item: {item_key_to_play}: {redact_token(exc)}")
                    playback_retry_wait(f"item {item_key_to_play}", ITEM_FAILURE_DELAY_SECONDS)
                    continue
                queue_keys.insert(0, item_key_to_play)
                retry_wait("Failed to fetch episode metadata", exc, refresh_attempt, SERVER_RETRY_SECONDS)
                refresh_attempt += 1
                continue
            if item is None:
                active = None
                save_shuffle_state(queue_keys, played_keys)
                continue
            item_map[item_key_to_play] = item
            refresh_attempt = 1

        previous_active = active

        def save_progress(position: float, duration: float) -> None:
            checkpoint_position = max(position, existing_checkpoint_position)
            save_shuffle_state(
                queue_keys,
                played_keys,
                active_checkpoint(item_key_to_play, item, checkpoint_position, duration, previous_active),
            )

        save_progress(start_position, numeric(active.get("duration")) if active else 0.0)
        try:
            return_code, last_position, duration = play(item_key_to_play, item, start_position, save_progress)
        except Exception as exc:
            log(f"Playback launch failed: {redact_token(exc)}")
            return_code = 1
            last_position = start_position
            duration = numeric(active.get("duration")) if active else 0.0

        retry_after_playback = False
        if playback_completed(return_code, last_position, duration):
            played_keys.append(item_key_to_play)
            active = None
            save_shuffle_state(queue_keys, played_keys)
        else:
            active_position = max(last_position, existing_checkpoint_position)
            if return_code != 0:
                active = failed_active_checkpoint(item_key_to_play, item, active_position, duration, previous_active)
                failure_count = int(numeric(active.get("failure_count"), 0.0))
                if failure_count >= PLAYBACK_FAILURE_SKIP_THRESHOLD:
                    check = run_corruption_check(item, active_position, duration)
                    if check.get("status") == "corrupt":
                        append_corrupt_media_log(item_key_to_play, item, active, check)
                        log(
                            "Skipping verified corrupt media after "
                            f"{failure_count} failed playback attempts: {item_key_to_play}"
                        )
                    else:
                        append_playback_skip_log(
                            item_key_to_play,
                            item,
                            active,
                            check,
                            "repeated_playback_failures_without_verified_corruption",
                        )
                        log(
                            "Skipping item after repeated playback failures without verified corruption: "
                            f"{item_key_to_play}; check_status={check.get('status')} reason={check.get('reason')}"
                        )
                    if item_key_to_play not in played_keys:
                        played_keys.append(item_key_to_play)
                    active = None
                    save_shuffle_state(queue_keys, played_keys)
                else:
                    save_shuffle_state(queue_keys, played_keys, active)
                    log(
                        "Retrying active item after failed playback attempt "
                        f"{failure_count}/{PLAYBACK_FAILURE_SKIP_THRESHOLD}: {item_key_to_play}"
                    )
                    retry_after_playback = True
            else:
                active = early_exit_active_checkpoint(item_key_to_play, item, active_position, duration, previous_active)
                failure_count = int(numeric(active.get("failure_count"), 0.0))
                if failure_count >= PLAYBACK_FAILURE_SKIP_THRESHOLD:
                    check = run_corruption_check(item, active_position, duration)
                    if check.get("status") == "corrupt":
                        append_corrupt_media_log(item_key_to_play, item, active, check)
                        log(
                            "Skipping verified corrupt media after "
                            f"{failure_count} early player exits: {item_key_to_play}"
                        )
                    else:
                        append_playback_skip_log(
                            item_key_to_play,
                            item,
                            active,
                            check,
                            "repeated_early_clean_exits_without_verified_corruption",
                        )
                        log(
                            "Skipping item after repeated early player exits without verified corruption: "
                            f"{item_key_to_play}; check_status={check.get('status')} reason={check.get('reason')}"
                        )
                    if item_key_to_play not in played_keys:
                        played_keys.append(item_key_to_play)
                    active = None
                    save_shuffle_state(queue_keys, played_keys)
                else:
                    save_shuffle_state(queue_keys, played_keys, active)
                    log(
                        "Retrying active item after early player exit "
                        f"{failure_count}/{PLAYBACK_FAILURE_SKIP_THRESHOLD}: {item_key_to_play}"
                    )
                    retry_after_playback = True

        if retry_after_playback:
            playback_retry_wait(item_title(item), ITEM_FAILURE_DELAY_SECONDS)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
