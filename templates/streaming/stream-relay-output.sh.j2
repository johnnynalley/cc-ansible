#!/usr/bin/env bash
set -euo pipefail

output="${1:-${STREAM_RELAY_OUTPUT:-}}"
if [[ -z "$output" ]]; then
  echo "stream-relay-output: missing output name" >&2
  exit 1
fi

retry_seconds="${STREAM_RELAY_OUTPUT_RETRY_SECONDS:-{{ stream_relay_output_retry_seconds | default(10) }}}"

TWITCH_RTMP_URL="${TWITCH_RTMP_URL:-${TWITCH_RTMP_BASE:-{{ stream_relay_twitch_rtmp_base }}}}"
YOUTUBE_RTMP_URL="${YOUTUBE_RTMP_URL:-{{ stream_relay_youtube_rtmp_base }}}"
YOUTUBE_BACKUP_RTMP_URL="${YOUTUBE_BACKUP_RTMP_URL:-{{ stream_relay_youtube_backup_rtmp_base }}}"

case "$output" in
{% for output in stream_relay_outputs | default([]) %}
  {{ output }})
{% if stream_relay_output_fanout_transport | default('udp') == 'tcp' %}
    input_url="${STREAM_RELAY_INPUT_URL:-tcp://127.0.0.1:{{ stream_relay_output_ports[output] }}}"
{% else %}
    input_url="${STREAM_RELAY_INPUT_URL:-udp://127.0.0.1:{{ stream_relay_output_ports[output] }}?fifo_size={{ stream_relay_output_fifo_size | default(50000000) }}&overrun_nonfatal=1}"
{% endif %}
    audio_codec="${STREAM_RELAY_AUDIO_CODEC:-{{ (stream_relay_output_audio_codecs | default({})).get(output, 'copy') }}}"
    audio_filter="${STREAM_RELAY_AUDIO_FILTER:-{{ (stream_relay_output_audio_filters | default({})).get(output, '') }}}"
    audio_maps=(
{% for audio_map in (stream_relay_output_audio_maps | default({})).get(output, ['0:a:0?']) %}
      {{ audio_map | quote }}
{% endfor %}
    )
    ;;
{% endfor %}
  *)
    echo "stream-relay-output: no local feed configured for ${output}" >&2
    exit 1
    ;;
esac

if [[ "$output" == "twitch" ]]; then
  case "${TWITCH_BANDWIDTH_TEST:-{{ stream_relay_twitch_bandwidth_test | lower }}}" in
    1|true|TRUE|yes|YES|on|ON)
      TWITCH_RTMP_QUERY="${TWITCH_RTMP_QUERY:-bandwidthtest=true}"
      ;;
  esac
fi

prefix="$(tr '[:lower:]-' '[:upper:]_' <<< "$output")"
url_var="${prefix}_RTMP_URL"
key_var="${prefix}_STREAM_KEY"
query_var="${prefix}_RTMP_QUERY"
url="${!url_var:-}"
key="${!key_var:-}"
query="${!query_var:-}"

if [[ -z "$key" && "$output" == "youtube_backup" ]]; then
  key="${YOUTUBE_STREAM_KEY:-}"
fi

if [[ -z "$url" || -z "$key" ]]; then
  echo "stream-relay-output: missing ${url_var} or ${key_var}" >&2
  exit 1
fi

full_url="${url%/}/${key}"
if [[ -n "$query" ]]; then
  if [[ "$full_url" == *\?* ]]; then
    full_url="${full_url}&${query}"
  else
    full_url="${full_url}?${query}"
  fi
fi

unset TWITCH_STREAM_KEY YOUTUBE_STREAM_KEY YOUTUBE_BACKUP_STREAM_KEY YOUTUBE_VERTICAL_STREAM_KEY

audio_args=()
if [[ "$audio_codec" == "copy" ]]; then
  audio_args=(-c:a copy)
else
  if [[ -n "$audio_filter" ]]; then
    audio_args+=(-af "$audio_filter")
  fi
  audio_args+=(-c:a "$audio_codec" -b:a {{ stream_relay_audio_bitrate }} -ar {{ stream_relay_audio_sample_rate }} -ac 2)
fi
map_args=(-map 0:v:0)
for audio_map in "${audio_maps[@]}"; do
  map_args+=(-map "$audio_map")
done

while true; do
  echo "stream-relay-output: ${output} reading ${input_url}" >&2
  set +e
  /usr/bin/ffmpeg \
    -hide_banner \
    -nostdin \
    -loglevel warning \
    -stats_period 30 \
    -i "$input_url" \
    "${map_args[@]}" \
    -c:v copy \
    "${audio_args[@]}" \
    -f flv \
    "$full_url"
  ffmpeg_status=$?
  set -e

  echo "stream-relay-output: ${output} ffmpeg exited with status ${ffmpeg_status}; retrying in ${retry_seconds}s" >&2
  sleep "$retry_seconds"
done
