[Unit]
Description=MediaMTX local RTMP broker for stream relay
After=network-online.target
Wants=network-online.target
Documentation=https://mediamtx.org/

[Service]
Type=simple
User=mediamtx
Group=mediamtx
ExecStart=/usr/local/sbin/mediamtx /etc/mediamtx/stream-relay-broker.yml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
