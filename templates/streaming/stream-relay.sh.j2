#!/usr/bin/env bash
set -euo pipefail

srt_url="srt://{{ stream_relay_ingest_bind }}:{{ stream_relay_ingest_port }}?mode=listener&transtype=live&latency={{ stream_relay_ingest_latency_us }}{% if stream_relay_ingest_rcvbuf is defined %}&rcvbuf={{ stream_relay_ingest_rcvbuf }}{% endif %}{% if stream_relay_ingest_ffs is defined %}&ffs={{ stream_relay_ingest_ffs }}{% endif %}"
keyframe_frames=$(( {{ stream_relay_video_fps }} * {{ stream_relay_keyframe_interval_seconds }} ))
tee_outputs=()
recording_incoming=""
recording_ready=""
recording_discarded=""
recording_min_valid_bytes="{{ stream_relay_recording_min_valid_bytes | default(1048576) }}"
producer_audio_maps=(
{% for audio_map in stream_relay_audio_maps | default(['0:a:0?']) %}
  {{ audio_map | quote }}
{% endfor %}
)

{% for output in stream_relay_outputs | default([]) %}
{% if stream_relay_output_fanout_transport | default('udp') == 'tcp' %}
tee_outputs+=("[f=mpegts:onfail=ignore]tcp://127.0.0.1:{{ stream_relay_output_ports[output] }}?listen=1")
{% else %}
tee_outputs+=("[f=mpegts:onfail=ignore]udp://127.0.0.1:{{ stream_relay_output_ports[output] }}?pkt_size=1316")
{% endif %}
{% endfor %}

{% if stream_relay_recording_enabled | default(false) | bool %}
recording_spool="{{ stream_relay_recording_spool_mount }}"
if mountpoint -q "$recording_spool"; then
  recording_base="{{ stream_relay_recording_file_prefix | default('stream') }}-$(date '+%Y-%m-%d_%H-%M-%S')"
  mkdir -p \
    "$recording_spool/incoming" \
    "$recording_spool/ready" \
    "$recording_spool/remuxing" \
    "$recording_spool/remuxed" \
    "$recording_spool/failed" \
    "$recording_spool/discarded"
  recording_incoming="$recording_spool/incoming/${recording_base}.ts.recording"
  recording_ready="$recording_spool/ready/${recording_base}.ts"
  recording_discarded="$recording_spool/discarded/${recording_base}.ts.discarded"
  recording_tee_options="f=mpegts:onfail=ignore"
{% if stream_relay_recording_tee_select is defined and stream_relay_recording_tee_select %}
  recording_tee_options="select='{{ stream_relay_recording_tee_select }}':${recording_tee_options}"
{% endif %}
  tee_outputs+=("[${recording_tee_options}]${recording_incoming}")
  echo "stream-relay: recording local VOD spool ${recording_incoming}" >&2
else
  echo "stream-relay: recording enabled but spool mount unavailable: ${recording_spool}" >&2
fi
{% endif %}

unset TWITCH_STREAM_KEY YOUTUBE_STREAM_KEY YOUTUBE_BACKUP_STREAM_KEY
tee_spec="$(IFS='|'; printf '%s' "${tee_outputs[*]}")"
audio_args=()
{% if stream_relay_audio_codec | default('aac') == 'copy' %}
audio_args=(-c:a copy)
{% else %}
audio_args=(-c:a {{ stream_relay_audio_codec | default('aac') }} -b:a {{ stream_relay_audio_bitrate }} -ar {{ stream_relay_audio_sample_rate }} -ac 2)
{% endif %}
map_args=(-map 0:v:0)
for audio_map in "${producer_audio_maps[@]}"; do
  map_args+=(-map "$audio_map")
done

set +e
/usr/bin/ffmpeg \
  -hide_banner \
  -nostdin \
  -loglevel warning \
  -stats_period 30 \
  -i "$srt_url" \
  "${map_args[@]}" \
  -c:v {{ stream_relay_video_encoder }} \
  -preset {{ stream_relay_video_preset }} \
  -tune {{ stream_relay_video_tune }} \
  -profile:v {{ stream_relay_video_profile }} \
  -pix_fmt yuv420p \
  -r {{ stream_relay_video_fps }} \
  -g "$keyframe_frames" \
  -keyint_min "$keyframe_frames" \
  -bf {{ stream_relay_video_bframes }} \
  -rc cbr \
  -b:v {{ stream_relay_video_bitrate }} \
  -maxrate {{ stream_relay_video_maxrate }} \
  -bufsize {{ stream_relay_video_bufsize }} \
  "${audio_args[@]}" \
  -f tee \
  "$tee_spec"
ffmpeg_status=$?
set -e

if [[ -n "$recording_incoming" && -e "$recording_incoming" ]]; then
  recording_size="$(stat -c '%s' "$recording_incoming" 2>/dev/null || echo 0)"
  if [[ "$recording_size" -ge "$recording_min_valid_bytes" ]]; then
    mv -f "$recording_incoming" "$recording_ready"
    echo "stream-relay: queued VOD for remux ${recording_ready}" >&2
    systemctl start stream-vod-mover.service >/dev/null 2>&1 || true
  else
    mv -f "$recording_incoming" "$recording_discarded"
    echo "stream-relay: discarded tiny VOD fragment ${recording_discarded} (${recording_size} bytes)" >&2
  fi
fi

exit "$ffmpeg_status"
