[Unit]
Description=Stream relay output worker for %i
Documentation=file:/etc/stream-relay/stream-relay.env.example
After=network-online.target stream-relay.service
Wants=network-online.target stream-relay.service

[Service]
Type=simple
EnvironmentFile=-{{ stream_relay_env_file }}
Environment=STREAM_RELAY_OUTPUT=%i
ExecStartPre=/bin/sh -c 'test -r "{{ stream_relay_env_file }}"'
ExecStart=/usr/local/sbin/stream-relay-output %i
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stream-relay-output-%i

[Install]
WantedBy=multi-user.target
