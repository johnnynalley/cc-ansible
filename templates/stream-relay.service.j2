[Unit]
Description=OBS SRT to streaming platform fanout producer
Documentation=file:/etc/stream-relay/stream-relay.env.example
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-{{ stream_relay_env_file }}
ExecStartPre=/bin/sh -c 'test -r "{{ stream_relay_env_file }}"'
ExecStart=/usr/local/sbin/stream-relay
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stream-relay

[Install]
WantedBy=multi-user.target
