#!/usr/bin/env bash
set -euo pipefail

ALERT_MODE=1
STATUS_MODE=0
for arg in "$@"; do
  case "$arg" in
    --no-alert)
      ALERT_MODE=0
      ;;
    --status)
      STATUS_MODE=1
      ;;
    *)
      printf 'unknown argument: %s\n' "$arg" >&2
      exit 64
      ;;
  esac
done

HOSTNAME="$(hostname)"
STATE_DIR="{{ media_stack_health_state_dir | default('/var/lib/media-stack-health') }}"
ALERT_COOLDOWN_SECONDS="{{ media_stack_health_alert_cooldown_seconds | default(1800) }}"
STATUS_STALE_SECONDS="{{ media_stack_health_status_stale_seconds | default(900) }}"
APPRISE_ENDPOINT="{{ apprise_endpoint }}"
APPRISE_TOKEN="{{ apprise_token }}"
APPRISE_TAGS="{{ media_stack_health_alert_tags | default(apprise_alert_tags) }}"
QBIT_ENV_FILE="{{ media_stack_health_qbit_env_file | default('/etc/qbit-port-sync.env') }}"
HTTP_MAX_TIME="{{ media_stack_health_http_max_time | default(20) }}"
CONSECUTIVE_FAILURE_THRESHOLD="{{ media_stack_health_consecutive_failure_threshold | default(2) }}"
HARDLINK_CONTAINER="{{ media_stack_health_hardlink_container | default('sonarr') }}"
HARDLINK_SOURCE_DIR="{{ media_stack_health_hardlink_source_dir | default('/data/downloads/complete') }}"
HARDLINK_TARGET_DIR="{{ media_stack_health_hardlink_target_dir | default('/data/Anime') }}"
LIBRARY_PROBE_PATH="{{ media_stack_health_library_probe_path | default('/srv/media/plex/Movies') }}"
DATA_HOST_ROOT="{{ media_stack_health_data_host_root | default('/srv/media/plex') }}"
QBIT_IMPORT_AUDIT_ENABLED="{{ media_stack_health_qbit_import_audit_enabled | default(true) }}"
QBIT_IMPORT_AUDIT_HOURS="{{ media_stack_health_qbit_import_audit_hours | default(24) }}"
QBIT_IMPORT_AUDIT_MAX_RECORDS="{{ media_stack_health_qbit_import_audit_max_records | default(200) }}"
QBIT_IMPORT_AUDIT_FAIL_ON_COPY="{{ media_stack_health_qbit_import_audit_fail_on_copy | default(false) }}"
NFS_FILEID_CHECK_ENABLED="{{ media_stack_health_nfs_fileid_check_enabled | default(true) }}"
NFS_FILEID_WINDOW_SECONDS="{{ media_stack_health_nfs_fileid_window_seconds | default(1800) }}"
NFS_FILEID_THRESHOLD="{{ media_stack_health_nfs_fileid_threshold | default(10) }}"
DSTATE_CHECK_ENABLED="{{ media_stack_health_dstate_check_enabled | default(true) }}"
DSTATE_MIN_AGE_SECONDS="{{ media_stack_health_dstate_min_age_seconds | default(600) }}"
DSTATE_COMMAND_REGEX="{{ media_stack_health_dstate_command_regex | default('(/app/(radarr|sonarr)/bin/ffprobe|ffprobe .* /data/|mediainfo .* /data/)') }}"
ARR_COMMAND_CHECK_ENABLED="{{ media_stack_health_arr_command_check_enabled | default(true) }}"
ARR_COMMAND_STARTED_STALE_SECONDS="{{ media_stack_health_arr_command_started_stale_seconds | default(3600) }}"
ARR_COMMAND_QUEUED_STALE_SECONDS="{{ media_stack_health_arr_command_queued_stale_seconds | default(7200) }}"
ARR_COMMAND_NO_PROGRESS_SECONDS="{{ media_stack_health_arr_command_no_progress_seconds | default(1800) }}"
STATUS_FILE="$STATE_DIR/status.env"
PROBLEMS_FILE="$STATE_DIR/problems.txt"
WARNINGS_FILE="$STATE_DIR/warnings.txt"
RUNNING_FILE="$STATE_DIR/running"

mkdir -p "$STATE_DIR"

problems=()
warnings=()

write_status() {
  local status="$1"
  local body="${2:-}"
  local warning_body="${3:-}"
  local now

  now="$(date +%s)"
  if [[ -n "$body" ]]; then
    printf '%s\n' "$body" > "${PROBLEMS_FILE}.tmp"
  else
    : > "${PROBLEMS_FILE}.tmp"
  fi
  mv "${PROBLEMS_FILE}.tmp" "$PROBLEMS_FILE"

  if [[ -n "$warning_body" ]]; then
    printf '%s\n' "$warning_body" > "${WARNINGS_FILE}.tmp"
  else
    : > "${WARNINGS_FILE}.tmp"
  fi
  mv "${WARNINGS_FILE}.tmp" "$WARNINGS_FILE"

  {
    printf 'STATUS=%q\n' "$status"
    printf 'TIMESTAMP=%q\n' "$now"
    printf 'HOSTNAME=%q\n' "$HOSTNAME"
  } > "${STATUS_FILE}.tmp"
  mv "${STATUS_FILE}.tmp" "$STATUS_FILE"
}

show_cached_status() {
  local now
  local age
  local running_started
  local running_age

  now="$(date +%s)"

  if [[ -f "$RUNNING_FILE" ]]; then
    running_started="$(cat "$RUNNING_FILE" 2>/dev/null || echo 0)"
    if [[ "$running_started" =~ ^[0-9]+$ ]]; then
      running_age=$((now - running_started))
      if (( running_age > STATUS_STALE_SECONDS )); then
        printf 'CRITICAL: media-stack health probe has been running for %ss, stale threshold is %ss\n' "$running_age" "$STATUS_STALE_SECONDS" >&2
        exit 2
      fi
    fi
  fi

  if [[ ! -r "$STATUS_FILE" ]]; then
    printf 'CRITICAL: no cached media-stack health status found at %s\n' "$STATUS_FILE" >&2
    exit 2
  fi

  # shellcheck disable=SC1090
  . "$STATUS_FILE"

  if [[ -z "${TIMESTAMP:-}" || ! "$TIMESTAMP" =~ ^[0-9]+$ ]]; then
    printf 'CRITICAL: cached media-stack health status has invalid timestamp\n' >&2
    exit 2
  fi

  age=$((now - TIMESTAMP))
  if (( age > STATUS_STALE_SECONDS )); then
    printf 'CRITICAL: cached media-stack health status is stale: age=%ss threshold=%ss\n' "$age" "$STATUS_STALE_SECONDS" >&2
    [[ -s "$PROBLEMS_FILE" ]] && cat "$PROBLEMS_FILE" >&2
    exit 2
  fi

  case "${STATUS:-}" in
    ok)
      printf 'OK: cached media-stack health passed %ss ago\n' "$age"
      if [[ -s "$WARNINGS_FILE" ]]; then
        printf 'WARNINGS:\n'
        cat "$WARNINGS_FILE"
      fi
      ;;
    failed)
      printf 'CRITICAL: cached media-stack health failed %ss ago\n' "$age" >&2
      [[ -s "$PROBLEMS_FILE" ]] && cat "$PROBLEMS_FILE" >&2
      if [[ -s "$WARNINGS_FILE" ]]; then
        printf 'WARNINGS:\n' >&2
        cat "$WARNINGS_FILE" >&2
      fi
      exit 2
      ;;
    *)
      printf 'CRITICAL: cached media-stack health status is unknown: %s\n' "${STATUS:-unset}" >&2
      exit 2
      ;;
  esac
}

if [[ "$STATUS_MODE" -eq 1 ]]; then
  show_cached_status
  exit 0
fi

printf '%s\n' "$(date +%s)" > "$RUNNING_FILE"
trap 'rm -f "$RUNNING_FILE"' EXIT

add_problem() {
  problems+=("$1")
}

add_warning() {
  warnings+=("$1")
}

join_warnings() {
  local item
  local joined=""

  for item in "${warnings[@]}"; do
    if [[ -n "$joined" ]]; then
      joined+=$'\n'
    fi
    joined+="$item"
  done

  printf '%s' "$joined"
}

array_has_items() {
  [[ "$#" -gt 0 ]]
}

is_truthy() {
  case "${1,,}" in
    1|true|yes|on)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

state_key_path() {
  local key="$1"
  local safe_key

  safe_key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9_.-' '_')"
  printf '%s/%s\n' "$STATE_DIR" "$safe_key"
}

clear_failure_state() {
  local key="$1"
  local state_file

  state_file="$(state_key_path "failure-$key")"
  rm -f "$state_file"
}

record_failure_state() {
  local key="$1"
  local threshold="$2"
  local problem_message="$3"
  local warning_message="${4:-}"
  local state_file
  local count=0

  if [[ ! "$threshold" =~ ^[0-9]+$ || "$threshold" -lt 1 ]]; then
    threshold=1
  fi

  state_file="$(state_key_path "failure-$key")"
  if [[ -r "$state_file" ]]; then
    count="$(cat "$state_file" 2>/dev/null || echo 0)"
  fi
  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    count=0
  fi
  count=$((count + 1))
  printf '%s\n' "$count" > "$state_file"

  if (( count >= threshold )); then
    add_problem "$problem_message"
  elif [[ -n "$warning_message" ]]; then
    add_warning "$warning_message"
  fi
}

expected_fstype_matches() {
  local actual="$1"
  local expected="$2"

  case "$expected" in
    "")
      return 0
      ;;
    nfs)
      [[ "$actual" == "nfs" || "$actual" == "nfs4" ]]
      ;;
    *)
      [[ "$actual" == "$expected" ]]
      ;;
  esac
}

check_mount() {
  local path="$1"
  local expected_fstype="$2"
  local require_path="$3"
  local fstype
  local source

  if ! findmnt -rn --target "$path" >/dev/null 2>&1; then
    add_problem "$path is not mounted"
    return
  fi

  fstype="$(findmnt -rn --target "$path" -o FSTYPE 2>/dev/null | tail -n1 || true)"
  source="$(findmnt -rn --target "$path" -o SOURCE 2>/dev/null | tail -n1 || true)"

  if ! expected_fstype_matches "$fstype" "$expected_fstype"; then
    add_problem "$path has fstype ${fstype:-unknown} from ${source:-unknown}, expected $expected_fstype"
  fi

  if [[ -n "$require_path" && ! -e "$require_path" ]]; then
    add_problem "$path is mounted but required path is missing: $require_path"
  fi
}

check_library_probe() {
  local path="$1"

  if [[ -z "$path" ]]; then
    return
  fi
  if [[ ! -d "$path" ]]; then
    add_problem "media library probe path is missing: $path"
    return
  fi
  if ! find "$path" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null | grep -q .; then
    add_problem "media library probe path has no visible library directories: $path"
  fi
}

resolve_container() {
  local container="$1"
  local id

  if docker inspect "$container" >/dev/null 2>&1; then
    printf '%s\n' "$container"
    return
  fi

  id="$(docker ps -q \
    --filter "label=com.docker.compose.service=$container" \
    --filter status=running \
    | head -n1)"
  if [[ -n "$id" ]]; then
    printf '%s\n' "$id"
  fi
}

check_container() {
  local container="$1"
  local resolved
  local state
  local health

  resolved="$(resolve_container "$container")"
  if [[ -z "$resolved" ]]; then
    add_problem "$container container is missing"
    return
  fi

  state="$(docker inspect --format {% raw %}'{{.State.Status}}'{% endraw %} "$resolved" 2>/dev/null || true)"
  if [[ "$state" != "running" ]]; then
    clear_failure_state "container-health-$container"
    add_problem "$container container state is ${state:-unknown}"
    return
  fi

  health="$(docker inspect --format {% raw %}'{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}'{% endraw %} "$resolved" 2>/dev/null || true)"
  case "$health" in
    healthy|none)
      clear_failure_state "container-health-$container"
      ;;
    starting)
      record_failure_state \
        "container-health-$container" \
        "$CONSECUTIVE_FAILURE_THRESHOLD" \
        "$container healthcheck is still starting" \
        "$container healthcheck is still starting; waiting for consecutive failure threshold"
      ;;
    *)
      record_failure_state \
        "container-health-$container" \
        "$CONSECUTIVE_FAILURE_THRESHOLD" \
        "$container healthcheck is ${health:-unknown}" \
        "$container healthcheck is ${health:-unknown}; waiting for consecutive failure threshold"
      ;;
  esac
}

check_http() {
  local name="$1"
  local url="$2"
  local code

  code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time "$HTTP_MAX_TIME" "$url" 2>/dev/null || true)"
  case "$code" in
    2*|3*|401|403)
      clear_failure_state "http-$name"
      ;;
    *)
      record_failure_state \
        "http-$name" \
        "$CONSECUTIVE_FAILURE_THRESHOLD" \
        "$name endpoint returned HTTP ${code:-000}: $url" \
        "$name endpoint returned HTTP ${code:-000}: $url; waiting for consecutive failure threshold"
      ;;
  esac
}

check_qbit_port_sync() {
  local required
  local gluetun_port
  local cookie_file
  local login_body
  local login_http_code
  local login_response
  local prefs
  local qbit_port

  if [[ ! -r "$QBIT_ENV_FILE" ]]; then
    add_problem "qBittorrent port-sync env is not readable: $QBIT_ENV_FILE"
    return
  fi

  # shellcheck disable=SC1090
  . "$QBIT_ENV_FILE"

  for required in PORT_FILE QBIT_API QBIT_USER QBIT_PASS; do
    if [[ -z "${!required:-}" ]]; then
      add_problem "qBittorrent port-sync env is missing $required"
      return
    fi
  done

  if [[ ! -r "$PORT_FILE" ]]; then
    add_problem "Gluetun forwarded-port file is not readable: $PORT_FILE"
    return
  fi

  gluetun_port="$(tr -d '[:space:]' < "$PORT_FILE")"
  if [[ -z "$gluetun_port" || ! "$gluetun_port" =~ ^[0-9]+$ ]]; then
    add_problem "Gluetun forwarded-port file has invalid value"
    return
  fi

  cookie_file="$(mktemp)"
  login_body="$(mktemp)"
  trap 'rm -f "$cookie_file" "$login_body"' RETURN

  login_http_code="$(curl -sS --connect-timeout 5 --max-time 10 \
    -o "$login_body" -w "%{http_code}" \
    -c "$cookie_file" -b "$cookie_file" \
    --data-urlencode "username=$QBIT_USER" \
    --data-urlencode "password=$QBIT_PASS" \
    "$QBIT_API/auth/login" 2>/dev/null || true)"
  login_response="$(cat "$login_body")"

  if [[ "$login_response" != "Ok." && "$login_http_code" != "204" ]]; then
    add_problem "qBittorrent API login failed with HTTP ${login_http_code:-000}"
    return
  fi

  prefs="$(curl -sS --max-time 10 -b "$cookie_file" "$QBIT_API/app/preferences" 2>/dev/null || true)"
  qbit_port="$(printf '%s' "$prefs" | sed -n 's/.*"listen_port":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"

  if [[ -z "$qbit_port" ]]; then
    add_problem "could not read qBittorrent listen_port from API"
    return
  fi

  if [[ "$gluetun_port" != "$qbit_port" ]]; then
    add_problem "qBittorrent listen_port is $qbit_port but Gluetun forwarded port is $gluetun_port"
  fi
}

check_hardlinks() {
  local container="$1"
  local source_dir="$2"
  local target_dir="$3"
  local resolved
  local output
  local src_line
  local dst_line
  local src_dev
  local src_inode
  local src_links
  local dst_dev
  local dst_inode
  local dst_links

  resolved="$(resolve_container "$container")"
  if [[ -z "$resolved" ]]; then
    add_problem "hardlink test container is missing: $container"
    return
  fi

  output="$(docker exec --user 1000:1000 "$resolved" sh -c '
    set -eu
    source_dir="$1"
    target_dir="$2"
    if [ ! -d "$source_dir" ]; then
      echo "missing source directory: $source_dir" >&2
      exit 10
    fi
    if [ ! -d "$target_dir" ]; then
      echo "missing target directory: $target_dir" >&2
      exit 11
    fi
    file=".media-stack-health-$(date +%s)-$$"
    trap "rm -f \"$source_dir/$file\" \"$target_dir/$file\"" EXIT
    printf health > "$source_dir/$file"
    ln "$source_dir/$file" "$target_dir/$file"
    stat -c "%d %i %h" "$source_dir/$file" "$target_dir/$file"
  ' sh "$source_dir" "$target_dir" 2>&1)" || {
    add_problem "hardlink test failed between $source_dir and $target_dir: $(printf '%s' "$output" | head -n1)"
    return
  }

  src_line="$(printf '%s\n' "$output" | sed -n '1p')"
  dst_line="$(printf '%s\n' "$output" | sed -n '2p')"
  read -r src_dev src_inode src_links <<< "$src_line"
  read -r dst_dev dst_inode dst_links <<< "$dst_line"

  if [[ -z "${src_dev:-}" || -z "${dst_dev:-}" ]]; then
    add_problem "hardlink test returned incomplete stat output"
    return
  fi

  if [[ "$src_dev" != "$dst_dev" || "$src_inode" != "$dst_inode" || "$src_links" -lt 2 || "$dst_links" -lt 2 ]]; then
    add_problem "hardlink test did not produce same device/inode/link-count across $source_dir and $target_dir"
  fi
}

map_data_path_to_host() {
  local container_path="$1"

  case "$container_path" in
    /data/*)
      printf '%s/%s\n' "$DATA_HOST_ROOT" "${container_path#/data/}"
      ;;
    /data)
      printf '%s\n' "$DATA_HOST_ROOT"
      ;;
    *)
      printf '%s\n' "$container_path"
      ;;
  esac
}

read_arr_api_key() {
  local container="$1"
  local resolved

  resolved="$(resolve_container "$container")"
  if [[ -z "$resolved" ]]; then
    return 1
  fi

  docker exec "$resolved" sed -n 's:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p' /config/config.xml 2>/dev/null | head -n1
}

check_qbit_import_audit_app() {
  local app="$1"
  local port="$2"
  local key
  local since
  local response
  local records
  local checked=0
  local hardlink_like=0
  local copied=0
  local missing=0
  local invalid=0
  local sample_count=0
  local samples=()
  local date
  local title
  local dropped_path
  local imported_path
  local dropped_host
  local imported_host
  local src_stat
  local dst_stat
  local src_dev
  local src_inode
  local src_links
  local src_size
  local dst_dev
  local dst_inode
  local dst_links
  local dst_size
  local message

  key="$(read_arr_api_key "$app" || true)"
  if [[ -z "$key" ]]; then
    add_warning "qBittorrent import audit could not read $app API key"
    return
  fi

  since="$(date -u -d "${QBIT_IMPORT_AUDIT_HOURS} hours ago" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  if [[ -z "$since" ]]; then
    add_warning "qBittorrent import audit has invalid lookback hours: $QBIT_IMPORT_AUDIT_HOURS"
    return
  fi

  response="$(curl -fsS -H "X-Api-Key: $key" \
    --connect-timeout 3 --max-time "$HTTP_MAX_TIME" \
    "http://127.0.0.1:${port}/api/v3/history/since?date=${since}" 2>/dev/null || true)"
  if [[ -z "$response" ]]; then
    add_warning "qBittorrent import audit could not read $app history"
    return
  fi

  if [[ ! "$QBIT_IMPORT_AUDIT_MAX_RECORDS" =~ ^[0-9]+$ || "$QBIT_IMPORT_AUDIT_MAX_RECORDS" -lt 1 ]]; then
    add_warning "qBittorrent import audit has invalid max records: $QBIT_IMPORT_AUDIT_MAX_RECORDS"
    return
  fi

  records="$(printf '%s' "$response" | jq -r --argjson max "$QBIT_IMPORT_AUDIT_MAX_RECORDS" '
    [
      .[]
      | select(.eventType == "downloadFolderImported")
      | select(((.data.downloadClientName // .downloadClientName // .downloadClient // .data.downloadClient // "") | ascii_downcase | contains("qbittorrent")))
      | [
          (.date // ""),
          (.sourceTitle // ""),
          (.data.droppedPath // ""),
          (.data.importedPath // "")
        ]
    ][0:$max]
    | .[]
    | @tsv
  ' 2>/dev/null || true)"

  while IFS=$'\t' read -r date title dropped_path imported_path; do
    [[ -n "${date:-}" ]] || continue
    checked=$((checked + 1))

    if [[ -z "${dropped_path:-}" || -z "${imported_path:-}" ]]; then
      invalid=$((invalid + 1))
      continue
    fi

    dropped_host="$(map_data_path_to_host "$dropped_path")"
    imported_host="$(map_data_path_to_host "$imported_path")"

    if [[ ! -e "$dropped_host" || ! -e "$imported_host" ]]; then
      missing=$((missing + 1))
      continue
    fi

    src_stat="$(stat -c '%d %i %h %s' "$dropped_host" 2>/dev/null || true)"
    dst_stat="$(stat -c '%d %i %h %s' "$imported_host" 2>/dev/null || true)"
    if [[ -z "$src_stat" || -z "$dst_stat" ]]; then
      invalid=$((invalid + 1))
      continue
    fi

    read -r src_dev src_inode src_links src_size <<< "$src_stat"
    read -r dst_dev dst_inode dst_links dst_size <<< "$dst_stat"

    if [[ "$src_size" != "$dst_size" ]]; then
      copied=$((copied + 1))
      if (( sample_count < 5 )); then
        samples+=("$app size-mismatch $(printf '%s' "$title" | cut -c1-120)")
        sample_count=$((sample_count + 1))
      fi
      continue
    fi

    # MergerFS inodecalc=path-hash can expose different inodes for two names of
    # the same underlying hardlink, so link count is the reliable signal here.
    if [[ "$src_links" -ge 2 && "$dst_links" -ge 2 ]]; then
      hardlink_like=$((hardlink_like + 1))
    else
      copied=$((copied + 1))
      if (( sample_count < 5 )); then
        samples+=("$app src_links=$src_links dst_links=$dst_links $(printf '%s' "$title" | cut -c1-120)")
        sample_count=$((sample_count + 1))
      fi
    fi
  done <<< "$records"

  if (( checked == 0 )); then
    return
  fi

  if (( copied > 0 )); then
    message="qBittorrent import audit found copied imports for $app: copied=$copied hardlink_like=$hardlink_like source_missing=$missing invalid=$invalid lookback=${QBIT_IMPORT_AUDIT_HOURS}h"
    if (( sample_count > 0 )); then
      message+="; samples: $(printf '%s; ' "${samples[@]}")"
    fi

    if is_truthy "$QBIT_IMPORT_AUDIT_FAIL_ON_COPY"; then
      add_problem "$message"
    else
      add_warning "$message"
    fi
  fi
}

check_qbit_import_audit() {
  if ! is_truthy "$QBIT_IMPORT_AUDIT_ENABLED"; then
    return
  fi

  if ! command -v jq >/dev/null 2>&1; then
    add_warning "qBittorrent import audit skipped because jq is not installed"
    return
  fi

  check_qbit_import_audit_app sonarr 8989
  check_qbit_import_audit_app radarr 7878
}

check_nfs_fileid_changed() {
  local now
  local since
  local count

  if ! is_truthy "$NFS_FILEID_CHECK_ENABLED"; then
    return
  fi

  if [[ ! "$NFS_FILEID_WINDOW_SECONDS" =~ ^[0-9]+$ || "$NFS_FILEID_WINDOW_SECONDS" -lt 60 ]]; then
    add_warning "NFS fileid check has invalid window seconds: $NFS_FILEID_WINDOW_SECONDS"
    return
  fi
  if [[ ! "$NFS_FILEID_THRESHOLD" =~ ^[0-9]+$ || "$NFS_FILEID_THRESHOLD" -lt 1 ]]; then
    add_warning "NFS fileid check has invalid threshold: $NFS_FILEID_THRESHOLD"
    return
  fi

  now="$(date +%s)"
  since=$((now - NFS_FILEID_WINDOW_SECONDS))
  count="$(journalctl -k --since "@$since" --no-pager 2>/dev/null \
    | grep -F "NFS: server" \
    | grep -F "fileid changed" \
    | wc -l \
    | tr -d '[:space:]' || true)"
  count="${count:-0}"

  if (( count >= NFS_FILEID_THRESHOLD )); then
    add_problem "NFS fileid changed errors are recurring on $HOSTNAME: count=$count window=${NFS_FILEID_WINDOW_SECONDS}s threshold=$NFS_FILEID_THRESHOLD"
  fi
}

check_dstate_media_probes() {
  local pid
  local etimes
  local stat
  local wchan
  local cmd
  local count=0

  if ! is_truthy "$DSTATE_CHECK_ENABLED"; then
    return
  fi

  if [[ ! "$DSTATE_MIN_AGE_SECONDS" =~ ^[0-9]+$ || "$DSTATE_MIN_AGE_SECONDS" -lt 60 ]]; then
    add_warning "D-state media probe check has invalid minimum age seconds: $DSTATE_MIN_AGE_SECONDS"
    return
  fi

  while read -r pid etimes stat wchan cmd; do
    [[ -n "${pid:-}" ]] || continue
    [[ "$stat" == D* ]] || continue
    [[ "$etimes" =~ ^[0-9]+$ ]] || continue
    (( etimes >= DSTATE_MIN_AGE_SECONDS )) || continue
    [[ "$cmd" =~ $DSTATE_COMMAND_REGEX ]] || continue

    add_problem "media probe stuck in D-state: pid=$pid age=${etimes}s wchan=${wchan:-unknown} cmd=$(printf '%s' "$cmd" | cut -c1-180)"
    count=$((count + 1))
    if (( count >= 5 )); then
      break
    fi
  done < <(ps -eo pid=,etimes=,stat=,wchan=,args= 2>/dev/null || true)
}

check_arr_stalled_commands_app() {
  local app="$1"
  local port="$2"
  local key
  local response
  local rows
  local now
  local id
  local name
  local status
  local stamp
  local message
  local stamp_epoch
  local age
  local threshold
  local progress_dir
  local state_file
  local message_hash
  local last_hash
  local last_change_epoch
  local no_progress_age
  local count=0

  key="$(read_arr_api_key "$app" || true)"
  if [[ -z "$key" ]]; then
    add_warning "Arr stalled-command check could not read $app API key"
    return
  fi

  response="$(curl -fsS -H "X-Api-Key: $key" \
    --connect-timeout 3 --max-time "$HTTP_MAX_TIME" \
    "http://127.0.0.1:${port}/api/v3/command" 2>/dev/null || true)"
  if [[ -z "$response" ]]; then
    add_warning "Arr stalled-command check could not read $app command queue"
    return
  fi

  rows="$(printf '%s' "$response" | jq -r '
    .[]
    | select(.status == "started" or .status == "queued")
    | [
        (.id // ""),
        (.name // ""),
        (.status // ""),
        (if .status == "started" then (.startedOn // .started // .queuedOn // .queued // "") else (.queuedOn // .queued // "") end),
        ((.message // "") | gsub("[\r\n\t]+"; " ") | .[0:160])
      ]
    | @tsv
  ' 2>/dev/null || true)"

  now="$(date -u +%s)"
  progress_dir="$STATE_DIR/arr-command-progress"
  mkdir -p "$progress_dir"
  find "$progress_dir" -type f -mtime +3 -delete 2>/dev/null || true

  while IFS=$'\t' read -r id name status stamp message; do
    [[ -n "${id:-}" ]] || continue
    [[ -n "${stamp:-}" ]] || continue

    stamp_epoch="$(date -u -d "$stamp" +%s 2>/dev/null || true)"
    if [[ -z "$stamp_epoch" || ! "$stamp_epoch" =~ ^[0-9]+$ ]]; then
      continue
    fi

    age=$((now - stamp_epoch))
    if [[ "$status" == "queued" ]]; then
      threshold="$ARR_COMMAND_QUEUED_STALE_SECONDS"
    else
      threshold="$ARR_COMMAND_STARTED_STALE_SECONDS"
    fi
    if [[ ! "$threshold" =~ ^[0-9]+$ || "$threshold" -lt 60 ]]; then
      add_warning "Arr stalled-command check has invalid threshold for $status: $threshold"
      return
    fi

    if (( age < threshold )); then
      continue
    fi

    if [[ "$status" == "queued" ]]; then
      add_problem "$app command appears stalled: id=$id name=$name status=$status age=${age}s threshold=${threshold}s message=${message:-none}"
      count=$((count + 1))
      if (( count >= 5 )); then
        break
      fi
      continue
    fi

    if [[ ! "$ARR_COMMAND_NO_PROGRESS_SECONDS" =~ ^[0-9]+$ || "$ARR_COMMAND_NO_PROGRESS_SECONDS" -lt 60 ]]; then
      add_warning "Arr stalled-command check has invalid no-progress threshold: $ARR_COMMAND_NO_PROGRESS_SECONDS"
      return
    fi

    message_hash="$(printf '%s' "$message" | sha256sum | awk '{print $1}')"
    state_file="$progress_dir/${app}-${id}.env"
    last_hash=""
    last_change_epoch=""
    if [[ -r "$state_file" ]]; then
      # shellcheck disable=SC1090
      . "$state_file"
      last_hash="${LAST_HASH:-}"
      last_change_epoch="${LAST_CHANGE_EPOCH:-}"
    fi

    if [[ "$message_hash" != "$last_hash" || ! "$last_change_epoch" =~ ^[0-9]+$ ]]; then
      {
        printf 'LAST_HASH=%q\n' "$message_hash"
        printf 'LAST_CHANGE_EPOCH=%q\n' "$now"
      } > "${state_file}.tmp"
      mv "${state_file}.tmp" "$state_file"
      continue
    fi

    no_progress_age=$((now - last_change_epoch))
    if (( no_progress_age >= ARR_COMMAND_NO_PROGRESS_SECONDS )); then
      add_problem "$app command appears stalled: id=$id name=$name status=$status age=${age}s threshold=${threshold}s no_progress=${no_progress_age}s no_progress_threshold=${ARR_COMMAND_NO_PROGRESS_SECONDS}s message=${message:-none}"
      count=$((count + 1))
      if (( count >= 5 )); then
        break
      fi
    fi
  done <<< "$rows"
}

check_arr_stalled_commands() {
  if ! is_truthy "$ARR_COMMAND_CHECK_ENABLED"; then
    return
  fi

  if ! command -v jq >/dev/null 2>&1; then
    add_warning "Arr stalled-command check skipped because jq is not installed"
    return
  fi

  check_arr_stalled_commands_app sonarr 8989
  check_arr_stalled_commands_app radarr 7878
}

{% for mount in media_stack_health_mounts | default(media_stack_health_default_mounts) %}
check_mount {{ mount.path | quote }} {{ mount.fstype | default('') | quote }} {{ mount.require_path | default('') | quote }}
{% endfor %}

check_library_probe "$LIBRARY_PROBE_PATH"

{% for container in media_stack_health_containers | default(media_stack_health_default_containers) %}
check_container {{ container | quote }}
{% endfor %}

{% for endpoint in media_stack_health_endpoints | default(media_stack_health_default_endpoints) %}
check_http {{ endpoint.name | quote }} {{ endpoint.url | quote }}
{% endfor %}

check_qbit_port_sync
check_hardlinks "$HARDLINK_CONTAINER" "$HARDLINK_SOURCE_DIR" "$HARDLINK_TARGET_DIR"
check_qbit_import_audit
check_nfs_fileid_changed
check_dstate_media_probes
check_arr_stalled_commands

if ! array_has_items "${problems[@]}"; then
  rm -f "$STATE_DIR/last-alert"
  warning_body="$(join_warnings)"
  write_status ok "" "$warning_body"
  printf 'OK: media-stack health checks passed\n'
  if [[ -n "$warning_body" ]]; then
    printf 'WARNINGS:\n%s\n' "$warning_body"
  fi
  exit 0
fi

body="$(printf '%s\n' "${problems[@]}")"
warning_body="$(join_warnings)"
write_status failed "$body" "$warning_body"
printf 'CRITICAL: media-stack health check failed\n%s\n' "$body" >&2
if [[ -n "$warning_body" ]]; then
  printf 'WARNINGS:\n%s\n' "$warning_body" >&2
fi

if [[ "$ALERT_MODE" -eq 1 ]]; then
  now="$(date +%s)"
  last_alert=0
  if [[ -f "$STATE_DIR/last-alert" ]]; then
    last_alert="$(cat "$STATE_DIR/last-alert" 2>/dev/null || echo 0)"
  fi

  if (( now - last_alert >= ALERT_COOLDOWN_SECONDS )); then
    if curl -sf -o /dev/null \
      -X POST "${APPRISE_ENDPOINT}/notify/${APPRISE_TOKEN}" \
      --form-string "title=[Media Stack] ${HOSTNAME}: health check failed" \
      --form-string "body=${body}" \
      --form-string "tag=${APPRISE_TAGS}" \
      --form-string "type=warning" \
      --max-time 30 \
      --retry 3 \
      --retry-delay 5; then
      printf '%s\n' "$now" > "$STATE_DIR/last-alert"
    fi
  fi
fi

exit 2
