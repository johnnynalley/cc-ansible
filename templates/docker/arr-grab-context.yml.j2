services:
  arr-grab-context:
    image: python:3-alpine
    container_name: arr-grab-context
    command:
      - python3
      - /app/arr_grab_context.py
      - --db
      - /data/arr-grab-context.db
      - --retention-days
      - "{{ media_release_stamper_context_retention_days | default(120) }}"
    user: "{{ media_release_stamper_container_uid | default('1000') }}:{{ media_release_stamper_container_gid | default('1000') }}"
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      SONARR_API: "{{ media_release_stamper_sonarr_api }}"
      SONARR_API_KEY: "{{ media_release_stamper_sonarr_api_key }}"
      RADARR_API: "{{ media_release_stamper_radarr_api }}"
      RADARR_API_KEY: "{{ media_release_stamper_radarr_api_key }}"
    volumes:
      - ./arr_grab_context.py:/app/arr_grab_context.py:ro
      - ./data:/data
    networks:
      - media-stack
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:size=16m,mode=1777
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:9899/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  arr-import-reconciler:
    image: local/arr-import-reconciler:latest
    build:
      context: .
      dockerfile: arr-import-reconciler.Dockerfile
    container_name: arr-import-reconciler
    command:
      - python3
      - /app/arr_import_reconciler.py
      - --interval
      - "{{ media_release_stamper_reconciler_interval | default(60) }}"
      - --event-log
      - /state/arr-import-reconciler-events.jsonl
      - --state
      - /state/arr-import-reconciler-state.json
      - --handoff-mode
      - "{{ media_release_stamper_handoff_mode | default('disabled') }}"
      - --handoff-state
      - /state/arr-terminal-handoff-state.json
      - --min-payload-age
      - "{{ media_release_stamper_handoff_min_payload_age | default(120) }}"
      - --ffprobe-timeout
      - "{{ media_release_stamper_handoff_ffprobe_timeout | default(30) }}"
      - --max-handoffs-per-cycle
      - "{{ media_release_stamper_handoff_max_per_cycle | default(5) }}"
{% if not (media_release_stamper_reconciler_apply | default(false) | bool) %}
      - --dry-run
{% endif %}
    user: "{{ media_release_stamper_container_uid | default('1000') }}:{{ media_release_stamper_container_gid | default('1000') }}"
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      ARR_GRAB_CONTEXT_API: http://arr-grab-context:9899
      SONARR_API: "{{ media_release_stamper_sonarr_api }}"
      SONARR_API_KEY: "{{ media_release_stamper_sonarr_api_key }}"
      RADARR_API: "{{ media_release_stamper_radarr_api }}"
      RADARR_API_KEY: "{{ media_release_stamper_radarr_api_key }}"
      QBIT_API: "{{ media_release_stamper_reconciler_qbit_api | default('http://gluetun:8085/api/v2') }}"
      QBIT_USER: "{{ media_release_stamper_qbit_user }}"
      QBIT_PASS: "{{ media_release_stamper_qbit_password }}"
    volumes:
      - ./arr_import_reconciler.py:/app/arr_import_reconciler.py:ro
      - ./data:/state
      - /srv/media/plex:/data:ro
    networks:
      - media-stack
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:size=16m,mode=1777
    healthcheck:
      test: ["CMD", "python3", "/app/arr_import_reconciler.py", "--check-health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    depends_on:
      arr-grab-context:
        condition: service_healthy
    restart: unless-stopped

networks:
  media-stack:
    external: true
    name: "{{ media_release_stamper_context_network | default('media-stack_default') }}"
