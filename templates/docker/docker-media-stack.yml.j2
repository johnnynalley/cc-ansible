{% set media_stack_log_max_size = media_stack_docker_log_max_size | default('10m') %}
{% set media_stack_log_max_file = media_stack_docker_log_max_file | default('5') %}
x-media-stack-logging: &media_stack_logging
  driver: json-file
  options:
    max-size: "{{ media_stack_log_max_size }}"
    max-file: "{{ media_stack_log_max_file }}"

services:
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./sonarr:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
      - /srv/incomplete_downloads/incomplete/torrents:/incomplete
    ports:
      - 8989:8989
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./radarr:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
      - /srv/incomplete_downloads/incomplete/torrents:/incomplete
    ports:
      - 7878:7878
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./prowlarr:/config
    ports:
      - 9696:9696
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./bazarr:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
    ports:
      - 6767:6767
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    restart: unless-stopped

  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
    volumes:
      - ./sabnzbd:/config
      - /srv/media/plex:/data
      - /srv/archive:/archive
      - /srv/incomplete_downloads/incomplete/usenet:/incomplete
    ports:
      - 8080:8080
    networks:
      - default
      - caddy-proxy
    ulimits:
      nofile:
        soft: {{ media_stack_sabnzbd_nofile_soft | default(65536) }}
        hard: {{ media_stack_sabnzbd_nofile_hard | default(65536) }}
    logging: *media_stack_logging
    restart: unless-stopped

  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY={{ vault_gluetun_wireguard_private_key }}
      - WIREGUARD_MTU=1420
      - SERVER_COUNTRIES=Netherlands
      - VPN_PORT_FORWARDING=on
      - VPN_PORT_FORWARDING_PROVIDER=protonvpn
      - VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c 'echo {% raw %}{{PORTS}}{% endraw %} > /gluetun/forwarded_port'
    ports:
      - 8085:8085
    volumes:
      - ./gluetun:/gluetun
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: "service:gluetun"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
      - WEBUI_PORT=8085
    volumes:
      - ./qbittorrent:/config
      - /srv/incomplete_downloads/incomplete/torrents:/incomplete
      - /srv/media/plex:/data
      - /srv/archive:/archive
    depends_on:
      - gluetun
    logging: *media_stack_logging
    restart: unless-stopped

  byparr:
    image: ghcr.io/thephaseless/byparr:latest
    container_name: byparr
    init: true
    ports:
      - 8191:8191
    environment:
      - TZ=America/Chicago
    networks:
      - default
      - caddy-proxy
    logging: *media_stack_logging
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8191/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped

networks:
  default:
  caddy-proxy:
    external: true
