#!/bin/bash
# Docker container auto-update script
# Managed by Ansible - do not edit manually
#
# Checks for image updates on stacks marked for auto-update in Ansible,
# pulls/builds new images, and recreates containers only if images changed.
# Major version bumps are blocked and trigger a louder notification.
#
# Stacks managed by this script:
{% for stack in docker_stacks %}
{% if stack.auto_update | default(false) %}
#   {{ stack.name }} ({{ stack.path }}) - full stack{% if stack.build | default(false) %} [build]{% endif %}

{% elif stack.auto_update_services is defined and stack.auto_update_services | length > 0 %}
#   {{ stack.name }} ({{ stack.path }}) - services: {{ stack.auto_update_services | join(', ') }}
{% endif %}
{% endfor %}

set -uo pipefail

LOG_TAG="docker-auto-update"
STACK_DIFF="/usr/local/bin/docker-stack-diff"
STATE_DIR="/var/lib/docker-auto-update"
COMPOSE_LOCK_WAIT="{{ docker_auto_update_compose_lock_wait | default(900) }}"
SUMMARY=""
BLOCKED_SUMMARY=""
UPDATE_COUNT=0
BLOCKED_COUNT=0
ERRORS=0

mkdir -p "$STATE_DIR"

log() { logger -t "$LOG_TAG" "$*"; echo "$*"; }

compose_lock_file() {
    local stack_name="$1"
    case "$stack_name" in
        media-stack)
            echo "{{ gluetun_watchdog_compose_lock_file | default('/run/media-stack-compose.lock') }}"
            ;;
        *)
            echo "/run/docker-compose-${stack_name}.lock"
            ;;
    esac
}

run_compose_logged() {
    local stack_name="$1"
    local compose_dir="$2"
    shift 2

    local lock_file
    local output
    local rc

    lock_file=$(compose_lock_file "$stack_name")
    output=$(cd "$compose_dir" && flock -w "$COMPOSE_LOCK_WAIT" "$lock_file" docker compose "$@" 2>&1)
    rc=$?
    while IFS= read -r line; do
        [[ -n "$line" ]] && log "${stack_name}: $line"
    done <<< "$output"

    if [[ "$rc" -ne 0 ]]; then
        log "ERROR: ${stack_name}: docker compose $* failed with exit code $rc"
    fi

    return "$rc"
}

check_required_paths() {
    local stack_name="$1"
    shift

    local path
    local failed=0

    for path in "$@"; do
        if [[ -z "$path" ]]; then
            continue
        fi
        if ! timeout 10 test -e "$path"; then
            log "ERROR: ${stack_name}: required path unavailable before compose recreate: ${path}"
            failed=1
        fi
    done

    return "$failed"
}

{% if docker_stacks | selectattr('auto_update_arr_idle_checks', 'defined') | list | length > 0 %}
ARR_IDLE_GUARD_ERROR=0
check_arr_idle() {
    local stack_name="$1"
    shift

    local spec
    local app_name
    local command_url
    local config_path
    local api_key
    local payload
    local active_commands

    ARR_IDLE_GUARD_ERROR=0
    for spec in "$@"; do
        IFS='|' read -r app_name command_url config_path <<< "$spec"
        api_key=$(sed -n 's:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p' "$config_path" | head -n1)
        if [[ -z "$api_key" ]]; then
            log "ERROR: ${stack_name}: cannot verify ${app_name} activity; API key is absent"
            ARR_IDLE_GUARD_ERROR=1
            return 1
        fi
        if ! payload=$(curl -fsS -H "X-Api-Key: ${api_key}" \
            --connect-timeout 3 --max-time 10 "$command_url"); then
            log "ERROR: ${stack_name}: cannot verify ${app_name} activity; command API failed"
            ARR_IDLE_GUARD_ERROR=1
            return 1
        fi
        if ! active_commands=$(jq -er '
            [
              .[]
              | select(
                  (.status // "" | ascii_downcase) as $status
                  | $status == "queued"
                    or $status == "started"
                    or $status == "running"
                )
              | (.name // "unknown")
            ]
            | unique
            | join(",")
        ' <<< "$payload"); then
            log "ERROR: ${stack_name}: cannot verify ${app_name} activity; invalid command API response"
            ARR_IDLE_GUARD_ERROR=1
            return 1
        fi
        if [[ -n "$active_commands" ]]; then
            log "${stack_name}: update deferred; ${app_name} has active commands: ${active_commands}"
            return 1
        fi
    done

    return 0
}
{% endif -%}
send_notification() {
    local title="$1"
    local body="${2:-}"
    local type="${3:-info}"
    local tag="${4:-{{ docker_auto_update_notify_tag | default('push-quiet') }}}"
    curl -sf -o /dev/null \
      -X POST "{{ apprise_endpoint }}/notify/{{ apprise_token }}" \
      --form-string "title=${title}" \
      --form-string "body=${body}" \
      --form-string "tag=${tag}" \
      --form-string "type=${type}" \
      --max-time 10 \
      --retry 2 \
      --retry-delay 3 2>/dev/null || true
}

# Check if a blocked version pair was already notified (prevents repeat alerts)
is_already_blocked() {
    local state_file="$1"
    local entry="$2"
    [ -f "$state_file" ] && grep -qF "$entry" "$state_file" 2>/dev/null
}

# Record a blocked version pair to the state file
record_blocked() {
    local state_file="$1"
    local entry="$2"
    echo "$entry" >> "$state_file"
}

# Clean up stale entries from state file (services that are now up to date)
cleanup_state() {
    local state_file="$1"
    local diff_output="$2"
    [ ! -f "$state_file" ] && return
    local tmp="${state_file}.tmp"
    while IFS= read -r line; do
        svc=$(echo "$line" | cut -d: -f1)
        # Keep entry only if this service still has a MAJOR: line in diff output
        if echo "$diff_output" | grep -q "^MAJOR:  ${svc}:"; then
            echo "$line"
        fi
    done < "$state_file" > "$tmp"
    mv "$tmp" "$state_file"
}

pull_with_retry() {
    local stack_name="$1"
    local compose_dir="$2"
    shift 2
    local services="$*"
    local attempt=0
    local max_attempts=3
    local delay=10

    while [[ $attempt -lt $max_attempts ]]; do
        attempt=$((attempt + 1))
        # shellcheck disable=SC2086
        if cd "$compose_dir" && flock -w "$COMPOSE_LOCK_WAIT" "$(compose_lock_file "$stack_name")" docker compose pull $services 2>&1; then
            return 0
        fi
        if [[ $attempt -lt $max_attempts ]]; then
            log "Pull failed (attempt $attempt/$max_attempts), retrying in ${delay}s..."
            sleep $delay
        fi
    done
    log "ERROR: Pull failed after $max_attempts attempts"
    return 1
}

build_with_retry() {
    local stack_name="$1"
    local compose_dir="$2"
    local attempt=0
    local max_attempts=3
    local delay=10

    while [[ $attempt -lt $max_attempts ]]; do
        attempt=$((attempt + 1))
        if cd "$compose_dir" && flock -w "$COMPOSE_LOCK_WAIT" "$(compose_lock_file "$stack_name")" docker compose build --pull 2>&1; then
            return 0
        fi
        if [[ $attempt -lt $max_attempts ]]; then
            log "Build failed (attempt $attempt/$max_attempts), retrying in ${delay}s..."
            sleep $delay
        fi
    done
    log "ERROR: Build failed after $max_attempts attempts"
    return 1
}

# =========================================================================
# Process stacks
# =========================================================================

log "Starting Docker auto-update..."

{% for stack in docker_stacks %}
{% if stack.auto_update | default(false) %}
{% set use_major_guard = stack.major_guard | default(docker_auto_update_major_guard | default(true)) %}
# --- {{ stack.name }} (full stack{% if stack.build | default(false) %}, build{% endif %}{% if use_major_guard %}, major guard{% endif %}) ---
log "Checking {{ stack.name }}..."
{% if stack.build | default(false) %}
if build_with_retry "{{ stack.name }}" "{{ stack.path }}"; then
{% else %}
if pull_with_retry "{{ stack.name }}" "{{ stack.path }}"; then
{% endif %}
{% if use_major_guard %}
    diff_output=$("$STACK_DIFF" --check-major "{{ stack.path }}" 2>/dev/null)
    diff_exit=$?
    if [[ -z "$diff_output" || "$diff_output" == *"(no image changes detected)"* ]]; then
        log "{{ stack.name }}: up to date"
    elif [[ $diff_exit -eq 2 ]]; then
        # Major version bump detected — block the entire stack
        major_lines=$(echo "$diff_output" | grep "^MAJOR:" | sed 's/^MAJOR://')
        log "{{ stack.name }}: MAJOR VERSION BUMP BLOCKED"
        log "$major_lines"
        state_file="${STATE_DIR}/blocked-{{ stack.name }}"
        cleanup_state "$state_file" "$diff_output"
        new_blocks=false
        while IFS= read -r major_line; do
            entry=$(echo "$major_line" | sed 's/^  //' | awk '{print $1, $2, $3, $4}')
            if ! is_already_blocked "$state_file" "$entry"; then
                record_blocked "$state_file" "$entry"
                new_blocks=true
            fi
        done <<< "$major_lines"
        if $new_blocks; then
            BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
            BLOCKED_SUMMARY="${BLOCKED_SUMMARY}{{ stack.name }} (BLOCKED - major version bump):\n${major_lines}\n\n"
        else
            log "{{ stack.name }}: already notified for this major bump"
        fi
        # Apply non-major updates if any (only for full-stack, skip if any major present)
        # Skipping entire stack because docker compose up -d would recreate everything
        non_major=$(echo "$diff_output" | grep -v "^MAJOR:" | grep -v "(no image changes detected)")
        if [[ -n "$non_major" ]]; then
            log "{{ stack.name }}: minor updates also available but skipping (stack contains major bump)"
        fi
    else
        log "{{ stack.name }}: updates available, recreating..."
{% if stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        if ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d; then
{% else %}
        if run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d; then
{% endif %}
            UPDATE_COUNT=$((UPDATE_COUNT + 1))
            SUMMARY="${SUMMARY}{{ stack.name }}:\n${diff_output}\n\n"
            # Clear any stale state file (stack is now up to date)
            rm -f "${STATE_DIR}/blocked-{{ stack.name }}"
        else
            ERRORS=$((ERRORS + 1))
        fi
    fi
{% else %}
    diff_output=$("$STACK_DIFF" "{{ stack.path }}" 2>/dev/null || echo "(diff check failed)")
    if [[ "$diff_output" != *"(no image changes detected)"* && "$diff_output" != *"(diff check failed)"* ]]; then
        log "{{ stack.name }}: updates available, recreating..."
{% if stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        if ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d; then
{% else %}
        if run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d; then
{% endif %}
            UPDATE_COUNT=$((UPDATE_COUNT + 1))
            SUMMARY="${SUMMARY}{{ stack.name }}:\n${diff_output}\n\n"
        else
            ERRORS=$((ERRORS + 1))
        fi
    else
        log "{{ stack.name }}: up to date"
    fi
{% endif %}
else
    log "ERROR: {{ stack.name }} pull/build failed"
    ERRORS=$((ERRORS + 1))
fi

{% elif stack.auto_update_services is defined and stack.auto_update_services | length > 0 %}
{% set use_major_guard = stack.major_guard | default(docker_auto_update_major_guard | default(true)) %}
# --- {{ stack.name }} (services: {{ stack.auto_update_services | join(', ') }}{% if use_major_guard %}, major guard{% endif %}) ---
log "Checking {{ stack.name }} ({{ stack.auto_update_services | join(', ') }})..."
if pull_with_retry "{{ stack.name }}" "{{ stack.path }}" "{{ stack.auto_update_services | join(' ') }}"; then
{% if use_major_guard %}
    diff_output=$("$STACK_DIFF" --check-major "{{ stack.path }}" 2>/dev/null)
    diff_exit=$?
    state_file="${STATE_DIR}/blocked-{{ stack.name }}"
    cleanup_state "$state_file" "$diff_output"
{% else %}
    diff_output=$("$STACK_DIFF" "{{ stack.path }}" 2>/dev/null || echo "(diff check failed)")
{% endif %}
{% for svc in stack.auto_update_services %}
{% if use_major_guard %}
    if echo "$diff_output" | grep -q "^MAJOR:  {{ svc }}:"; then
        svc_diff=$(echo "$diff_output" | grep "^MAJOR:  {{ svc }}:" | sed 's/^MAJOR://')
        log "{{ stack.name }}/{{ svc }}: MAJOR VERSION BUMP BLOCKED ($svc_diff)"
        entry=$(echo "$svc_diff" | sed 's/^  //' | awk '{print $1, $2, $3, $4}')
        if ! is_already_blocked "$state_file" "$entry"; then
            record_blocked "$state_file" "$entry"
            BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
            BLOCKED_SUMMARY="${BLOCKED_SUMMARY}{{ stack.name }}/{{ svc }} (BLOCKED):\n${svc_diff}\n\n"
        else
            log "{{ stack.name }}/{{ svc }}: already notified for this major bump"
        fi
    elif echo "$diff_output" | grep -q "^  {{ svc }}:"; then
{% else %}
    if echo "$diff_output" | grep -q "^  {{ svc }}:"; then
{% endif %}
        svc_diff=$(echo "$diff_output" | grep "^  {{ svc }}:")
        log "{{ stack.name }}/{{ svc }}: update available ($svc_diff)"
{% if svc == 'gluetun' %}
        # Gluetun: force-recreate to clear network namespace (stale tun0 routes)
        # Dependent containers share the namespace and must be recreated together
        log "{{ stack.name }}/{{ svc }}: force-recreating with dependents..."
{% if stack.auto_update_arr_idle_checks is defined and stack.auto_update_arr_idle_checks | length > 0 %}
        if ! check_arr_idle "{{ stack.name }}" {% for check in stack.auto_update_arr_idle_checks %}{{ (check.name ~ '|' ~ check.url ~ '|' ~ check.config_path) | quote }} {% endfor %}; then
            if [[ "$ARR_IDLE_GUARD_ERROR" -ne 0 ]]; then
                ERRORS=$((ERRORS + 1))
            fi
{% if stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        elif ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d --force-recreate {{ svc }} {{ gluetun_watchdog_dependent_containers | default('qbittorrent') }}; then
{% else %}
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d --force-recreate {{ svc }} {{ gluetun_watchdog_dependent_containers | default('qbittorrent') }}; then
{% endif %}
{% elif stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        if ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d --force-recreate {{ svc }} {{ gluetun_watchdog_dependent_containers | default('qbittorrent') }}; then
{% else %}
        if run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d --force-recreate {{ svc }} {{ gluetun_watchdog_dependent_containers | default('qbittorrent') }}; then
{% endif %}
            UPDATE_COUNT=$((UPDATE_COUNT + 1))
            SUMMARY="${SUMMARY}{{ stack.name }}/{{ svc }}:\n${svc_diff}\n\n"
        else
            ERRORS=$((ERRORS + 1))
        fi
{% else %}
{% if stack.auto_update_arr_idle_checks is defined and stack.auto_update_arr_idle_checks | length > 0 %}
        if ! check_arr_idle "{{ stack.name }}" {% for check in stack.auto_update_arr_idle_checks %}{{ (check.name ~ '|' ~ check.url ~ '|' ~ check.config_path) | quote }} {% endfor %}; then
            if [[ "$ARR_IDLE_GUARD_ERROR" -ne 0 ]]; then
                ERRORS=$((ERRORS + 1))
            fi
{% if stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        elif ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d {{ svc }}; then
{% else %}
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d {{ svc }}; then
{% endif %}
{% elif stack.auto_update_required_paths is defined and stack.auto_update_required_paths | length > 0 %}
        if ! check_required_paths "{{ stack.name }}" {% for path in stack.auto_update_required_paths %}{{ path | quote }} {% endfor %}; then
            ERRORS=$((ERRORS + 1))
        elif run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d {{ svc }}; then
{% else %}
        if run_compose_logged "{{ stack.name }}" "{{ stack.path }}" up -d {{ svc }}; then
{% endif %}
            UPDATE_COUNT=$((UPDATE_COUNT + 1))
            SUMMARY="${SUMMARY}{{ stack.name }}/{{ svc }}:\n${svc_diff}\n\n"
        else
            ERRORS=$((ERRORS + 1))
        fi
{% endif %}
    else
        log "{{ stack.name }}/{{ svc }}: up to date"
    fi
{% endfor %}
else
    log "ERROR: {{ stack.name }} pull failed"
    ERRORS=$((ERRORS + 1))
fi

{% endif %}
{% endfor %}
# =========================================================================
# Cleanup and notification
# =========================================================================

# Prune dangling images
PRUNE_OUTPUT=$(docker image prune -f 2>&1)
PRUNE_RECLAIMED=$(echo "$PRUNE_OUTPUT" | grep -oP 'reclaimed \K.*' || echo "0B")
if [[ "$PRUNE_RECLAIMED" != "0B" ]]; then
    log "Pruned dangling images, reclaimed $PRUNE_RECLAIMED"
fi

# Send notification for blocked major version bumps (louder tag)
if [[ "$BLOCKED_COUNT" -gt 0 ]]; then
    BODY=$(echo -e "$BLOCKED_SUMMARY" | head -20)
    send_notification \
        "[Auto-Update] $(hostname): $BLOCKED_COUNT major update(s) BLOCKED" \
        "${BODY}\nReview changelog and manually update when ready." \
        "warning" \
        "{{ docker_auto_update_major_notify_tag | default('push') }}"
    log "Auto-update: $BLOCKED_COUNT major update(s) blocked"
fi

# Send notification for applied updates
if [[ "$UPDATE_COUNT" -gt 0 ]]; then
    BODY=$(echo -e "$SUMMARY" | head -20)
    send_notification \
        "[Auto-Update] $(hostname): $UPDATE_COUNT update(s)" \
        "$BODY" \
        "info"
    log "Auto-update complete: $UPDATE_COUNT update(s) applied"
elif [[ "$ERRORS" -gt 0 ]]; then
    send_notification \
        "[Auto-Update] $(hostname): $ERRORS error(s)" \
        "Auto-update encountered errors. Check: journalctl -u docker-auto-update" \
        "warning"
    log "Auto-update complete with $ERRORS error(s)"
elif [[ "$BLOCKED_COUNT" -eq 0 ]]; then
    log "Auto-update complete: all images up to date"
fi
