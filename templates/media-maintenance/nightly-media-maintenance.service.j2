[Unit]
Description=Nightly media maintenance coordinator
After=network-online.target {{ (mergerfs_mount_path | default('/srv/media') | regex_replace('^/', '') | regex_replace('/', '-')) }}.mount
Wants=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/nightly-media-maintenance --state-dir {{ nightly_media_maintenance_state_dir | quote }} run-window --window {{ nightly_media_maintenance_window | quote }} --profilarr-command {{ '/usr/local/sbin/nightly-media-profilarr open-window' | quote }} --media-stack-command {{ '/usr/local/sbin/mergerfs-balance-media-stack' | quote }}
